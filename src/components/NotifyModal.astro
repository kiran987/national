    name: 'National Smash - Badminton',
    sub: 'Ages 7–16 · Racket Mechanics & Agility'
  },
  {
    iconSvg: `<svg class="w-5 h-5 shrink-0 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="12" rx="10" ry="6" transform="rotate(-45 12 12)"/><path d="m8 8 8 8"/><path d="m10 9 2-2"/><path d="m12 11 2-2"/><path d="m14 13 2-2"/></svg>`,
    name: 'Flag Football & Ball Hockey',
    sub: 'Ages 6–15 · Seasonal Leagues'
  },
  {
    iconSvg: `<svg class="w-5 h-5 shrink-0 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="13" rx="5"/><path d="M10 16v5a2 2 0 0 0 4 0v-5"/><circle cx="9.5" cy="8" r=".75" fill="currentColor"/><circle cx="14.5" cy="8" r=".75" fill="currentColor"/><circle cx="12" cy="10.5" r=".75" fill="currentColor"/><circle cx="9.5" cy="13" r=".75" fill="currentColor"/><circle cx="14.5" cy="13" r=".75" fill="currentColor"/></svg>`,
    name: 'Pickleball & Family Recreation',
    sub: 'Ages 10+ & Adult/Senior'
  },
  {
    iconSvg: `<svg class="w-5 h-5 shrink-0 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6.5 6.5 11 11"/><path d="m21 21-1-1a3 3 0 0 1 0-4.24l.7-.7a1.5 1.5 0 0 0 0-2.12l-2.12-2.12a1.5 1.5 0 0 0-2.12 0l-.7.7a3 3 0 0 1-4.24 0l-1-1"/><path d="m3 3 1 1a3 3 0 0 1 0 4.24l-.7.7a1.5 1.5 0 0 0 0 2.12l2.12 2.12a1.5 1.5 0 0 0 2.12 0l.7-.7a3 3 0 0 1 4.24 0l1 1"/></svg>`,
    name: 'Strength & Conditioning',
    sub: 'Ages 8–17 & Adult'
  },
];

const ageRanges = [
  'Ages 2–4 (Toddler)',
  'Ages 5–7',
  'Ages 8–11',
  'Ages 12–16',
  'Ages 17+ / Adult',
  'Multiple ages / Family',
];
---

<!-- Popup Modal Overlay -->
<div id="notify-modal" class="notify-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-notify-title">
  <div class="notify-modal-container">
    <div class="notify-modal-content">
      
      <!-- Close button -->
      <button type="button" id="notify-modal-close" class="notify-modal-close" aria-label="Close notification form">
        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Modal Header -->
      <div class="notify-modal-header">
        <div class="notify-modal-badge" id="modal-program-badge">
          Early Access Notification
        </div>
        <h2 id="modal-notify-title" class="notify-modal-title">
          Notify Me When Open
        </h2>
        <p class="notify-modal-subtitle">
          Be the first to know when registration opens before public announcements. Never miss a spot.
        </p>
      </div>

      <!-- Success State -->
      <div id="modal-notify-success" class="modal-success-box" style="display:none;" role="alert">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-emerald-50 border-2 border-emerald-500/30 flex items-center justify-center text-emerald-600 shadow-sm">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        </div>
        <h3 style="font-family:var(--font-outfit);font-size:1.35rem;font-weight:800;color:#166534;margin-bottom:0.5rem;">
          You're on the list!
        </h3>
        <p style="color:#374151;font-size:0.92rem;line-height:1.65;margin-bottom:1.5rem;">
          We've recorded your preferences and will email you the moment your selected program opens for registration.
        </p>
        <button type="button" id="modal-success-close-btn" class="btn btn-primary" style="margin:0 auto;">
          Done
        </button>
      </div>

      <!-- Form -->
      <form id="modal-notify-form" method="POST" action="/send-mail.php" novalidate>
        <input type="hidden" name="g-recaptcha-response" class="g-recaptcha-token" value="" />
        <div class="modal-form-grid-2">
          <div class="form-group">
            <label for="modal-notify-first" class="form-label">First Name <span style="color:var(--color-naa-maroon);">*</span></label>
            <input type="text" id="modal-notify-first" name="first_name" class="form-input" required autocomplete="given-name" placeholder="First name" />
            <span class="form-error" id="err-modal-first" aria-live="polite"></span>
          </div>
          <div class="form-group">
            <label for="modal-notify-last" class="form-label">Last Name <span style="color:var(--color-naa-maroon);">*</span></label>
            <input type="text" id="modal-notify-last" name="last_name" class="form-input" required autocomplete="family-name" placeholder="Last name" />
            <span class="form-error" id="err-modal-last" aria-live="polite"></span>
          </div>
        </div>

        <div class="modal-form-grid-2">
          <div class="form-group">
            <label for="modal-notify-email" class="form-label">Email Address <span style="color:var(--color-naa-maroon);">*</span></label>
            <input type="email" id="modal-notify-email" name="email" class="form-input" required autocomplete="email" placeholder="you@example.com" />
            <span class="form-error" id="err-modal-email" aria-live="polite"></span>
          </div>
          <div class="form-group">
            <label for="modal-notify-phone" class="form-label">Phone <span style="color:#9ca3af;font-weight:400;">(optional)</span></label>
            <input type="tel" id="modal-notify-phone" name="phone" class="form-input" autocomplete="tel" placeholder="(306) 555-0100" />
          </div>
        </div>

        <div class="modal-form-grid-2">
          <div class="form-group">
            <label for="modal-notify-age" class="form-label">Athlete Age Range</label>
            <select id="modal-notify-age" name="age_range" class="form-input form-select">
              <option value="">Select age range…</option>
              {ageRanges.map((r) => <option value={r}>{r}</option>)}
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Programs to Notify Me About <span style="color:var(--color-naa-maroon);">*</span></label>
          <div class="modal-programs-list">
            {programsList.map((prog) => (
              <label class="modal-program-item">
                <input
                  type="checkbox"
                  name="programs[]"
                  value={prog.name}
                  data-program-name={prog.name.toLowerCase()}
                  class="modal-program-checkbox"
                />
                <div class="modal-program-label">
                  <span class="modal-program-icon"><Fragment set:html={prog.iconSvg} /></span>
                  <div>
                    <div class="modal-program-name">{prog.name}</div>
                    <div class="modal-program-sub">{prog.sub}</div>
                  </div>
                </div>
              </label>
            ))}
          </div>
          <span class="form-error" id="err-modal-programs" aria-live="polite"></span>
        </div>

        <div class="form-group">
          <label for="modal-notify-notes" class="form-label">Notes or questions <span style="color:#9ca3af;font-weight:400;">(optional)</span></label>
          <textarea id="modal-notify-notes" name="notes" class="form-input" rows="2" placeholder="e.g. number of kids, schedule preferences, questions…"></textarea>
        </div>

        <button type="submit" id="modal-notify-submit-btn" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;margin-top:0.25rem;">
          Notify Me When Open →
        </button>

        <RecaptchaNotice action="notify_signup" />

        <p class="text-[12px] text-slate-400 text-center mt-2 flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>No spam. One email per program when registration opens. Unsubscribe anytime.</span>
        </p>
      </form>

    </div>
  </div>
</div>

<script>
  import { executeRecaptcha } from '../utils/recaptcha';
  import { submitForm } from '../utils/formSubmit';

  const modal = document.getElementById('notify-modal') as HTMLElement;
  const modalContent = modal?.querySelector('.notify-modal-content') as HTMLElement;
  const closeBtn = document.getElementById('notify-modal-close') as HTMLButtonElement;
  const successBox = document.getElementById('modal-notify-success') as HTMLElement;
  const form = document.getElementById('modal-notify-form') as HTMLFormElement;
  const submitBtn = document.getElementById('modal-notify-submit-btn') as HTMLButtonElement;
  const badge = document.getElementById('modal-program-badge') as HTMLElement;

  function openNotifyModal(programName?: string) {
    if (!modal) return;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    // Clear previous errors & state
    clearModalErrors();
    if (form) form.style.display = 'flex';
    if (successBox) successBox.style.display = 'none';

    // Reset all checkboxes
    const checkboxes = modal.querySelectorAll<HTMLInputElement>('.modal-program-checkbox');
    checkboxes.forEach((cb) => (cb.checked = false));

    if (programName && programName.trim()) {
      const cleanTarget = programName.trim().toLowerCase();
      
      // 1. Direct exact match
      const directCheckbox = modal.querySelector<HTMLInputElement>(`.modal-program-checkbox[value="${programName}"]`);
      if (directCheckbox) {
        directCheckbox.checked = true;
      } else {
        // 2. Fuzzy match: pick the single best checkbox, never several
        const keywords = ['camp', 'tournament', 'soccer', 'badminton', 'smash', 'volleyball', 'spike', 'basketball', 'hoops', 'athletics', 'track', 'flag', 'pickleball', 'chess', 'table tennis', 'snowboard', 'shield', 'martial', 'strength'];
        const list = Array.from(checkboxes);
        const score = (cb: HTMLInputElement) => {
          const val = cb.value.toLowerCase();
          if (val === cleanTarget) return 1;
          if (val.includes(cleanTarget) || cleanTarget.includes(val)) return 2;
          if (keywords.some((k) => cleanTarget.includes(k) && val.includes(k))) return 3;
          return 99;
        };
        const best = list.reduce((acc, cb) => (score(cb) < score(acc) ? cb : acc), list[0]);
        if (best && score(best) < 99) best.checked = true;
      }

      if (badge) {
        badge.textContent = `Early Access: ${programName}`;
      }
    } else {
      if (badge) {
        badge.textContent = 'Early Access Notification';
      }
    }

    // Focus on first input
    setTimeout(() => {
      const firstInput = document.getElementById('modal-notify-first') as HTMLInputElement;
      firstInput?.focus();
    }, 120);
  }

  function closeNotifyModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Close triggers
  closeBtn?.addEventListener('click', closeNotifyModal);
  document.getElementById('modal-success-close-btn')?.addEventListener('click', closeNotifyModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeNotifyModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
      closeNotifyModal();
    }
  });

  // Attach click listeners to all buttons with data-notify-btn and fallback delegation
  function attachNotifyTriggers() {
    // Direct binding for maximum responsiveness
    document.querySelectorAll('[data-notify-btn]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const prog = btn.getAttribute('data-program') || '';
        openNotifyModal(prog);
      });
    });

    // Delegated click listener to catch dynamically rendered elements
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest<HTMLElement>('a, button');
      if (!target) return;

      const isNotifyBtn = 
        target.hasAttribute('data-notify-btn') ||
        target.classList.contains('btn-notify') ||
        target.getAttribute('href') === '#notify-modal' ||
        target.getAttribute('href') === '/notify/' ||
        target.getAttribute('href') === '/notify' ||
        (target.textContent?.trim().toLowerCase().startsWith('notify me') && !target.closest('#notify-form-el') && !target.closest('#modal-notify-form'));

      if (isNotifyBtn) {
        e.preventDefault();
        const prog = target.getAttribute('data-program') || 
                     target.getAttribute('data-notify-program') ||
                     target.closest('[data-program]')?.getAttribute('data-program') ||
                     target.closest('.card, .reveal')?.querySelector('h3')?.textContent?.trim() ||
                     '';
        openNotifyModal(prog);
      }
    });
  }

  // Error helpers
  function setModalError(id: string, msg: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = msg;
  }
  function clearModalErrors() {
    modal?.querySelectorAll('.form-error').forEach((el) => (el.textContent = ''));
  }

  // Form submission with universal submitForm helper
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearModalErrors();

    const first = (document.getElementById('modal-notify-first') as HTMLInputElement).value.trim();
    const last = (document.getElementById('modal-notify-last') as HTMLInputElement).value.trim();
    const email = (document.getElementById('modal-notify-email') as HTMLInputElement).value.trim();
    const checked = modal.querySelectorAll('input[name="programs[]"]:checked');

    let valid = true;
    if (!first) { setModalError('err-modal-first', 'First name is required.'); valid = false; }
    if (!last)  { setModalError('err-modal-last',  'Last name is required.');  valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setModalError('err-modal-email', 'Valid email address is required.');
      valid = false;
    }
    if (checked.length === 0) {
      setModalError('err-modal-programs', 'Please select at least one program.');
      valid = false;
    }

    if (!valid) return;

    if (submitBtn) {
      submitBtn.textContent = 'Signing up…';
      submitBtn.disabled = true;
    }

    try {
      // 1. Generate reCAPTCHA v3 token
      const recaptchaToken = await executeRecaptcha('notify_request');
      
      // 2. Inject token into hidden form field
      const tokenInput = form.querySelector<HTMLInputElement>('.g-recaptcha-token');
      if (tokenInput) {
        tokenInput.value = recaptchaToken || '';
      }

      // 3. Dispatch to send-mail.php (AJAX with fallback)
      const result = await submitForm({
        form,
        phpEndpoint: '/send-mail.php',
        subject: 'Early Access Notify Me Signup - NAA Regina',
        recaptchaToken: recaptchaToken || undefined
      });

      if (result.success) {
        form.style.display = 'none';
        if (successBox) successBox.style.display = 'block';
      } else {
        if (submitBtn) {
          submitBtn.textContent = 'Notify Me When Open →';
          submitBtn.disabled = false;
        }
        alert(result.message || 'Something went wrong. Please email info@naacanada.org directly.');
      }
    } catch (err) {
      console.warn('AJAX submit issue, submitting via native POST:', err);
      // Native POST fallback to send-mail.php
      form.submit();
    }
  });

  // Handle ?notified=true redirected from cPanel standard POST
  if (typeof window !== 'undefined' && window.location.search.includes('notified=true')) {
    if (modal) {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      if (form) form.style.display = 'none';
      if (successBox) successBox.style.display = 'block';
      // Clean query string from address bar without reload
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, '', cleanUrl);
    }
  }

  // Initialize
  attachNotifyTriggers();
</script>

<style>
  /* Modal Backdrop */
  .notify-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(2, 31, 71, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow-y: auto;
    padding: 1.5rem 1rem;
    align-items: center;
    justify-content: center;
  }
  .notify-modal-backdrop.is-open {
    display: flex;
  }

  .notify-modal-container {
    width: 100%;
    max-width: 580px;
    margin: auto;
    animation: modalScaleIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modalScaleIn {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(16px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .notify-modal-content {
    background: white;
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(2, 31, 71, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.2);
    padding: 2.25rem 2rem;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
  }

  .notify-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f1f5f9;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    transition: all 0.2s ease;
    z-index: 10;
  }
  .notify-modal-close:hover {
    background: var(--color-naa-maroon);
    color: white;
    transform: rotate(90deg);
  }

  .notify-modal-header {
    margin-bottom: 1.5rem;
    text-align: left;
    padding-right: 2rem;
  }

  .notify-modal-badge {
    display: inline-block;
    background: rgba(34, 197, 94, 0.14);
    color: #15803d;
    font-family: var(--font-outfit);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.6rem;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .notify-modal-title {
    font-family: var(--font-outfit);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-naa-navy);
    line-height: 1.2;
    margin-bottom: 0.4rem;
  }

  .notify-modal-subtitle {
    color: #64748b;
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0;
  }

  #modal-notify-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .modal-form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .modal-programs-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    max-height: 220px;
    overflow-y: auto;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.5rem;
    background: #f8fafc;
  }

  .modal-program-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s;
    user-select: none;
  }
  .modal-program-item:hover {
    background: #e2e8f0;
  }

  .modal-program-checkbox {
