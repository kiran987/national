---
export interface StageInfo {
  number: number;
  stage: string;
  ages: string;
  focus: string;
  parentTakeaway: string;
  milestones: string[];
  activePrograms: string[];
}

const STAGES: StageInfo[] = [
  {
    number: 1,
    stage: 'Active Start',
    ages: 'Ages 2–5',
    focus: 'Joyful movement exploration, balance, and listening to coach cues.',
    parentTakeaway: 'At this stage, sport is about falling in love with movement. No drills or pressure — just active games, hand-eye coordination, and lots of encouragement.',
    milestones: [
      'Jumping, stopping, and gentle landing balance',
      'Catching, rolling, and tracking foam balls',
      'Listening and taking turns with teammates',
      'Building body confidence and playground agility'
    ],
    activePrograms: ['Active Movement & Agility Games (Ages 3–5)']
  },
  {
    number: 2,
    stage: 'FUNdamentals',
    ages: 'Ages 5–8',
    focus: 'Multi-sport games, hand-eye coordination, and early sportsmanship.',
    parentTakeaway: 'Sampling different sports early helps kids stay active longer and build better overall coordination. The focus is purely on confidence and active play.',
    milestones: [
      'Comfortable racket grip & controlled underhand rallying',
      'Basketball dribbling and bounce passes',
      'Personal safety boundaries & voice assertiveness',
      'Good sportsmanship and peer high-fives'
    ],
    activePrograms: ['Smash Juniors Badminton', 'Junior Hoops Basketball', 'National Shield Juniors']
  },
  {
    number: 3,
    stage: 'Learn to Train',
    ages: 'Ages 8–12',
    focus: 'Core sport skills, proper technique, and small-sided scrimmage fun.',
    parentTakeaway: 'The golden age of learning new skills. Coaches break down fundamentals step-by-step so young players build proper muscle memory with zero frustration.',
    milestones: [
      'Clean forearm passing angles & setting touch in volleyball',
      'Agility, court coverage, and quick split-step movement in badminton',
      'Triple-threat stance, footwork, and balance in basketball',
      'Resilience after missed shots and positive team communication'
    ],
    activePrograms: ['Smash Juniors Badminton', 'Spike Foundations Volleyball', 'Junior Hoops Basketball', 'National Shield Juniors']
  },
  {
    number: 4,
    stage: 'Train to Train',
    ages: 'Ages 12–16',
    focus: 'Court movement, endurance, tactical positioning, and teamwork.',
    parentTakeaway: 'Helps youth gain confidence for school team tryouts, learn real game flow, and keep up with faster match tempos without burning out.',
    milestones: [
      'Jump smash timing and deceptive drop shots in badminton',
      'Consistent overhand serving and court coverage in volleyball',
      'Screen-setting, court spacing, and defensive positioning in basketball',
      'Encouraging teammates and playing composed under pressure'
    ],
    activePrograms: ['Smash Elite Badminton', 'Spike Elite Volleyball', 'Youth Hoops Basketball', 'National Shield Youth']
  },
  {
    number: 5,
    stage: 'Train to Compete',
    ages: 'Ages 14–18',
    focus: 'Match strategy, competitive composure, and tournament preparation.',
    parentTakeaway: 'Opportunities to test skills in weekend invitationals, friendly club meets, and high school pre-season prep.',
    milestones: [
      'Game clock awareness and smart decision making',
      'Adapting strategies during set breaks',
      'Respect in Sport etiquette towards coaches and officials',
      'Proper warm-ups, cool-downs, and injury prevention habits'
    ],
    activePrograms: ['Prairie Hoops Classic', 'NAA Invitational Tournaments', 'High School Prep Clinics']
  },
  {
    number: 6,
    stage: 'Active for Life',
    ages: 'Adults & Seniors',
    focus: 'Lifelong fitness, mobility, stress relief, and friendly community games.',
    parentTakeaway: 'Sports are for parents and community members too! Low-stress badminton drop-ins, fitness drills, and functional joint health.',
    milestones: [
      'Low-impact functional movement and joint mobility',
      'Friendly community matches and recreational play',
      'Practical personal self-defence & awareness',
      'Staying active, healthy, and connected in Regina'
    ],
    activePrograms: ['National Shield Pro', 'Adult Badminton Drop-In', 'Parent-Coach Volunteering']
  }
];

const DEFAULT_INDEX = 2; // Learn to Train (Stage 03)
---

<section id="athlete-pathway-rail" aria-labelledby="pathway-rail-title" class="py-20 bg-white text-slate-900 border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300 mb-3">
        Age-by-Age Development Guide
      </span>
      <h2 id="pathway-rail-title" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900">
        How Young Athletes Grow With NAA
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        A clear roadmap from first playground games at age 2 through school sport tryouts and active adulthood. Select any age group to see what your child will practice and achieve.
      </p>
    </div>

    <!-- Progress Rail Stepper -->
    <div class="relative mb-12">
      <!-- Connecting Track Line -->
      <div class="hidden lg:block absolute top-6 left-12 right-12 h-1 bg-slate-200 z-0">
        <div
          id="pathway-track-fill"
          class="h-1 bg-amber-500 transition-all duration-300"
          style={`width: ${(DEFAULT_INDEX / (STAGES.length - 1)) * 100}%`}
        ></div>
      </div>

      <!-- Stepper Buttons -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 relative z-10" role="tablist" aria-label="Developmental Stages">
        {STAGES.map((s, idx) => {
          const isSelected = idx === DEFAULT_INDEX;
          return (
            <button
              type="button"
              data-stage-idx={idx}
              role="tab"
              aria-selected={isSelected ? 'true' : 'false'}
              aria-controls={`pathway-panel-${idx}`}
              id={`pathway-tab-${idx}`}
              class={`pathway-step-btn flex flex-col items-center p-3 rounded-2xl transition-all cursor-pointer text-center ${
                isSelected
                  ? 'bg-[#0B192C] text-white shadow-md ring-2 ring-amber-400'
                  : 'bg-white text-slate-500 hover:bg-slate-50 border border-slate-200'
              }`}
            >
              <div
                class={`step-badge w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs mb-2 transition-colors ${
                  isSelected
                    ? 'bg-amber-400 text-slate-950 shadow-xs'
                    : 'bg-slate-100 text-slate-400'
                }`}
              >
                0{s.number}
              </div>
              <div class={`step-title font-bold text-xs sm:text-sm leading-tight ${isSelected ? 'text-white' : 'text-slate-800'}`}>
                {s.stage}
              </div>
              <div class={`step-ages text-[11px] font-mono mt-0.5 ${isSelected ? 'text-amber-300' : 'text-slate-500'}`}>
                {s.ages}
              </div>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Selected Stage Detail Panels -->
    {STAGES.map((s, idx) => (
      <div
        id={`pathway-panel-${idx}`}
        role="tabpanel"
        aria-labelledby={`pathway-tab-${idx}`}
        class={`pathway-detail-panel bg-slate-50 border border-slate-200/90 rounded-3xl p-6 sm:p-10 shadow-xs transition-opacity duration-200 ${
          idx === DEFAULT_INDEX ? 'block' : 'hidden'
        }`}
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Left 7 Columns: Focus & Milestones -->
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center gap-3">
              <span class="px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-[#0B192C] text-white">
                Stage 0{s.number} Milestone Focus
              </span>
              <span class="text-sm font-bold text-amber-700 font-mono">
                {s.ages}
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
              {s.stage}: <span class="text-slate-600 font-semibold text-lg sm:text-xl block sm:inline">{s.focus}</span>
            </h3>

            <div class="p-4 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700 leading-relaxed">
              <strong class="text-slate-900 font-bold block mb-1">Parent Takeaway:</strong>
              {s.parentTakeaway}
            </div>

            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
                Key Developmental Benchmarks Evaluated in NAA Progress Reports:
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                {s.milestones.map((m) => (
                  <div class="flex items-start gap-2.5 text-xs text-slate-800 bg-white p-3 rounded-lg border border-slate-200/80">
                    <span class="text-amber-500 font-bold shrink-0">✓</span>
                    <span>{m}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Right 5 Columns: Matching NAA Academy Programs -->
          <div class="lg:col-span-5 bg-white border border-slate-200 rounded-2xl p-6 shadow-xs space-y-5">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">
              Recommended NAA Academy Streams:
            </h4>

            <div class="space-y-2.5">
              {s.activePrograms.map((p) => (
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-800">
                  <span>{p}</span>
                  <a
                    href="/programs/"
                    class="text-amber-600 hover:text-amber-700 font-bold underline underline-offset-2 shrink-0 ml-2"
                  >
                    View &rarr;
                  </a>
                </div>
              ))}
            </div>

            <div class="pt-4 border-t border-slate-100">
              <a
                href="/registration/"
                class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl font-bold text-xs bg-[#0B192C] text-white hover:bg-amber-500 hover:text-slate-950 transition-all shadow-xs"
              >
                <span>Register Athlete for this Stage</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    ))}

  </div>
</section>

<script>
  function setupPathwayTabs() {
    const root = document.getElementById('athlete-pathway-rail');
    if (!root) return;

    const buttons = root.querySelectorAll<HTMLButtonElement>('.pathway-step-btn');
    const panels = root.querySelectorAll<HTMLElement>('.pathway-detail-panel');
    const trackFill = root.querySelector<HTMLElement>('#pathway-track-fill');
    const totalStages = buttons.length;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idxStr = btn.getAttribute('data-stage-idx');
        if (idxStr === null) return;
        const selectedIdx = parseInt(idxStr, 10);

        // Update Track line
        if (trackFill && totalStages > 1) {
          trackFill.style.width = `${(selectedIdx / (totalStages - 1)) * 100}%`;
        }

        // Update Buttons
        buttons.forEach((b, i) => {
          const isSelected = i === selectedIdx;
          const isPast = i < selectedIdx;
          b.setAttribute('aria-selected', isSelected ? 'true' : 'false');

          const badge = b.querySelector<HTMLElement>('.step-badge');
          const title = b.querySelector<HTMLElement>('.step-title');
          const ages = b.querySelector<HTMLElement>('.step-ages');

          if (isSelected) {
            b.className = 'pathway-step-btn flex flex-col items-center p-3 rounded-2xl transition-all cursor-pointer text-center bg-[#0B192C] text-white shadow-md ring-2 ring-amber-400';
            if (badge) badge.className = 'step-badge w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs mb-2 transition-colors bg-amber-400 text-slate-950 shadow-xs';
            if (title) title.className = 'step-title font-bold text-xs sm:text-sm leading-tight text-white';
            if (ages) ages.className = 'step-ages text-[11px] font-mono mt-0.5 text-amber-300';
          } else if (isPast) {
            b.className = 'pathway-step-btn flex flex-col items-center p-3 rounded-2xl transition-all cursor-pointer text-center bg-slate-50 text-slate-800 hover:bg-slate-100 border border-slate-200';
            if (badge) badge.className = 'step-badge w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs mb-2 transition-colors bg-slate-200 text-slate-700';
            if (title) title.className = 'step-title font-bold text-xs sm:text-sm leading-tight text-slate-800';
            if (ages) ages.className = 'step-ages text-[11px] font-mono mt-0.5 text-slate-500';
          } else {
            b.className = 'pathway-step-btn flex flex-col items-center p-3 rounded-2xl transition-all cursor-pointer text-center bg-white text-slate-500 hover:bg-slate-50 border border-slate-200';
            if (badge) badge.className = 'step-badge w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs mb-2 transition-colors bg-slate-100 text-slate-400';
            if (title) title.className = 'step-title font-bold text-xs sm:text-sm leading-tight text-slate-800';
            if (ages) ages.className = 'step-ages text-[11px] font-mono mt-0.5 text-slate-500';
          }
        });

        // Toggle Panels
        panels.forEach((p, i) => {
          if (i === selectedIdx) {
            p.classList.remove('hidden');
            p.classList.add('block');
          } else {
            p.classList.add('hidden');
            p.classList.remove('block');
          }
        });
      });
    });
  }

  // Initialize on load and on view transitions if any
  document.addEventListener('DOMContentLoaded', setupPathwayTabs);
  setupPathwayTabs();
</script>
