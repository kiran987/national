---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { activePrograms } from '../data/programs';
import { newSportPages } from '../data/newSports';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const page = newSportPages[slug];
const program = activePrograms.find((p) => p.slug === slug)!;
const others = activePrograms.filter((p) => p.slug !== slug);

const icons: Record<string, string> = {
  grid: '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>',
  focus: '<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1"></circle>',
  scale: '<path d="M12 3v18"></path><path d="M5 7l7-4 7 4"></path><path d="M5 7l-3 7a3.5 3.5 0 0 0 6 0z"></path><path d="M19 7l-3 7a3.5 3.5 0 0 0 6 0z"></path>',
  heart: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>',
  zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>',
  target: '<circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle>',
  activity: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>',
  brain: '<path d="M9.5 2A2.5 2.5 0 0 0 7 4.5v0A2.5 2.5 0 0 0 4.5 7v0A2.5 2.5 0 0 0 3 9.5c0 1 .5 1.8 1.2 2.3A3 3 0 0 0 4 14a3 3 0 0 0 3 3h0a2.5 2.5 0 0 0 5 0V4.5A2.5 2.5 0 0 0 9.5 2z"></path><path d="M14.5 2A2.5 2.5 0 0 1 17 4.5v0A2.5 2.5 0 0 1 19.5 7v0A2.5 2.5 0 0 1 21 9.5c0 1-.5 1.8-1.2 2.3A3 3 0 0 1 20 14a3 3 0 0 1-3 3h0a2.5 2.5 0 0 1-5 0"></path>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>',
  video: '<polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2"></rect>',
  mountain: '<path d="M8 3l4 8 5-5 5 15H2L8 3z"></path>',
  clock: '<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>',
};

const stat = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout title={page.metaTitle} description={page.metaDescription}>
  <Header />

  <div class="nsp" style={`--accent:${page.accent};--deep:${page.accentDeep};`}>
    <!-- HERO -->
    <section class="nsp-hero" aria-labelledby="nsp-title">
      <img
        class="nsp-hero-img"
        src={page.heroImage}
        alt=""
        width="1600"
        height="1067"
        style={`object-position:${page.heroPosition};`}
        fetchpriority="high"
      />
      <div class="nsp-hero-shade" aria-hidden="true"></div>
      <div class="container-naa nsp-hero-inner">
        <nav aria-label="Breadcrumb" class="nsp-crumbs">
          <a href="/">Home</a><span>&rsaquo;</span><a href="/programs/">Programs</a><span>&rsaquo;</span><span class="cur">{program.shortName}</span>
        </nav>

        <div class="nsp-chip"><span class="dot"></span>{page.statusChip}</div>
        <p class="nsp-eyebrow">{page.eyebrow}</p>
        <h1 id="nsp-title">{program.name}</h1>
        <p class="nsp-tagline">{program.tagline}</p>

        <div class="nsp-cta-row">
          <a href="/registration/" class="nsp-btn nsp-btn-primary">Notify Me When Registration Opens
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/contact/" class="nsp-btn nsp-btn-ghost">Ask a Question</a>
        </div>
      </div>
    </section>

    <!-- FACTS BAR -->
    <section class="nsp-facts-wrap" aria-label="Program at a glance">
      <div class="container-naa">
        <dl class="nsp-facts">
          {page.facts.map((f) => (
            <div class="nsp-fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
              {f.note && <span>{f.note}</span>}
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- INTRO -->
    <section class="nsp-section nsp-intro" aria-labelledby="nsp-about">
      <div class="container-naa nsp-intro-grid">
        <div class="reveal">
          <span class="nsp-kicker">About the Program</span>
          <h2 id="nsp-about">{program.subtitle}</h2>
          <p class="nsp-lead">{page.intro}</p>

          <div class="nsp-status-card">
            <div class="nsp-status-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.clock}></svg>
            </div>
            <div>
              <strong>Registration has not opened yet</strong>
              <p>Dates, venue and pricing will be announced soon. Join the notify list and you will hear first.</p>
            </div>
          </div>
        </div>

        <div class="nsp-intro-photo reveal">
          <img
            src={page.gallery[0].src}
            alt={page.gallery[0].alt}
            width="1000"
            height="1000"
            loading="lazy"
          />
          <span class="nsp-photo-tag">{page.gallery[0].caption}</span>
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="nsp-section nsp-tint" aria-labelledby="nsp-benefits">
      <div class="container-naa">
        <div class="nsp-head reveal">
          <span class="nsp-kicker">Why It Matters</span>
          <h2 id="nsp-benefits">{page.benefitsTitle}</h2>
        </div>
        <div class="nsp-benefits">
          {page.benefits.map((b, i) => (
            <article class="nsp-benefit reveal" style={`animation-delay:${i * 80}ms;`}>
              <div class="nsp-ico">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[b.icon]}></svg>
              </div>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- GROUPS -->
    {page.groups && (
      <section class="nsp-section" aria-labelledby="nsp-groups">
        <div class="container-naa">
          <div class="nsp-head reveal">
            <span class="nsp-kicker">Who It's For</span>
            <h2 id="nsp-groups">{page.groupsTitle}</h2>
          </div>
          <div class="nsp-groups" style={`--cols:${page.groups.length};`}>
            {page.groups.map((g) => (
              <article class="nsp-group reveal">
                <span class="nsp-group-ages">{g.ages}</span>
                <h3>{g.name}</h3>
                <p class="nsp-group-size">{g.size}</p>
                <p>{g.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- PLAN / CURRICULUM -->
    <section class="nsp-section nsp-dark" aria-labelledby="nsp-plan">
      <div class="container-naa">
        <div class="nsp-head reveal light">
          <span class="nsp-kicker">The Curriculum</span>
          <h2 id="nsp-plan">{page.planTitle}</h2>
          <p>{page.planSubtitle}</p>
        </div>
        <ol class="nsp-timeline">
          {page.plan.map((s, i) => (
            <li class="nsp-step reveal">
              <div class="nsp-step-num">{stat(i)}</div>
              <div class="nsp-step-body">
                <span class="nsp-step-label">{s.label}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SESSION FLOW -->
    {page.flow && (
      <section class="nsp-section" aria-labelledby="nsp-flow">
        <div class="container-naa">
          <div class="nsp-head reveal">
            <span class="nsp-kicker">Session Structure</span>
            <h2 id="nsp-flow">{page.flowTitle}</h2>
          </div>
          <div class="nsp-flow">
            {page.flow.map((f) => (
              <article class="nsp-flow-item reveal">
                <span class="nsp-flow-time">{f.label}</span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- GALLERY -->
    {page.gallery.length > 1 && (
      <section class="nsp-section nsp-tint" aria-label="Photo gallery">
        <div class="container-naa">
          <div class="nsp-gallery" style={`--cols:${page.gallery.length - 1};`}>
            {page.gallery.slice(1).map((g) => (
              <figure class="nsp-shot reveal">
                <img src={g.src} alt={g.alt} loading="lazy" width="1000" height="800" />
                <figcaption>{g.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="nsp-section" aria-labelledby="nsp-faq">
      <div class="container-naa nsp-faq-wrap">
        <div class="nsp-head reveal">
          <span class="nsp-kicker">Questions</span>
          <h2 id="nsp-faq">Frequently Asked Questions</h2>
        </div>
        <div class="nsp-faq">
          {page.faqs.map((f) => (
            <details class="nsp-q">
              <summary>{f.question}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- NOTIFY CTA -->
    <section class="nsp-cta" aria-labelledby="nsp-cta-title">
      <div class="container-naa">
        <span class="nsp-chip small"><span class="dot"></span>{page.statusChip}</span>
        <h2 id="nsp-cta-title">Be First in Line for {program.name}</h2>
        <p>Registration has not started. Leave your details and we will email you the moment seats open.</p>
        <div class="nsp-cta-row center">
          <a href="/registration/" class="nsp-btn nsp-btn-primary">Notify Me
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/contact/" class="nsp-btn nsp-btn-ghost">Contact Us</a>
        </div>
      </div>
    </section>

    <!-- OTHER PROGRAMS -->
    <section class="nsp-section nsp-others" aria-label="Explore more programs">
      <div class="container-naa">
        <div class="nsp-others-head">
          <h2>Explore More NAA Programs</h2>
          <a href="/programs/">View all programs &rarr;</a>
        </div>
        <div class="nsp-others-grid">
          {others.map((o) => (
            <a href={`/programs/${o.slug}/`} class="nsp-other">
              <span class="nsp-other-name">{o.shortName}</span>
              <span class="nsp-other-ages">{o.ages.split('(')[0]}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <Footer />
</Layout>

<style>
  .nsp {
    --ink: #0f172a;
    --muted: #475569;
    --line: #e2e8f0;
    background: #fff;
    color: var(--ink);
  }
  .nsp :global(h1),
  .nsp :global(h2),
  .nsp :global(h3) {
    font-family: var(--font-outfit);
  }

  /* HERO */
  .nsp-hero {
    position: relative;
    min-height: 640px;
    display: flex;
    align-items: flex-end;
    padding: 9.5rem 0 7rem;
    color: #fff;
    overflow: hidden;
    background: var(--deep);
  }
  .nsp-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nsp-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--deep) 88%, transparent) 0%, color-mix(in srgb, var(--deep) 45%, transparent) 40%, color-mix(in srgb, var(--deep) 94%, transparent) 100%),
      linear-gradient(90deg, color-mix(in srgb, var(--deep) 70%, transparent) 0%, transparent 70%);
  }
  .nsp-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 880px;
    margin-right: auto;
  }
  .nsp-crumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.75rem;
  }
  .nsp-crumbs a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
  }
  .nsp-crumbs .cur {
    color: var(--accent);
    font-weight: 600;
  }
  .nsp-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-outfit);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }
  .nsp-chip .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: nspPulse 2s infinite;
  }
  .nsp-chip.small {
    margin-bottom: 1rem;
  }
  @keyframes nspPulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 70%, transparent); }
    70% { box-shadow: 0 0 0 10px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .nsp-eyebrow {
    margin: 1.5rem 0 0.35rem;
    font-family: var(--font-outfit);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.82rem;
    color: var(--accent);
  }
  .nsp-hero h1 {
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: #fff;
  }
  .nsp-tagline {
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    color: rgba(255, 255, 255, 0.9);
    max-width: 640px;
    line-height: 1.5;
    margin: 0 0 2rem;
  }
  .nsp-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .nsp-cta-row.center {
    justify-content: center;
  }
  .nsp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.6rem;
    border-radius: 12px;
    font-family: var(--font-outfit);
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .nsp-btn:hover {
    transform: translateY(-2px);
  }
  .nsp-btn-primary {
    background: var(--accent);
    color: #0b1220;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .nsp-btn-ghost {
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.06);
  }
  .nsp-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  /* FACTS */
  .nsp-facts-wrap {
    position: relative;
    z-index: 5;
    margin-top: -3.5rem;
  }
  .nsp-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(2, 31, 71, 0.18);
  }
  .nsp-fact {
    background: #fff;
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .nsp-fact dt {
    font-family: var(--font-outfit);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #64748b;
  }
  .nsp-fact dd {
    margin: 0;
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 1.75rem;
    color: var(--deep);
    line-height: 1.15;
  }
  .nsp-fact span {
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* SECTIONS */
  .nsp-section {
    padding: 5rem 0;
  }
  .nsp-tint {
    background: #f8fafc;
  }
  .nsp-kicker {
    display: inline-block;
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--deep);
    background: color-mix(in srgb, var(--accent) 22%, white);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .nsp-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem;
  }
  .nsp-head h2,
  .nsp-intro h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    font-weight: 800;
    color: var(--deep);
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }
  .nsp-head p {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0;
  }
  .nsp-head.light h2 { color: #fff; }
  .nsp-head.light p { color: rgba(255, 255, 255, 0.75); }
  .nsp-head.light .nsp-kicker { color: #fff; background: rgba(255, 255, 255, 0.14); }

  /* INTRO */
  .nsp-intro { padding-top: 6rem; }
  .nsp-intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }
  .nsp-lead {
    font-size: 1.1rem;
    line-height: 1.85;
    color: #334155;
    margin: 0 0 2rem;
  }
  .nsp-status-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 1.4rem;
    border-radius: 16px;
    background: color-mix(in srgb, var(--accent) 12%, white);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, white);
  }
  .nsp-status-card strong {
    font-family: var(--font-outfit);
    color: var(--deep);
  }
  .nsp-status-card p {
    margin: 0.2rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .nsp-status-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--deep);
    color: var(--accent);
  }
  .nsp-intro-photo {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 30px 70px rgba(2, 31, 71, 0.25);
    aspect-ratio: 4 / 5;
  }
  .nsp-intro-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .nsp-photo-tag {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--deep);
    font-family: var(--font-outfit);
    font-weight: 700;
    font-size: 0.82rem;
  }

  /* BENEFITS */
  .nsp-benefits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  .nsp-benefit {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 2rem 1.75rem;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .nsp-benefit:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 50px rgba(2, 31, 71, 0.12);
    border-color: color-mix(in srgb, var(--accent) 60%, white);
  }
  .nsp-ico {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: var(--deep);
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .nsp-benefit h3 {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--deep);
    margin: 0 0 0.6rem;
  }
  .nsp-benefit p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
  }

  /* GROUPS */
  .nsp-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    max-width: calc(var(--cols) * 380px);
    margin: 0 auto;
  }
  .nsp-group {
    position: relative;
    padding: 2rem 1.75rem 1.75rem;
    border-radius: 22px;
    background: linear-gradient(160deg, #fff 0%, color-mix(in srgb, var(--accent) 8%, white) 100%);
    border: 1px solid var(--line);
    border-top: 5px solid var(--accent);
    box-shadow: 0 14px 34px rgba(2, 31, 71, 0.07);
  }
  .nsp-group-ages {
    display: inline-block;
