<style>
  #site-header {
    min-height: 92px;
  }
  @media (min-width: 1024px) {
    #site-header {
      min-height: 100px;
    }
  }
  /* Mobile menu: two columns */
  #mobile-nav .mm-programs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    padding-left: 0;
  }
  #mobile-nav .mm-programs > a:not(.mm-archive) {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.5rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
  }
  #mobile-nav .mm-programs > a:not(.mm-archive) > div {
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.82rem;
    line-height: 1.25;
  }
  #mobile-nav .mm-programs > a:not(.mm-archive) > span {
    margin-left: 0;
  }
  #mobile-nav .mm-programs > .mm-archive {
    grid-column: 1 / -1;
  }
  #mobile-nav .mm-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.25rem;
  }
  #mobile-nav .mm-groups a {
    flex-wrap: wrap;
    row-gap: 0.25rem;
  }
  .nav-link {
    font-size: 0.98rem;
    font-weight: 700;
    padding: 0.55rem 0.3rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  @media (max-width: 1240px) and (min-width: 981px) {
    nav[aria-label="Main navigation"] {
      gap: 0.85rem !important;
    }
    nav[aria-label="Main navigation"] .nav-link {
      font-size: 0.88rem !important;
      padding: 0.4rem 0.2rem !important;
    }
    nav[aria-label="Main navigation"] .btn {
      padding: 0.6rem 1.1rem !important;
      font-size: 0.84rem !important;
    }
  }
  @media (max-width: 980px) {
    nav[aria-label="Main navigation"] { display: none !important; }
    #mobile-menu-btn { display: flex !important; }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  const closeBtn = document.getElementById('mobile-close-btn');
  const header = document.getElementById('site-header');

  function openMenu() {
    nav!.style.display = 'flex';
    btn!.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    nav!.style.display = 'none';
    btn!.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  nav?.addEventListener('click', (e) => { if (e.target === nav) closeMenu(); });

  // Close on inner mobile link click
  nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  // Scroll effect on header
  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) {
      header?.classList.add('header-scrolled');
    } else {
      header?.classList.remove('header-scrolled');
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
