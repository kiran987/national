---
import { activePrograms } from '../data/programs';

const currentPath = Astro.url.pathname;
---

<header id="site-header" style="position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(2,31,71,0.95);backdrop-filter:blur(14px);transition:all 0.3s ease;border-bottom:1px solid rgba(255,255,255,0.08);">
  <div class="container-naa" style="display:flex;align-items:center;justify-content:space-between;padding-top:0.875rem;padding-bottom:0.875rem;">
    <!-- Logo -->
    <a href="/" style="display:flex;align-items:center;gap:0.875rem;text-decoration:none;" aria-label="National Athletics Academy Home">
      <img
        src="/images/naa-logo-sm.webp"
        alt="National Athletics Academy Logo"
        width="48"
        height="48"
        style="border-radius:50%;flex-shrink:0;box-shadow:0 0 0 2px rgba(221,170,64,0.4);"
      />
      <div>
        <div style="font-family:var(--font-outfit);font-weight:800;font-size:1.05rem;color:white;line-height:1.1;">National Athletics</div>
        <div style="font-family:var(--font-outfit);font-weight:600;font-size:0.75rem;color:var(--color-naa-gold);letter-spacing:0.08em;text-transform:uppercase;">Academy Inc. · Regina</div>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Main navigation" style="display:flex;align-items:center;gap:1.75rem;">
      <a href="/" class="nav-link" aria-current={currentPath === '/' ? 'page' : undefined}>
        Home
      </a>

      <!-- Programs Dropdown (3 Active Programs + Coming Soon) -->
      <div class="nav-item-dropdown">
        <a href="/programs/" class="nav-link nav-dropdown-trigger" aria-current={currentPath.startsWith('/programs') ? 'page' : undefined}>
          <span>Programs</span>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="transition:transform 0.2s;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
        <div class="nav-dropdown-menu" role="menu" style="min-width:320px;">
          <div style="padding:0.35rem 0.65rem 0.5rem;font-size:0.7rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);letter-spacing:0.08em;text-transform:uppercase;border-bottom:1px solid rgba(255,255,255,0.08);">
            3 Active Programs
          </div>
          {activePrograms.map((prog) => (
            <a href={`/programs/${prog.slug}/`} class="dropdown-link" role="menuitem">
              <span class="dropdown-icon">{prog.emoji}</span>
              <div>
                <div style="font-size:0.85rem;line-height:1.2;font-weight:600;">{prog.name}</div>
                <div style="font-size:0.72rem;color:rgba(255,255,255,0.55);font-weight:400;">{prog.ages}</div>
              </div>
            </a>
          ))}
          <div style="border-top:1px solid rgba(255,255,255,0.08);margin-top:0.25rem;padding-top:0.35rem;display:flex;flex-direction:column;gap:0.2rem;">
            <a href="/programs/camps/" class="dropdown-link" style="color:#6ee7b7;font-size:0.8rem;">
              <span class="dropdown-icon">🏕️</span>
              <span>Camps &amp; Clinics — Coming Soon &rarr;</span>
            </a>
            <a href="/programs/tournaments/" class="dropdown-link" style="color:#6ee7b7;font-size:0.8rem;">
              <span class="dropdown-icon">🏆</span>
              <span>Tournaments — Coming Soon &rarr;</span>
            </a>
            <a href="/programs/#starting-soon" class="dropdown-link" style="color:rgba(255,255,255,0.6);font-size:0.78rem;">
              <span class="dropdown-icon">🚀</span>
              <span>More Sports Coming Soon &rarr;</span>
            </a>
            <a href="/programs/" class="dropdown-link" style="color:var(--color-naa-gold);font-size:0.82rem;font-weight:700;">
              <span class="dropdown-icon">📋</span>
              <span>All Programs Overview &rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Saskatchewan Safety Link -->
      <a href="/safety/" class="nav-link" aria-current={currentPath.startsWith('/safety') ? 'page' : undefined} style="display:inline-flex;align-items:center;gap:0.35rem;">
        <span style="color:var(--color-naa-gold);font-size:0.9rem;">🛡️</span>
        <span>Safety &amp; Standards</span>
      </a>



      <a href="/about/" class="nav-link" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>
        About NAA
      </a>

      {/* <a href="/coaches/" class="nav-link" aria-current={currentPath.startsWith('/coaches') ? 'page' : undefined}>
        Coaches
      </a> */}

      <a href="/contact/" class="nav-link" aria-current={currentPath.startsWith('/contact') ? 'page' : undefined}>
        Contact
      </a>

      <!-- Register CTA -->
      <a
        href="/registration/"
        class="btn btn-primary btn-sm"
        style="font-size:0.85rem;padding:0.5rem 1.25rem;border-radius:8px;font-family:var(--font-outfit);font-weight:700;box-shadow:0 4px 14px rgba(131,22,27,0.35);"
      >
        Register Now
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      style="display:none;background:none;border:none;cursor:pointer;padding:0.5rem;color:white;"
    >
      <svg id="menu-open-icon" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="menu-close-icon" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display:none;">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Nav Overlay -->
<div
  id="mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  style="display:none;position:fixed;inset:0;background:var(--color-naa-navy);z-index:99;flex-direction:column;padding:2rem 1.5rem;overflow-y:auto;"
>
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
    <a href="/" style="display:flex;align-items:center;gap:0.75rem;" aria-label="NAA Home">
      <img src="/images/naa-logo-sm.webp" alt="National Athletics Academy Logo" width="44" height="44" style="border-radius:50%;" />
      <div>
        <div style="font-family:var(--font-outfit);font-weight:800;color:white;font-size:1rem;line-height:1.1;">National Athletics Academy</div>
        <div style="font-size:0.72rem;color:var(--color-naa-gold);font-family:var(--font-outfit);font-weight:600;">Regina, Saskatchewan</div>
      </div>
    </a>
    <button id="mobile-close-btn" aria-label="Close menu" style="background:none;border:none;cursor:pointer;color:white;">
      <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <nav style="display:flex;flex-direction:column;gap:0.5rem;" aria-label="Mobile navigation">
    <a href="/" style="font-family:var(--font-outfit);font-weight:700;font-size:1.1rem;color:rgba(255,255,255,0.9);padding:0.6rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      🏠 Home
    </a>

    <!-- Active Sports in Exact Order -->
    <div style="padding:0.75rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div style="font-family:var(--font-outfit);font-weight:800;font-size:0.78rem;color:var(--color-naa-gold);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.6rem;">
        3 Active Programs
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem;padding-left:0.25rem;">
        {activePrograms.map((prog) => (
          <a
            href={`/programs/${prog.slug}/`}
            style="font-family:var(--font-outfit);font-weight:600;font-size:0.95rem;color:white;display:flex;align-items:center;gap:0.6rem;padding:0.25rem 0;"
          >
            <span>{prog.emoji}</span>
            <span>{prog.name}</span>
          </a>
        ))}
        <a
            href="/programs/camps/"
            style="font-family:var(--font-outfit);font-weight:600;font-size:0.88rem;color:#6ee7b7;display:flex;align-items:center;gap:0.6rem;padding:0.2rem 0;"
          >
            <span>🏕️</span>
            <span>Camps &amp; Clinics — Coming Soon</span>
          </a>
          <a
            href="/programs/tournaments/"
            style="font-family:var(--font-outfit);font-weight:600;font-size:0.88rem;color:#6ee7b7;display:flex;align-items:center;gap:0.6rem;padding:0.2rem 0;"
          >
            <span>🏆</span>
            <span>Tournaments — Coming Soon</span>
          </a>
      </div>
    </div>

    <a href="/safety/" style="font-family:var(--font-outfit);font-weight:700;font-size:1.05rem;color:rgba(255,255,255,0.9);padding:0.6rem 0;border-bottom:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;gap:0.5rem;">
      <span>🛡️</span>
      <span>Safety &amp; Sask Safeguards</span>
    </a>



    <a href="/about/" style="font-family:var(--font-outfit);font-weight:700;font-size:1.05rem;color:rgba(255,255,255,0.9);padding:0.6rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      ℹ️ About NAA &amp; Governance
    </a>

    {/* <a href="/coaches/" style="font-family:var(--font-outfit);font-weight:700;font-size:1.05rem;color:rgba(255,255,255,0.9);padding:0.6rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      🏅 Certified Coaches
    </a> */}

    <a href="/contact/" style="font-family:var(--font-outfit);font-weight:700;font-size:1.05rem;color:rgba(255,255,255,0.9);padding:0.6rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      📬 Contact &amp; Inquiries
    </a>

    <div style="margin-top:1.25rem;">
      <a href="/registration/" class="btn btn-primary" style="width:100%;text-align:center;">
        Register Your Athlete &rarr;
      </a>
    </div>
  </nav>

  <div style="margin-top:auto;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,0.12);">
    <p style="color:rgba(255,255,255,0.5);font-size:0.8rem;font-family:var(--font-inter);">Regina, Saskatchewan · Non-Profit Youth Athletics</p>
    <p style="color:var(--color-naa-gold);font-size:0.8rem;font-family:var(--font-outfit);font-weight:600;margin-top:0.25rem;">Flexible Installment Plans Available</p>
  </div>
</div>

<!-- Spacer for fixed header -->
<div style="height:76px;" aria-hidden="true"></div>

<style>
  @media (max-width: 980px) {
    nav[aria-label="Main navigation"] { display: none !important; }
    #mobile-menu-btn { display: flex !important; }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  const closeBtn = document.getElementById('mobile-close-btn');
  const header = document.getElementById('site-header');

  function openMenu() {
    nav!.style.display = 'flex';
    btn!.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    nav!.style.display = 'none';
    btn!.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  nav?.addEventListener('click', (e) => { if (e.target === nav) closeMenu(); });

  // Close on inner mobile link click
  nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  // Scroll effect on header
  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) {
      header?.classList.add('header-scrolled');
    } else {
      header?.classList.remove('header-scrolled');
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
