---
import { activePrograms } from '../data/programs';

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-[#021F47]/95 backdrop-blur-md transition-all duration-300 border-b border-white/10 shadow-lg shadow-black/15">
  <!-- Top Utility Bar: Direct Local Contact & Location Notice -->
  <div class="bg-[#01142e] border-b border-white/10 py-1.5 px-4 text-xs text-slate-300">
    <div class="container-naa flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 text-[11px] sm:text-xs">
        <a href="tel:3063309559" class="inline-flex items-center gap-1.5 text-amber-300 hover:text-white font-bold transition-colors">
          <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>(306) 330-9559</span>
        </a>
        <span class="text-white/20 hidden sm:inline">|</span>
        <!--email_off--><a href="mailto:info@naacanada.org" class="hidden sm:inline-flex items-center gap-1.5 text-slate-300 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5 text-[#DDAA40] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>info@naacanada.org</span>
        </a><!--/email_off-->
      </div>
      <div class="text-[11px] text-slate-300 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Youth Athletics &bull; Regina, SK</span>
      </div>
    </div>
  </div>
  <div class="container-naa flex items-center justify-between py-4 lg:py-5 min-h-[80px] lg:min-h-[88px]">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-4 no-underline group shrink-0" aria-label="National Athletics Academy Home">
      <img
        src="/images/naa-logo-sm.webp"
        alt="National Athletics Academy Logo"
        width="58"
        height="58"
        class="w-[50px] h-[50px] sm:w-[54px] sm:h-[54px] lg:w-[58px] lg:h-[58px] rounded-full shrink-0 ring-2 ring-[#DDAA40]/60 shadow-md group-hover:ring-[#DDAA40] transition-all object-contain"
      />
      <div>
        <div class="font-display font-extrabold text-[1.15rem] sm:text-[1.25rem] lg:text-[1.35rem] text-white leading-tight tracking-tight">National Athletics</div>
        <div class="font-display font-bold text-[0.74rem] sm:text-[0.8rem] text-[#DDAA40] tracking-wider uppercase mt-0.5">Academy Inc.</div>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Main navigation" class="flex items-center gap-5">
      <a href="/" class="nav-link" aria-current={currentPath === '/' ? 'page' : undefined}>
        Home
      </a>

      <!-- Programs Dropdown (4 Active Programs + Starting Soon) -->
      <div class="nav-item-dropdown">
        <a href="/programs/" class="nav-link nav-dropdown-trigger" aria-current={currentPath.startsWith('/programs') && !currentPath.startsWith('/programs/tournaments') ? 'page' : undefined}>
          <span>Programs</span>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-200">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
        <div class="nav-dropdown-menu nav-mega" role="menu">
          <div class="mega-head px-2.5 pt-1.5 pb-2 text-[0.7rem] font-display font-bold text-[#DDAA40] tracking-wider uppercase border-b border-white/10 flex items-center justify-between">
            <span>Sport Academies</span>
            <span class="text-white/50 text-[10px] font-normal normal-case">Active &amp; Starting Soon</span>
          </div>
          {activePrograms.map((prog) => {
            const isComingSoon = prog.status === 'coming-soon';
            const isStartingSoon = isComingSoon || prog.id === 'basketball' || prog.id === 'national-shield';
            return (
              <a href={`/programs/${prog.slug}/`} class="dropdown-link mega-item" role="menuitem">
                <div class="flex items-center gap-2.5">
                  <span class="dropdown-icon text-[#DDAA40]">
                    {prog.id === 'badminton' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 0-4 4c0 1.5.8 2.8 2 3.5V13a2 2 0 0 0 4 0V9.5c1.2-.7 2-2 2-3.5a4 4 0 0 0-4-4z"/><path d="M12 15v7"/><path d="M9.5 22h5"/><path d="M9 7h6"/></svg>
                    )}
                    {prog.id === 'volleyball' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/><path d="M2 12c3.5 3.5 10 3.5 13.5 0"/></svg>
                    )}
                    {prog.id === 'basketball' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2.1 10.5a14 14 0 0 1 19.8 0"/><path d="M2.1 13.5a14 14 0 0 0 19.8 0"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
                    )}
                    {prog.id === 'national-shield' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    )}
                    {prog.id === 'chess' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="3"/><path d="M9 21h6M10 21l1-7M14 21l-1-7M8.5 14h7"/></svg>
                    )}
                    {prog.id === 'table-tennis' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7"/><path d="M15 15l6 6"/><circle cx="19" cy="5" r="1.5"/></svg>
                    )}
                    {prog.id === 'snowboarding' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20l6-11 4 6 3-4 5 9z"/></svg>
                    )}
                  </span>
                  <div>
                    <div class="text-[0.85rem] leading-tight font-semibold">{prog.name}</div>
                    <div class="text-[0.72rem] text-white/55 font-normal">{prog.ages.split('(')[0].trim()}</div>
                  </div>
                </div>
                <span class={`text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded shrink-0 ml-2 ${
                  isStartingSoon
                    ? 'bg-amber-400/20 text-amber-300 border border-amber-400/30'
                    : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'
                }`}>
                  {isComingSoon ? 'Coming Soon' : isStartingSoon ? 'Starting Soon' : 'Registration Open'}
                </span>
              </a>
            );
          })}
          <div class="mega-foot border-t border-white/10 mt-1 pt-1.5 grid grid-cols-3 gap-1">
            <a href="/programs/enquiry/" class="dropdown-link text-[#DDAA40] text-[0.82rem] font-bold">
              <span class="dropdown-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              </span>
              <span>Program Enquiry &rarr;</span>
            </a>
            <a href="/programs/" class="dropdown-link text-white/75 text-[0.82rem]">
              <span class="dropdown-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </span>
              <span>All Programs Overview &rarr;</span>
            </a>
            <a href="/programs/archive/" class="dropdown-link text-white/60 text-[0.82rem]">
              <span class="dropdown-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="5" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
              </span>
              <span>Past Programs &rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Tournaments Dropdown -->
      <div class="nav-item-dropdown">
        <a href="/programs/tournaments/" class="nav-link nav-dropdown-trigger" aria-current={currentPath.startsWith('/programs/tournaments') ? 'page' : undefined}>
          <span>Tournaments</span>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-200"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <div class="nav-dropdown-menu min-w-[300px]" role="menu">
          <a href="/programs/tournaments/" class="dropdown-link" role="menuitem">
            <span class="dropdown-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            </span>
            <div>
              <div class="text-[0.85rem] font-semibold">All Tournaments</div>
              <div class="text-[0.72rem] text-white/55">Events &amp; competition series</div>
            </div>
          </a>
          <a href="/programs/tournaments/badminton/national-smash-open-2027/" class="dropdown-link flex items-center justify-between" role="menuitem">
            <div class="flex items-center gap-2.5">
              <span class="dropdown-icon text-[#DDAA40]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 0-4 4c0 1.5.8 2.8 2 3.5V13a2 2 0 0 0 4 0V9.5c1.2-.7 2-2 2-3.5a4 4 0 0 0-4-4z"/><path d="M12 15v7"/></svg>
              </span>
              <div>
                <div class="text-[0.85rem] font-bold text-[#DDAA40]">National Smash Open 2027</div>
                <div class="text-[0.72rem] text-white/55">Badminton Open Championship</div>
              </div>
            </div>
            <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded shrink-0 ml-2 bg-amber-400/20 text-amber-300 border border-amber-400/30">Feb 27, 2027</span>
          </a>
        </div>
      </div>

      <!-- Blog -->
      <a href="/blog/" class="nav-link" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>
        Blog
      </a>

      <!-- About & Team Dropdown -->
      <div class="nav-item-dropdown">
        <a href="/about/" class="nav-link nav-dropdown-trigger" aria-current={currentPath.startsWith('/about') || currentPath.startsWith('/team') || currentPath.startsWith('/safety') ? 'page' : undefined}>
          <span>About</span>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-200"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <div class="nav-dropdown-menu min-w-[240px]" role="menu">
          <a href="/about/" class="dropdown-link" role="menuitem">
            <span class="dropdown-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            </span>
            <div>
              <div class="text-[0.85rem] font-semibold">About NAA</div>
              <div class="text-[0.72rem] text-white/55">Mission, vision &amp; values</div>
            </div>
          </a>
          <a href="/safety/" class="dropdown-link" role="menuitem">
            <span class="dropdown-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <div>
              <div class="text-[0.85rem] font-semibold">Safety &amp; Standards</div>
              <div class="text-[0.72rem] text-white/55">Screening, safe sport &amp; policies</div>
            </div>
          </a>
          <a href="/team/" class="dropdown-link" role="menuitem">
            <span class="dropdown-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <div>
              <div class="text-[0.85rem] font-bold text-[#DDAA40]">Our Team</div>
              <div class="text-[0.72rem] text-white/55">Directors, leadership &amp; coaches</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Coaching Dropdown -->
      <div class="nav-item-dropdown">
        <a href="/coaching/" class="nav-link nav-dropdown-trigger" aria-current={currentPath.startsWith('/coaching') ? 'page' : undefined}>
          <span>Coaching</span>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-200"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <div class="nav-dropdown-menu min-w-[240px]" role="menu">
          <a href="/coaching/" class="dropdown-link" role="menuitem">
            <span class="dropdown-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
            </span>
            <div>
              <div class="text-[0.85rem] font-semibold">Coaching Opportunities</div>
              <div class="text-[0.72rem] text-white/55">Volunteer &amp; paid roles</div>
            </div>
          </a>
          <a href="/coaching/#apply" class="dropdown-link text-[#DDAA40] font-bold" role="menuitem">
            <span class="dropdown-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </span>
            <div>
              <div class="text-[0.85rem] font-bold">Apply to Coach &rarr;</div>
              <div class="text-[0.72rem] text-white/55">Submit your application</div>
            </div>
          </a>
        </div>
      </div>

      <a href="/contact/" class="nav-link" aria-current={currentPath.startsWith('/contact') ? 'page' : undefined}>
        Contact
      </a>

      <!-- Register CTA -->
      <a
        href="/registration/"
        class="btn btn-primary text-sm lg:text-[0.92rem] px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl font-display font-bold shadow-[0_4px_16px_rgba(131,22,27,0.4)] hover:shadow-[0_6px_20px_rgba(131,22,27,0.55)] transition-all shrink-0"
      >
        Register Now
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="hidden bg-white/5 border border-white/15 rounded-xl cursor-pointer p-2.5 text-white hover:bg-white/10 transition-colors"
    >
      <svg id="menu-open-icon" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="menu-close-icon" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Nav Overlay -->
<div
  id="mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  class="hidden fixed inset-0 bg-[#021F47] z-[99] flex-col p-6 sm:p-8 overflow-y-auto"
>
  <div class="flex items-center justify-between mb-6">
    <a href="/" class="flex items-center gap-3 no-underline" aria-label="NAA Home">
      <img src="/images/naa-logo-sm.webp" alt="National Athletics Academy Logo" width="48" height="48" class="rounded-full ring-2 ring-[#DDAA40]/50" />
      <div>
        <div class="font-display font-extrabold text-base leading-tight text-white">National Athletics Academy</div>
        <div class="text-xs text-[#DDAA40] font-display font-semibold">Academy Inc.</div>
      </div>
    </a>
    <button id="mobile-close-btn" aria-label="Close menu" class="bg-transparent border-0 cursor-pointer text-white p-1">
      <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <nav class="flex flex-col gap-2" aria-label="Mobile navigation">
    <a href="/" class="font-display font-bold text-[1.1rem] text-white/90 py-2.5 border-b border-white/10">
      Home
    </a>

    <!-- Sport Academies in Exact Order -->
    <div class="py-3 border-b border-white/10">
      <div class="font-display font-extrabold text-[0.78rem] text-[#DDAA40] tracking-wider uppercase mb-2.5 flex items-center justify-between">
        <span>Sport Academies</span>
        <span class="text-white/50 text-[10px] font-normal normal-case">Active &amp; Starting Soon</span>
      </div>
      <div class="mm-programs flex flex-col gap-1.5 pl-1">
        {activePrograms.map((prog) => {
          const isComingSoon = prog.status === 'coming-soon';
            const isStartingSoon = isComingSoon || prog.id === 'basketball' || prog.id === 'national-shield';
          return (
            <a
              href={`/programs/${prog.slug}/`}
              class="font-display font-semibold text-[0.95rem] text-white flex items-center justify-between py-1.5"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-[#DDAA40] flex items-center shrink-0">
                  {prog.id === 'badminton' && (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 0 0-4 4c0 1.5.8 2.8 2 3.5V13a2 2 0 0 0 4 0V9.5c1.2-.7 2-2 2-3.5a4 4 0 0 0-4-4z"/><path d="M12 15v7"/></svg>
                  )}
                  {prog.id === 'volleyball' && (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/></svg>
                  )}
                  {prog.id === 'basketball' && (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
                  )}
                  {prog.id === 'national-shield' && (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  )}
                  {prog.id === 'chess' && (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="3"/><path d="M9 21h6M10 21l1-7M14 21l-1-7M8.5 14h7"/></svg>
                  )}
                  {prog.id === 'table-tennis' && (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7"/><path d="M15 15l6 6"/><circle cx="19" cy="5" r="1.5"/></svg>
                  )}
                  {prog.id === 'snowboarding' && (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20l6-11 4 6 3-4 5 9z"/></svg>
                  )}
                </span>
                <span>{prog.name}</span>
              </div>
              <span class={`text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded shrink-0 ${
                isStartingSoon
                  ? 'bg-amber-400/20 text-amber-300 border border-amber-400/30'
                  : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'
              }`}>
                {isComingSoon ? 'Coming Soon' : isStartingSoon ? 'Starting Soon' : 'Registration Open'}
              </span>
            </a>
          );
        })}
        <a href="/programs/archive/" class="mm-archive font-display font-semibold text-[0.85rem] text-white/60 py-1.5">Past Programs (Archive) &rarr;</a>
      </div>
    </div>

    <div class="mm-groups">
    <!-- Tournaments group -->
