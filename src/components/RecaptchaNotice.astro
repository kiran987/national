---
/**
 * RecaptchaNotice.astro
 * Displays the required Google reCAPTCHA v3 legal branding.
 * The reCAPTCHA script is loaded globally in Layout.astro <head>,
 * and individual forms include their own single <input name="g-recaptcha-response">.
 */
---

<p class="recaptcha-terms" style="font-size:0.75rem;color:#94a3b8;line-height:1.5;margin-top:0.6rem;">
  Protected by reCAPTCHA &bull; Google <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" style="color:#64748b;text-decoration:underline;">Privacy Policy</a> &amp; <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer" style="color:#64748b;text-decoration:underline;">Terms of Service</a> apply.
</p>
