---
const socialLinks = [
  { href: 'https://facebook.com', label: 'Facebook', icon: '<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>' },
  { href: 'https://instagram.com', label: 'Instagram', icon: '<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>' },
  { href: 'https://twitter.com', label: 'X (Twitter)', icon: '<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>' },
  { href: 'https://youtube.com', label: 'YouTube', icon: '<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>' },
];

const programLinks = [
  { href: '/programs/basketball/', label: '🏀 Basketball Academy' },
  { href: '/programs/volleyball/', label: '🏐 Volleyball Academy' },
  { href: '/programs/badminton/', label: '🏸 Badminton Academy' },
  { href: '/programs/soccer-little-kids/', label: '⚽ Soccer Little Kids (U2–U5 with Wascana FC)' },
  { href: '/programs/athletics/', label: '🏃 Athletics (Track & Field)' },
  { href: '/programs/tournaments/', label: '🏆 Tournaments & Fixtures' },
  { href: '/programs/#starting-soon', label: '🚀 More Sports Starting Soon' },
];

const academyLinks = [
  { href: '/safety/', label: 'Safety & Safeguards' },
  { href: '/about/', label: 'About NAA & Governance' },
  // { href: '/coaches/', label: 'Our Certified Coaches' },
  { href: '/registration/', label: 'Register Your Athlete' },
  { href: '/contact/', label: 'Contact Support Desk' },
];
---

<footer style="background:var(--color-naa-navy);color:white;padding-top:5rem;">
  <!-- Main footer content -->
  <div class="container-naa">
    <div style="display:grid;grid-template-columns:1.8fr 1.2fr 1fr;gap:3.5rem;padding-bottom:4rem;border-bottom:1px solid rgba(255,255,255,0.1);">
      
      <!-- Brand column -->
      <div>
        <a href="/" style="display:inline-flex;align-items:center;gap:1rem;margin-bottom:1.5rem;text-decoration:none;">
          <img src="/images/naa-logo-sm.webp" alt="National Athletics Academy Logo" width="60" height="60" style="border-radius:50%;" />
          <div>
            <div style="font-family:var(--font-outfit);font-weight:800;font-size:1.1rem;color:white;">National Athletics Academy</div>
            <div style="font-family:var(--font-outfit);font-weight:600;font-size:0.75rem;color:var(--color-naa-gold);letter-spacing:0.1em;text-transform:uppercase;">Inc. &mdash; Regina, Canada</div>
          </div>
        </a>
        <p style="color:rgba(255,255,255,0.65);font-size:0.9rem;line-height:1.7;max-width:380px;margin-bottom:2rem;">
          Regina's premier multi-sport training and competition organization. Structured development across Basketball, Volleyball, Badminton, Soccer (U2–U5 with Wascana FC), Athletics (Track &amp; Field), and Tournaments.
        </p>
        <!-- Social links -->
        <div style="display:flex;gap:0.75rem;">
          {socialLinks.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
              style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.7);transition:all 0.2s;"
              onmouseover="this.style.background='var(--color-naa-gold)';this.style.color='var(--color-naa-navy)';"
              onmouseout="this.style.background='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.7)';"
            >
              <span set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Programs Column -->
      <div>
        <h3 style="font-family:var(--font-outfit);font-weight:700;font-size:0.85rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-naa-gold);margin-bottom:1.5rem;">
          Programs (In Exact Order)
        </h3>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;">
          {programLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link" style="font-size:0.88rem;">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Academy Links -->
      <div>
        <h3 style="font-family:var(--font-outfit);font-weight:700;font-size:0.85rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-naa-gold);margin-bottom:1.5rem;">
          Academy Info
        </h3>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;">
          {academyLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link" style="font-size:0.88rem;">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Contact bar -->
    <div style="padding:2rem 0;display:flex;flex-wrap:wrap;gap:2rem;align-items:center;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <div style="width:36px;height:36px;border-radius:8px;background:rgba(221,170,64,0.15);display:flex;align-items:center;justify-content:center;">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-naa-gold)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <a href="mailto:info@nationalathletics.ca" class="footer-link" style="color:rgba(255,255,255,0.8);">info@nationalathletics.ca</a>
      </div>
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <div style="width:36px;height:36px;border-radius:8px;background:rgba(221,170,64,0.15);display:flex;align-items:center;justify-content:center;">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-naa-gold)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <span style="color:rgba(255,255,255,0.8);font-size:0.9rem;">Regina, Saskatchewan, Canada</span>
      </div>
      <div style="margin-left:auto;">
        <a href="/registration/" class="btn btn-primary btn-sm">Register Now &rarr;</a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div style="padding:1.5rem 0;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem;">
      <p style="color:rgba(255,255,255,0.4);font-size:0.8rem;">
        &copy; {new Date().getFullYear()} National Athletics Academy Inc. All rights reserved. Regina, Saskatchewan.
      </p>
      <div style="display:flex;gap:1.5rem;">
        <a href="/contact/" class="footer-link" style="font-size:0.8rem;">Privacy Policy</a>
        <a href="/contact/" class="footer-link" style="font-size:0.8rem;">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 768px) {
    footer > div > div:first-child {
      grid-template-columns: 1fr !important;
      gap: 2.5rem !important;
    }
  }
</style>
