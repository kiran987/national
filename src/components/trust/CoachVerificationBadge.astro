---
// src/components/trust/CoachVerificationBadge.astro
interface Props {
  variant?: 'banner' | 'grid' | 'compact';
}

const { variant = 'grid' } = Astro.props;

const credentials = [
  {
    title: 'Regina Police Service (RPS) Screened',
    desc: 'Criminal Record Checks with Vulnerable Sector Screening (CRC-VSS) for all coaches & staff.',
    badge: 'Mandatory Screening',
    iconSvg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>`
  },
  {
    title: 'Sask Sport & Respect in Sport Certified',
    desc: '100% compliance with Saskatchewan safe sport guidelines, anti-bullying protocols, and athlete welfare.',
    badge: 'Provincial Standard',
    iconSvg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path></svg>`
  },
  {
    title: 'CAC Rule of Two Enforced',
    desc: 'Training strictly in open, observable facilities with two screened adults present. Zero isolated 1-on-1 contact.',
    badge: 'CAC Safe Sport',
    iconSvg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  },
  {
    title: 'First Aid & CPR-C on Every Court',
    desc: 'Immediate emergency preparedness, concussion protocol awareness, and certified on-site response.',
    badge: 'Active Preparedness',
    iconSvg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>`
  }
];
---

{variant === 'compact' ? (
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 py-4 border-t border-slate-700/60">
    {credentials.map((c) => (
      <div class="flex items-center gap-2.5 text-xs text-slate-200">
        <span class="text-amber-400 shrink-0"><Fragment set:html={c.iconSvg} /></span>
        <span class="font-medium">{c.title}</span>
      </div>
    ))}
  </div>
) : (
  <section aria-labelledby="trust-section-title" class="py-12 bg-slate-900 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/10 text-amber-400 border border-amber-400/30 mb-2">
            Saskatchewan Safe Sport Governance
          </span>
          <h2 id="trust-section-title" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Regina Parent Peace of Mind
          </h2>
        </div>
        <p class="text-sm text-slate-300 max-w-xl">
          Every coach on the floor has been independently vetted by the Regina Police Service and certified through Coaching Association of Canada (CAC) standards before ever leading a drill.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {credentials.map((item) => (
          <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-5 hover:border-amber-400/40 transition-colors shadow-sm">
            <div class="flex items-center justify-between mb-3">
              <div class="w-10 h-10 rounded-lg bg-amber-400/10 text-amber-400 flex items-center justify-center">
                <Fragment set:html={item.iconSvg} />
              </div>
              <span class="text-xs font-semibold tracking-wider uppercase px-2 py-0.5 rounded bg-slate-700/80 text-amber-300">
                {item.badge}
              </span>
            </div>
            <h3 class="text-base font-bold text-white mb-2 leading-snug">
              {item.title}
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
