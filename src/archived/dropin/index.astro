---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="🏸 Community Badminton Drop-In Sessions | National Athletics Academy"
  description="Book your 1-hour community badminton drop-in session in Regina, SK for only $5. Real-time capacity caps (6 Doubles, 3 Singles, 9 total players) guarantee maximum court time."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero" aria-labelledby="dropin-heading" style="background:linear-gradient(160deg,var(--color-naa-navy) 0%,#010f24 50%,#83161B 100%);">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1.25rem;">Community Recreation</span>
        <h1 id="dropin-heading" style="font-size:clamp(1.9rem,4.5vw,3.25rem);color:white;margin-bottom:1rem;font-weight:900;letter-spacing:-0.02em;">
          🏸 Community Badminton Drop-In Sessions
        </h1>
        <p style="color:rgba(255,255,255,0.85);font-size:1.1rem;max-width:680px;margin:0 auto;line-height:1.75;">
          Open to adults, youth, and families across Regina. Reserve your 1-hour spot for just <strong>$5.00 CAD</strong>. Our strict session capacity guarantees quality court time with zero gym overcrowding.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Info & Rules Bar -->
  <section style="background:#021F47;padding:2rem 0;border-bottom:1px solid rgba(255,255,255,0.1);">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.25rem;">
        
        <!-- Fee Card -->
        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:1.25rem;display:flex;align-items:center;gap:1rem;">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(221,170,64,0.15);display:flex;align-items:center;justify-content:center;font-size:1.5rem;shrink-0;">
            💵
          </div>
          <div>
            <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-naa-gold);font-weight:700;">Drop-In Fee</div>
            <div style="font-size:1.15rem;font-weight:800;color:white;">$5.00 / Player</div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.6);">Per 1-hour court block</div>
          </div>
        </div>

        <!-- Strict Limits -->
        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:1.25rem;display:flex;align-items:center;gap:1rem;">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;font-size:1.5rem;shrink-0;">
            👥
          </div>
          <div>
            <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.06em;color:#93c5fd;font-weight:700;">Strict Session Cap</div>
            <div style="font-size:1.15rem;font-weight:800;color:white;">Max 9 Players / Hr</div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.6);">6 Doubles &bull; 3 Singles max</div>
          </div>
        </div>

        <!-- Footwear Card -->
        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:1.25rem;display:flex;align-items:center;gap:1rem;">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;font-size:1.5rem;shrink-0;">
            👟
          </div>
          <div>
            <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.06em;color:#86efac;font-weight:700;">Shoe Policy</div>
            <div style="font-size:1.15rem;font-weight:800;color:white;">Indoor Shoes Only</div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.6);">Clean, non-marking soles</div>
          </div>
        </div>

        <!-- Punctuality Card -->
        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:1.25rem;display:flex;align-items:center;gap:1rem;">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(244,63,94,0.15);display:flex;align-items:center;justify-content:center;font-size:1.5rem;shrink-0;">
            ⏰
          </div>
          <div>
            <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.06em;color:#fda4af;font-weight:700;">Arrival Time</div>
            <div style="font-size:1.15rem;font-weight:800;color:white;">10 Min Early</div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.6);">Check in with gym monitor</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Main Booking Section -->
  <section class="section-padding" style="background:#f8fafc;padding:3.5rem 0;">
    <div class="container-naa">
      <div style="max-width:760px;margin:0 auto;">

        <div style="text-align:center;margin-bottom:2rem;">
          <h2 style="font-size:clamp(1.5rem,3vw,2.1rem);color:var(--color-naa-navy);font-weight:800;margin-bottom:0.5rem;">
            Reserve Your Court Slot
          </h2>
          <p style="color:#64748b;font-size:0.95rem;max-width:560px;margin:0 auto;">
            Select your session date, choose your court format, and lock in your spot with live capacity verification.
          </p>
        </div>

        <!-- Booking Interface Card -->
        <div class="dropin-card" id="bookingCard" style="background:white;padding:2rem;border-radius:16px;box-shadow:0 8px 30px rgba(2,31,71,0.08);border:1px solid #e2e8f0;">
          
          <div id="errorBanner" style="display:none;background:#fee2e2;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:1.25rem;font-size:0.9rem;border:1px solid #fecaca;"></div>

          <form id="bookingForm" style="display:flex;flex-direction:column;gap:1.25rem;">
            
            <!-- Date Selection -->
            <div>
              <label for="sessionDate" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                Select Session Date &amp; Phase <span style="color:#dc2626;">*</span>
              </label>
              <select id="sessionDate" class="form-input" required style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;background:#fff;color:#1e293b;">
                <option value="">-- Choose a Date --</option>
                <optgroup label="Phase 1 (Oct 22 – Nov 13, 2026)">
                  <option value="2026-10-22">Thu, Oct 22, 2026</option>
                  <option value="2026-10-23">Fri, Oct 23, 2026</option>
                  <option value="2026-10-29">Thu, Oct 29, 2026</option>
                  <option value="2026-10-30">Fri, Oct 30, 2026</option>
                  <option value="2026-11-05">Thu, Nov 05, 2026</option>
                  <option value="2026-11-06">Fri, Nov 06, 2026</option>
                  <option value="2026-11-12">Thu, Nov 12, 2026</option>
                  <option value="2026-11-13">Fri, Nov 13, 2026</option>
                </optgroup>
                <optgroup label="Phase 2 (Nov 17 – Dec 10, 2026)">
                  <option value="2026-11-17">Tue, Nov 17, 2026</option>
                  <option value="2026-11-19">Thu, Nov 19, 2026</option>
                  <option value="2026-11-24">Tue, Nov 24, 2026</option>
                  <option value="2026-11-26">Thu, Nov 26, 2026</option>
                  <option value="2026-12-01">Tue, Dec 01, 2026</option>
                  <option value="2026-12-03">Thu, Dec 03, 2026</option>
                  <option value="2026-12-08">Tue, Dec 08, 2026</option>
                  <option value="2026-12-10">Thu, Dec 10, 2026</option>
                </optgroup>
              </select>
            </div>

            <!-- Time Slot Selection -->
            <div>
              <label for="sessionTime" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                Select 1-Hour Time Slot <span style="color:#dc2626;">*</span>
              </label>
              <select id="sessionTime" class="form-input" required disabled style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;background:#fff;color:#1e293b;">
                <option value="">-- Select Date First --</option>
              </select>
            </div>

            <!-- Court Format Selection -->
            <div>
              <label for="format" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                Court Format <span style="color:#dc2626;">*</span>
              </label>
              <select id="format" class="form-input" required style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;background:#fff;color:#1e293b;">
                <option value="Doubles">Doubles Court (Max 6 players / hr)</option>
                <option value="Singles">Singles Court (Max 3 players / hr)</option>
              </select>
              <div id="capacityInfo" style="display:inline-block;margin-top:8px;padding:6px 12px;border-radius:6px;font-size:0.83rem;font-weight:700;background:#dcfce7;color:#166534;border:1px solid #bbf7d0;">
                Select a date and time to check live availability
              </div>
            </div>

            <!-- Player Name & Division -->
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
              <div>
                <label for="playerName" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                  Player Full Name <span style="color:#dc2626;">*</span>
                </label>
                <input type="text" id="playerName" required placeholder="e.g. Ramesh Shrestha" style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;" />
              </div>

              <div>
                <label for="division" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                  Age Category / Division <span style="color:#dc2626;">*</span>
                </label>
                <select id="division" required style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;background:#fff;">
                  <option value="Adult">Adult (18–54)</option>
                  <option value="Junior">Junior (Under 18)</option>
                  <option value="Family">Family / Senior (55+)</option>
                </select>
              </div>
            </div>

            <!-- Parent/Guardian for Juniors -->
            <div id="guardianGroup" style="display:none;">
              <label for="guardianName" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                Parent / Legal Guardian Full Name <span style="color:#dc2626;">*</span>
              </label>
              <input type="text" id="guardianName" placeholder="Required for players under 18" style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;" />
            </div>

            <!-- Email & Phone -->
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
              <div>
                <label for="playerEmail" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                  Email Address <span style="color:#dc2626;">*</span>
                </label>
                <input type="email" id="playerEmail" required placeholder="name@example.com" style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;" />
              </div>

              <div>
                <label for="playerPhone" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                  Phone Number <span style="color:#dc2626;">*</span>
                </label>
                <input type="tel" id="playerPhone" required placeholder="(306) 555-0199" style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;" />
              </div>
            </div>

            <!-- Waiver Agreement -->
            <div>
              <label style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                Legal &amp; Facility Waiver Agreement <span style="color:#dc2626;">*</span>
              </label>
              <div style="background:#f8fafc;padding:14px;border-radius:8px;font-size:0.83rem;line-height:1.5;height:120px;overflow-y:scroll;border:1px solid #e2e8f0;margin-bottom:10px;color:#475569;">
                <strong>1. Assumption of Risk &amp; Liability:</strong> By submitting this reservation, the participant (and/or legal guardian) understands that sports carry physical risks and releases National Athletics Academy Inc. (NAA Canada) and facility hosts from liability for injuries, loss, or property damage.<br><br>
                <strong>2. Minor Consent:</strong> If the participant is under 18 years of age, the parent/guardian authorizes participation and agrees to all terms on their behalf.<br><br>
                <strong>3. Mandatory Clean Indoor Shoes:</strong> Only clean, non-marking indoor court shoes are allowed inside the gymnasium. Outdoor shoes are strictly prohibited on the court surface.<br><br>
                <strong>4. Session Punctuality:</strong> Please arrive 10 minutes prior to your reserved slot. Reservations are valid strictly for the 1-hour window booked.
              </div>
              <label style="display:flex;align-items:flex-start;gap:10px;font-size:0.88rem;cursor:pointer;color:#1e293b;">
                <input type="checkbox" id="waiverAgree" required style="margin-top:3px;cursor:pointer;" />
                <span>I have read, understood, and agree to the waiver terms, non-marking indoor shoe requirement, and gym rules.</span>
              </label>
            </div>

            <!-- Digital Signature -->
            <div>
              <label for="digitalSignature" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                Digital Signature (Type Full Legal Name) <span style="color:#dc2626;">*</span>
              </label>
              <input type="text" id="digitalSignature" required placeholder="Type your full legal name as digital signature" style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;" />
            </div>

            <!-- Payment Method -->
            <div>
              <label for="paymentMethod" style="display:block;font-weight:700;margin-bottom:6px;font-size:0.92rem;color:#1e293b;">
                Payment Method ($5.00 CAD per player) <span style="color:#dc2626;">*</span>
              </label>
              <select id="paymentMethod" required style="width:100%;padding:11px 14px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:0.95rem;background:#fff;">
                <option value="eTransfer_Cash">Interac e-Transfer or Exact Cash at Arrival</option>
                <option value="Online_Card">Credit / Debit Card Online ($5.00)</option>
              </select>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submitBtn"
              class="btn btn-primary"
              style="width:100%;padding:14px;font-size:1.05rem;font-weight:800;border-radius:10px;margin-top:8px;display:flex;align-items:center;justify-content:center;gap:8px;"
            >
              Confirm Reservation ($5.00 CAD)
            </button>

          </form>
        </div>

        <!-- Confirmation Card -->
        <div id="confirmationCard" style="display:none;background:white;padding:3rem 2rem;border-radius:16px;box-shadow:0 8px 30px rgba(2,31,71,0.08);border:1px solid #e2e8f0;text-align:center;">
          <div style="font-size:3.5rem;margin-bottom:0.75rem;">🎉</div>
          <h2 style="color:#16a34a;font-size:1.85rem;font-weight:900;margin-bottom:0.5rem;">
            Reservation Confirmed!
          </h2>
          <p style="color:#475569;font-size:1rem;margin-bottom:1.25rem;">
            Your badminton court slot is secured with National Athletics Academy.
          </p>
          
          <div style="margin:1.5rem 0;">
            <div style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.08em;color:#64748b;font-weight:700;margin-bottom:4px;">Booking Reference</div>
            <div id="resBookingId" style="font-size:1.8rem;font-weight:900;color:var(--color-naa-navy);letter-spacing:2px;background:#f0f9ff;border:1.5px dashed #0284c7;display:inline-block;padding:8px 24px;border-radius:8px;">
              NAA-XXXXXX
            </div>
          </div>

          <div id="paymentInstructions" style="background:#eff6ff;border-left:4px solid #3b82f6;padding:16px;border-radius:0 8px 8px 0;text-align:left;font-size:0.92rem;line-height:1.6;margin:1.5rem 0;color:#1e3a8a;">
          </div>

          <div style="background:#f8fafc;border-radius:10px;padding:16px;margin-top:1.5rem;font-size:0.85rem;color:#64748b;line-height:1.6;">
            <strong>Important Reminder:</strong> Please wear clean, non-marking indoor court shoes and arrive 10 minutes early. A confirmation receipt has also been dispatched to your email address.
          </div>

          <button
            onclick="location.reload()"
            class="btn btn-primary"
            style="margin:2rem auto 0;display:inline-flex;padding:12px 28px;"
          >
            Book Another Slot
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section style="background:white;padding:3.5rem 0;border-top:1px solid #e2e8f0;">
    <div class="container-naa" style="max-width:760px;">
      <h2 style="font-size:1.65rem;font-weight:800;color:var(--color-naa-navy);margin-bottom:1.5rem;text-align:center;">
        Frequently Asked Questions
      </h2>

      <div style="display:flex;flex-direction:column;gap:1.25rem;">
        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:1.25rem;">
          <h3 style="font-size:1.05rem;font-weight:700;color:var(--color-naa-navy);margin-bottom:6px;">Can I drop in without booking online?</h3>
          <p style="color:#64748b;font-size:0.9rem;line-height:1.6;margin:0;">
            Because of our strict 9-player gym cap, we strongly encourage reserving online in advance. Walk-ins at the door are subject to remaining slot availability on a first-come, first-served basis.
          </p>
        </div>

        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:1.25rem;">
          <h3 style="font-size:1.05rem;font-weight:700;color:var(--color-naa-navy);margin-bottom:6px;">What equipment should I bring?</h3>
          <p style="color:#64748b;font-size:0.9rem;line-height:1.6;margin:0;">
            Bring your own badminton racket and clean, non-marking indoor court shoes. Shuttles are provided for drop-in play. Outdoor shoes cannot be worn inside the gym.
          </p>
        </div>

        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:1.25rem;">
          <h3 style="font-size:1.05rem;font-weight:700;color:var(--color-naa-navy);margin-bottom:6px;">How does payment work?</h3>
          <p style="color:#64748b;font-size:0.9rem;line-height:1.6;margin:0;">
            The fee is $5.00 CAD per player per 1-hour session. You can send an Interac e-Transfer to <strong>payments@naacanada.org</strong> referencing your booking ID, bring exact $5 cash to the gym monitor, or pay via debit/credit card.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script is:inline>
  const API_URL = '/court-booking/booking-api.php';
  let liveCounts = {};

  const errorBanner = document.getElementById('errorBanner');
  function showError(msg) {
    if (!msg) {
      errorBanner.style.display = 'none';
      errorBanner.textContent = '';
    } else {
      errorBanner.textContent = msg;
      errorBanner.style.display = 'block';
    }
  }

  // Toggle Guardian field for Juniors
  const divisionSelect = document.getElementById('division');
  const guardianGroup = document.getElementById('guardianGroup');
  const guardianInput = document.getElementById('guardianName');

  if (divisionSelect) {
    divisionSelect.addEventListener('change', function() {
      const isJunior = (this.value === 'Junior');
      guardianGroup.style.display = isJunior ? 'block' : 'none';
      guardianInput.required = isJunior;
    });
  }

  // Dynamic slot times based on Phase 1 & Phase 2 schedule
  const dateInput = document.getElementById('sessionDate');
  const timeInput = document.getElementById('sessionTime');

  if (dateInput && timeInput) {
    dateInput.addEventListener('change', function() {
      timeInput.innerHTML = '';
      showError('');
      if (!this.value) {
        timeInput.disabled = true;
        timeInput.innerHTML = '<option value="">-- Select Date First --</option>';
        updateCapacityDisplay();
        return;
      }

      const [y, m, d] = this.value.split('-').map(Number);
      const dayOfWeek = new Date(y, m - 1, d).getDay(); // 2=Tue, 4=Thu, 5=Fri

      let options = [];
      if (dayOfWeek === 4) { // Thursday: 8:00 PM – 9:00 PM
        options.push('<option value="8:00 PM – 9:00 PM">8:00 PM – 9:00 PM</option>');
      } else if (dayOfWeek === 5 || dayOfWeek === 2) { // Tuesday or Friday: 6:00 PM – 7:00 PM & 8:00 PM – 9:00 PM
        options.push('<option value="6:00 PM – 7:00 PM">6:00 PM – 7:00 PM</option>');
        options.push('<option value="8:00 PM – 9:00 PM">8:00 PM – 9:00 PM</option>');
      } else {
        options.push('<option value="8:00 PM – 9:00 PM">8:00 PM – 9:00 PM</option>');
      }

      timeInput.innerHTML = options.join('');
      timeInput.disabled = false;
      updateCapacityDisplay();
    });
  }

  // Live Slot Availability Counter
  async function refreshCounts() {
    try {
      const res = await fetch(API_URL);
      const data = await res.json();
      if (data && data.counts) liveCounts = data.counts;
      updateCapacityDisplay();
    } catch(e) {
      console.warn('Could not fetch slot counts:', e);
    }
  }

  function updateCapacityDisplay() {
    const d = dateInput.value;
    const t = timeInput.value;
    const format = document.getElementById('format').value;
    const capInfo = document.getElementById('capacityInfo');
    const submitBtn = document.getElementById('submitBtn');

    if (!d || !t) {
      capInfo.style.background = '#dcfce7';
      capInfo.style.color = '#166534';
      capInfo.style.borderColor = '#bbf7d0';
      capInfo.textContent = 'Please choose date & time to view live availability';
      submitBtn.disabled = false;
      return;
    }

    const key = d + '_' + t;
    const current = liveCounts[key] || { doubles: 0, singles: 0, total: 0 };

    const doublesLeft = Math.max(0, 6 - (current.doubles || 0));
    const singlesLeft = Math.max(0, 3 - (current.singles || 0));
    const sessionLeft = Math.max(0, 9 - (current.total || 0));

    const targetLeft = (format === 'Doubles') ? Math.min(doublesLeft, sessionLeft) : Math.min(singlesLeft, sessionLeft);

    if (sessionLeft === 0) {
      capInfo.style.background = '#fee2e2';
      capInfo.style.color = '#991b1b';
      capInfo.style.borderColor = '#fecaca';
      capInfo.textContent = 'Session FULL (9/9 players booked)';
      submitBtn.disabled = true;
    } else if (targetLeft === 0) {
      capInfo.style.background = '#fee2e2';
      capInfo.style.color = '#991b1b';
      capInfo.style.borderColor = '#fecaca';
      capInfo.textContent = `${format} Court FULL for this slot (${format === 'Doubles' ? '6/6' : '3/3'} spots filled)`;
      submitBtn.disabled = true;
    } else {
      capInfo.style.background = '#dcfce7';
      capInfo.style.color = '#166534';
      capInfo.style.borderColor = '#bbf7d0';
      capInfo.textContent = `Available: ${targetLeft} spot(s) left in ${format} (${sessionLeft}/9 spots total remaining in gym)`;
      submitBtn.disabled = false;
    }
  }

  const formatSelect = document.getElementById('format');
  if (formatSelect) formatSelect.addEventListener('change', updateCapacityDisplay);
  if (timeInput) timeInput.addEventListener('change', updateCapacityDisplay);

  // Form submission
  const bookingForm = document.getElementById('bookingForm');
  if (bookingForm) {
    bookingForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      showError('');
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Reserving slot...';

      const payload = {
        date: dateInput.value,
        time: timeInput.value,
        format: document.getElementById('format').value,
        name: document.getElementById('playerName').value,
        division: document.getElementById('division').value,
        guardian: document.getElementById('guardianName').value,
        email: document.getElementById('playerEmail').value,
        phone: document.getElementById('playerPhone').value,
        waiverAccepted: document.getElementById('waiverAgree').checked,
        signature: document.getElementById('digitalSignature').value,
        paymentMethod: document.getElementById('paymentMethod').value
      };

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();

        if (!res.ok) {
          throw new Error(result.message || 'Booking failed');
        }

        // Show confirmation card
        document.getElementById('bookingCard').style.display = 'none';
        document.getElementById('confirmationCard').style.display = 'block';
        document.getElementById('resBookingId').textContent = result.bookingId;

        const pType = payload.paymentMethod;
        let instruct = '';
        if (pType === 'eTransfer_Cash') {
          instruct = `<strong>Payment Instructions ($5.00 CAD):</strong><br>
                      Please send an Interac e-Transfer of <strong>$5.00</strong> to <code>payments@naacanada.org</code> with reference note: <strong>${result.bookingId}</strong>.<br>
                      Alternatively, you may bring exact $5 cash to the gym monitor upon arrival.`;
        } else {
          instruct = `<strong>Online Card Payment ($5.00 CAD):</strong><br>
                      Click the secure link below to complete your payment:<br>
                      <a href="https://buy.stripe.com/your_stripe_link?client_reference_id=${result.bookingId}" target="_blank" style="display:inline-block;margin-top:10px;padding:10px 20px;background:#6366f1;color:#fff;border-radius:6px;text-decoration:none;font-weight:bold;">Pay $5.00 via Stripe &rarr;</a>`;
        }
        document.getElementById('paymentInstructions').innerHTML = instruct;

        // Scroll to confirmation
        document.getElementById('confirmationCard').scrollIntoView({ behavior: 'smooth', block: 'center' });

      } catch(err) {
        showError(err.message || 'An unexpected error occurred. Please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        refreshCounts();
      }
    });
  }

  refreshCounts();
</script>
