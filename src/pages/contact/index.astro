---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RecaptchaNotice from '../../components/RecaptchaNotice.astro';
---

<Layout
  title="Contact | National Athletics Academy Regina"
  description="General enquiries for National Athletics Academy Inc. in Regina, Saskatchewan. For program questions use Program Enquiry. For coaching use Apply to Coach. For upcoming programs use Notify Me."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero" aria-labelledby="contact-heading">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1.25rem;">General Enquiries</span>
        <h1 id="contact-heading" style="font-size:clamp(2rem,5vw,3.5rem);color:white;margin-bottom:1rem;">Contact Us</h1>
        <p style="color:rgba(255,255,255,0.75);font-size:1.1rem;max-width:600px;margin:0 auto;line-height:1.75;">
          For general questions about NAA, school sports days, corporate events, sponsorships, media, or anything else not covered below.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Route Cards -->
  <section style="background:#f8fafc;padding:2.5rem 0;border-bottom:1px solid #e2e8f0;">
    <div class="container-naa">
      <p style="font-size:0.82rem;font-family:var(--font-outfit);font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:1.25rem;text-align:center;">Looking for something specific? Use a dedicated form:</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;">
        <a href="/programs/enquiry/" style="display:flex;align-items:center;gap:0.875rem;background:white;border:2px solid #e2e8f0;border-radius:14px;padding:1.25rem;text-decoration:none;transition:all 0.2s;"
          onmouseover="this.style.borderColor='var(--color-naa-navy)';this.style.boxShadow='0 4px 16px rgba(2,31,71,0.1)';"
          onmouseout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none';">
          <span style="font-size:1.75rem;">💬</span>
          <div>
            <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);font-size:0.9rem;">Program Enquiry</div>
            <div style="font-size:0.75rem;color:#6b7280;">Questions about any program</div>
          </div>
        </a>
        <a href="/coaching/" style="display:flex;align-items:center;gap:0.875rem;background:white;border:2px solid #e2e8f0;border-radius:14px;padding:1.25rem;text-decoration:none;transition:all 0.2s;"
          onmouseover="this.style.borderColor='var(--color-naa-maroon)';this.style.boxShadow='0 4px 16px rgba(131,22,27,0.1)';"
          onmouseout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none';">
          <span style="font-size:1.75rem;">🏅</span>
          <div>
            <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);font-size:0.9rem;">Apply to Coach</div>
            <div style="font-size:0.75rem;color:#6b7280;">Volunteer & paid coaching roles</div>
          </div>
        </a>
        <a href="/notify/" style="display:flex;align-items:center;gap:0.875rem;background:white;border:2px solid #e2e8f0;border-radius:14px;padding:1.25rem;text-decoration:none;transition:all 0.2s;"
          onmouseover="this.style.borderColor='#166534';this.style.boxShadow='0 4px 16px rgba(22,101,52,0.1)';"
          onmouseout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none';">
          <span style="font-size:1.75rem;">🔔</span>
          <div>
            <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);font-size:0.9rem;">Notify Me</div>
            <div style="font-size:0.75rem;color:#6b7280;">Upcoming program alerts</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- General Contact Form -->
  <section class="section-padding" aria-labelledby="contact-form-heading">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:3fr 2fr;gap:5rem;align-items:start;">

        <!-- Form -->
        <div class="reveal">
          <h2 id="contact-form-heading" class="gold-accent" style="font-size:1.75rem;margin-bottom:0.5rem;">General Enquiry</h2>
          <p style="color:#6b7280;font-size:0.9rem;margin-bottom:2rem;">For school sports days, corporate events, sponsorships, media, and other general questions. We reply within 2 business days.</p>

          <div id="contact-success" class="form-success" role="alert">
            ✅ Message received! We'll reply within 2 business days.
          </div>

          <form id="contact-form" method="POST" action="/contact.php" novalidate style="display:flex;flex-direction:column;gap:1.25rem;">
            <input type="hidden" name="g-recaptcha-response" class="g-recaptcha-token" value="" />
            <div class="form-grid-2">
              <div class="form-group">
                <label for="contact-first" class="form-label">First Name <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="text" id="contact-first" name="first_name" class="form-input" required autocomplete="given-name" placeholder="First name" />
                <span class="form-error" id="err-first" aria-live="polite"></span>
              </div>
              <div class="form-group">
                <label for="contact-last" class="form-label">Last Name <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="text" id="contact-last" name="last_name" class="form-input" required autocomplete="family-name" placeholder="Last name" />
                <span class="form-error" id="err-last" aria-live="polite"></span>
              </div>
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label for="contact-email" class="form-label">Email <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="email" id="contact-email" name="email" class="form-input" required autocomplete="email" placeholder="you@example.com" />
                <span class="form-error" id="err-email" aria-live="polite"></span>
              </div>
              <div class="form-group">
                <label for="contact-phone" class="form-label">Phone</label>
                <input type="tel" id="contact-phone" name="phone" class="form-input" autocomplete="tel" placeholder="(306) 555-0100" />
              </div>
            </div>

            <div class="form-group">
              <label for="contact-subject" class="form-label">Topic <span style="color:var(--color-naa-maroon);">*</span></label>
              <select id="contact-subject" name="subject" class="form-input form-select" required>
                <option value="">Select a topic…</option>
                <option>General Inquiry</option>
                <option>School Sports Day Partnership</option>
                <option>Corporate Event / Team Building</option>
                <option>Sponsorship Opportunity</option>
                <option>Media / Press Inquiry</option>
                <option>Community Partnership</option>
                <option>Feedback / Suggestion</option>
                <option>Other</option>
              </select>
              <span class="form-error" id="err-subject" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="contact-message" class="form-label">Message <span style="color:var(--color-naa-maroon);">*</span></label>
              <textarea id="contact-message" name="message" class="form-input form-textarea" rows="5" required placeholder="Tell us how we can help…"></textarea>
              <span class="form-error" id="err-message" aria-live="polite"></span>
            </div>

              <button type="submit" class="btn btn-primary btn-lg" id="contact-submit-btn" style="width:100%;">
                Send Message
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              </button>
              <RecaptchaNotice action="contact" />
            </form>
        </div>

        <!-- Sidebar -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="reveal" style="background:var(--color-naa-navy);border-radius:20px;padding:2rem;color:white;">
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);margin-bottom:1.5rem;font-size:1rem;">Contact Information</h3>
            <div style="display:flex;flex-direction:column;gap:1.25rem;">
              <div style="display:flex;gap:0.875rem;align-items:flex-start;">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-naa-gold)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <p style="font-size:0.75rem;color:rgba(255,255,255,0.5);margin-bottom:0.25rem;font-family:var(--font-outfit);font-weight:600;letter-spacing:0.05em;text-transform:uppercase;">Phone</p>
                  <a href="tel:3063309559" style="color:rgba(255,255,255,0.95);font-size:0.95rem;font-weight:700;">(306) 330-9559</a>
                </div>
              </div>
              <div style="display:flex;gap:0.875rem;align-items:flex-start;">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-naa-gold)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <p style="font-size:0.75rem;color:rgba(255,255,255,0.5);margin-bottom:0.25rem;font-family:var(--font-outfit);font-weight:600;letter-spacing:0.05em;text-transform:uppercase;">Email</p>
                  <!--email_off--><a href="mailto:info@naacanada.org" style="color:rgba(255,255,255,0.9);font-size:0.9rem;">info@naacanada.org</a><!--/email_off-->
                </div>
              </div>
              <div style="display:flex;gap:0.875rem;align-items:flex-start;">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-naa-gold)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <div>
                  <p style="font-size:0.75rem;color:rgba(255,255,255,0.5);margin-bottom:0.25rem;font-family:var(--font-outfit);font-weight:600;letter-spacing:0.05em;text-transform:uppercase;">Address</p>
                  <p style="color:rgba(255,255,255,0.9);font-size:0.88rem;line-height:1.5;">217 BROAD ST N, REGINA<br/>Saskatchewan, Canada, S4R 2X7</p>
                </div>
              </div>
              <div style="display:flex;gap:0.875rem;align-items:flex-start;">
                <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-naa-gold)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                  <p style="font-size:0.75rem;color:rgba(255,255,255,0.5);margin-bottom:0.25rem;font-family:var(--font-outfit);font-weight:600;letter-spacing:0.05em;text-transform:uppercase;">Response Time</p>
                  <p style="color:rgba(255,255,255,0.9);font-size:0.9rem;">Within 2 business days</p>
                </div>
              </div>
            </div>
            <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,0.1);font-size:0.75rem;color:rgba(255,255,255,0.6);line-height:1.6;">
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.2rem;">National Athletics Academy Inc.</strong>
              A Registered Non-Profit Corporation in Saskatchewan<br/>
              ISC Entity #: 102242108
            </div>
          </div>

          <div class="reveal" style="background:var(--color-naa-grey);border-radius:20px;padding:2rem;">
            <div style="font-size:1.5rem;margin-bottom:0.875rem;">🏫</div>
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);font-size:1rem;margin-bottom:0.75rem;">Schools & Corporate</h3>
            <p style="color:#374151;font-size:0.875rem;line-height:1.65;">
              Book a sports day for your school, organize a corporate team-building event, or explore in-school delivery partnerships. Select the appropriate topic above.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service area -->
  <section style="background:var(--color-naa-grey);padding:3rem 0;" aria-label="Service area">
    <div class="container-naa" style="text-align:center;">
      <div class="reveal">
        <h2 style="font-size:1.5rem;color:var(--color-naa-navy);margin-bottom:0.75rem;">Serving Regina &amp; Area</h2>
        <p style="color:#6b7280;font-size:0.95rem;margin-bottom:2rem;">Programs operate at venues across Regina including school gymnasiums, community centres, and fieldhouses.</p>
        <div style="background:white;border-radius:20px;padding:3rem;box-shadow:0 4px 20px rgba(2,31,71,0.08);display:flex;align-items:center;justify-content:center;min-height:160px;gap:3rem;flex-wrap:wrap;">
          {['🏫 School Gymnasiums', '🏟️ Community Centres', '🏃 Fieldhouses', '🏢 Indoor Facilities'].map((venue) => (
            <div style="text-align:center;">
              <p style="font-family:var(--font-outfit);font-weight:600;color:var(--color-naa-navy);font-size:0.95rem;">{venue}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { executeRecaptcha } from '../../utils/recaptcha';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('contact-success') as HTMLElement;

  function setErr(id: string, msg: string) {
    const el = document.getElementById(id) as HTMLElement;
    if (el) el.textContent = msg;
  }
  function clearErrs() {
    document.querySelectorAll('.form-error').forEach((el) => (el.textContent = ''));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrs();

    const first   = (document.getElementById('contact-first') as HTMLInputElement).value.trim();
    const last    = (document.getElementById('contact-last') as HTMLInputElement).value.trim();
    const email   = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
    const subject = (document.getElementById('contact-subject') as HTMLSelectElement).value;
    const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value.trim();

    let valid = true;
    if (!first)   { setErr('err-first',   'First name is required.'); valid = false; }
    if (!last)    { setErr('err-last',    'Last name is required.'); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('err-email', 'Please enter a valid email.'); valid = false; }
    if (!subject) { setErr('err-subject', 'Please select a topic.'); valid = false; }
    if (!message || message.length < 10) { setErr('err-message', 'Please enter your message (at least 10 characters).'); valid = false; }
    if (!valid) return;

    const btn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
    btn.textContent = 'Sending…';
    btn.disabled = true;

    try {
      const recaptchaToken = await executeRecaptcha('contact');
      const tokenInput = form.querySelector<HTMLInputElement>('.g-recaptcha-token, input[name="g-recaptcha-response"]');
      if (tokenInput && recaptchaToken) {
        tokenInput.value = recaptchaToken;
      }
      const data = new FormData(form);
      if (recaptchaToken) {
        data.set('g-recaptcha-response', recaptchaToken);
      }
      const resp = await fetch('/contact.php', { method: 'POST', body: data });
      const result = await resp.json().catch(() => ({}));
      if (resp.ok && result.success !== false) {
        form.style.display = 'none';
        success.classList.add('show');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        btn.textContent = 'Send Message';
        btn.disabled = false;
        alert(result.error || result.message || 'Something went wrong. Please email info@naacanada.org directly.');
      }
    } catch {
      form.submit();
    }
  });
</script>

<style>
  @media (max-width: 860px) {
    section.section-padding > .container-naa > div { grid-template-columns: 1fr !important; gap: 3rem !important; }
    section[style*="padding:2.5rem"] > .container-naa > div { grid-template-columns: 1fr !important; }
  }
</style>
