---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Live Schedule | National Athletics Academy"
  description="Live NAA schedule from TeamLinkt."
  noindex
>
  <Header />

  <main style="padding:9.75rem 1.5rem 4rem;background:#f8fafc;min-height:70vh;">
    <div class="container-naa">
      <h1 style="font-family:var(--font-outfit);font-size:clamp(1.75rem,4vw,2.5rem);font-weight:900;color:var(--color-naa-navy);margin-bottom:0.5rem;">Live Schedule</h1>
      <p style="color:#4b5563;margin-bottom:1.5rem;">Live schedule from TeamLinkt.</p>
      <iframe id="Schedule" title="NAA Schedule" width="100%" height="700" frameborder="0" style="border:0;background:white;border-radius:12px;" src="https://leagues.teamlinkt.com/nationalathleticsacademy/Schedule?iframe"></iframe>
    </div>
  </main>

  <Footer />
</Layout>
