---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RecaptchaNotice from '../../components/RecaptchaNotice.astro';

const upcomingPrograms = [
  { emoji: '🏕️', name: 'Camps & Clinics', sub: 'Summer Day Camps, School Breaks, PD Days', highlight: true },
  { emoji: '🏆', name: 'Tournaments & Showcases', sub: 'Seasonal Invitationals & Multi-Sport Events', highlight: false },
  { emoji: '🏃', name: 'Athletics (Track & Field)', sub: 'Ages 6–16 · Sprint, Jump & Field', highlight: false },
  { emoji: '🏈', name: 'Flag Football & Ball Hockey', sub: 'Ages 6–15 · Multi-Sport Seasonal Leagues', highlight: false },
  { emoji: '🥒', name: 'Pickleball & Family Recreation', sub: 'Ages 10+ & Adult/Senior', highlight: false },
  { emoji: '♟️', name: 'Mind Sports & Chess Academy', sub: 'Ages 5–17 & Adult', highlight: false },
  { emoji: '💪', name: 'Strength & Conditioning', sub: 'Ages 8–17 & Adult', highlight: false },
];

const ageRanges = [
  'Ages 2–4 (Toddler)',
  'Ages 5–7',
  'Ages 8–11',
  'Ages 12–16',
  'Ages 17+ / Adult',
  'Multiple ages / Family',
];
---

<Layout
  title="Notify Me — Upcoming Programs | National Athletics Academy"
  description="Be the first to know when First Kicks Soccer, Athletics, Camps, Tournaments, and more launch at NAA. Sign up for early access notifications."
>
  <Header />

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="notify-heading" style="background:linear-gradient(160deg,#021F47 0%,#010f24 55%,#14532d 100%);">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(34,197,94,0.2);color:#4ade80;border:1px solid rgba(34,197,94,0.3);margin-bottom:1.25rem;">
          🔔 Early Access · Be First to Know
        </span>
        <h1 id="notify-heading" style="font-size:clamp(2.2rem,5vw,3.5rem);color:white;margin-bottom:1rem;font-weight:900;">
          Notify Me When Programs Open
        </h1>
        <p style="color:rgba(255,255,255,0.85);font-size:1.1rem;max-width:640px;margin:0 auto;line-height:1.75;">
          Registration for First Kicks Soccer, Athletics, Camps, Tournaments, and more is starting soon. Sign up and we'll notify you the moment registration opens — before the public announcement.
        </p>
      </div>
    </div>
  </section>


  <!-- Form + Program List -->
  <section id="notify-form" class="section-padding" style="scroll-margin-top:80px;" aria-labelledby="notify-form-heading">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:3fr 2fr;gap:5rem;align-items:start;">

        <!-- Form -->
        <div class="reveal">
          <h2 id="notify-form-heading" class="gold-accent" style="font-size:1.75rem;margin-bottom:0.5rem;">Sign Up for Early Access</h2>
          <p style="color:#6b7280;font-size:0.9rem;margin-bottom:2rem;">Select the programs you're interested in and we'll email you as soon as registration opens.</p>

          <div id="notify-success" class="form-success" role="alert">
            ✅ You're on the list! We'll notify you as soon as your selected programs open for registration.
          </div>

          <form id="notify-form-el" method="POST" action="/send-mail.php" novalidate style="display:flex;flex-direction:column;gap:1.25rem;">
            <input type="hidden" name="g-recaptcha-response" class="g-recaptcha-token" value="" />
            <div class="form-grid-2">
              <div class="form-group">
                <label for="notify-first" class="form-label">First Name <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="text" id="notify-first" name="first_name" class="form-input" required autocomplete="given-name" placeholder="First name" />
                <span class="form-error" id="err-notify-first" aria-live="polite"></span>
              </div>
              <div class="form-group">
                <label for="notify-last" class="form-label">Last Name <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="text" id="notify-last" name="last_name" class="form-input" required autocomplete="family-name" placeholder="Last name" />
                <span class="form-error" id="err-notify-last" aria-live="polite"></span>
              </div>
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label for="notify-email" class="form-label">Email <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="email" id="notify-email" name="email" class="form-input" required autocomplete="email" placeholder="you@example.com" />
                <span class="form-error" id="err-notify-email" aria-live="polite"></span>
              </div>
              <div class="form-group">
                <label for="notify-phone" class="form-label">Phone <span style="color:#9ca3af;font-weight:400;">(optional)</span></label>
                <input type="tel" id="notify-phone" name="phone" class="form-input" autocomplete="tel" placeholder="(306) 555-0100" />
              </div>
            </div>

            <div class="form-group">
              <label for="notify-age" class="form-label">Athlete Age Range</label>
              <select id="notify-age" name="age_range" class="form-input form-select">
                <option value="">Select age range…</option>
                {ageRanges.map(r => <option value={r}>{r}</option>)}
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Programs I Want to Be Notified About <span style="color:var(--color-naa-maroon);">*</span></label>
              <div style="display:flex;flex-direction:column;gap:0.6rem;margin-top:0.5rem;">
                {upcomingPrograms.map((prog) => (
                  <label style={`display:flex;align-items:center;gap:0.75rem;font-size:0.875rem;color:#374151;cursor:pointer;background:${prog.highlight ? 'rgba(34,197,94,0.05)' : 'transparent'};border:${prog.highlight ? '1px solid rgba(34,197,94,0.25)' : '1px solid transparent'};border-radius:10px;padding:0.6rem 0.75rem;transition:background 0.15s;`}>
                    <input type="checkbox" name="programs[]" value={prog.name} style="accent-color:var(--color-naa-navy);width:16px;height:16px;flex-shrink:0;" />
                    <div>
                      <div style="font-weight:600;">{prog.emoji} {prog.name}</div>
                      <div style="font-size:0.75rem;color:#6b7280;">{prog.sub}</div>
                    </div>
                  </label>
                ))}
              </div>
              <span class="form-error" id="err-notify-programs" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="notify-notes" class="form-label">Anything else? <span style="color:#9ca3af;font-weight:400;">(optional)</span></label>
              <textarea id="notify-notes" name="notes" class="form-input" rows="3" placeholder="e.g. specific session times that work, number of kids registering, questions…"></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg" id="notify-submit-btn" style="width:100%;">
              Notify Me When Open →
            </button>
            <RecaptchaNotice action="notify_signup" />
            <p style="font-size:0.78rem;color:#9ca3af;text-align:center;">No spam. One email per program when registration opens.</p>
          </form>
        </div>

        <!-- Sidebar -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="card reveal" style="padding:2rem;background:var(--color-naa-navy);color:white;">
            <div style="font-size:2rem;margin-bottom:1rem;">📅</div>
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:1rem;margin-bottom:0.75rem;">What Happens Next?</h3>
            <ol style="list-style:none;display:flex;flex-direction:column;gap:0.875rem;counter-reset:steps;">
              {['You sign up with your program preferences.', 'We email you when that program opens for registration — before public announcement.', 'You get first access to secure your spot.'].map((step, i) => (
                <li style="display:flex;gap:0.75rem;align-items:flex-start;">
                  <span style="background:var(--color-naa-gold);color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;font-size:0.8rem;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">{i+1}</span>
                  <span style="font-size:0.85rem;color:rgba(255,255,255,0.82);line-height:1.55;">{step}</span>
                </li>
              ))}
            </ol>
          </div>

          <div class="card reveal" style="padding:1.75rem;background:rgba(221,170,64,0.07);border:2px solid rgba(221,170,64,0.3);">
            <div style="font-size:1.5rem;margin-bottom:0.75rem;">💬</div>
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);font-size:0.95rem;margin-bottom:0.5rem;">Have a Specific Question?</h3>
            <p style="color:#374151;font-size:0.82rem;line-height:1.6;margin-bottom:1rem;">Use our Program Enquiry form to ask specific questions about any upcoming program.</p>
            <a href="/programs/enquiry/" class="btn btn-navy btn-sm" style="width:100%;justify-content:center;">Program Enquiry →</a>
          </div>

          <div class="card reveal" style="padding:1.75rem;background:var(--color-naa-grey);">
            <div style="font-size:1.5rem;margin-bottom:0.75rem;">🏸</div>
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);font-size:0.95rem;margin-bottom:0.5rem;">4 Programs Running Now</h3>
            <p style="color:#374151;font-size:0.82rem;line-height:1.6;margin-bottom:0.75rem;">Basketball, Volleyball, Badminton, and National Shield - Martial Arts are open for registration interest today.</p>
            <a href="/registration/" class="btn btn-sm" style="background:var(--color-naa-maroon);color:white;width:100%;justify-content:center;">Register Now →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { executeRecaptcha } from '../../utils/recaptcha';

  const form = document.getElementById('notify-form-el') as HTMLFormElement;
  const success = document.getElementById('notify-success') as HTMLElement;

  function setErr(id: string, msg: string) {
    const el = document.getElementById(id) as HTMLElement;
    if (el) el.textContent = msg;
  }
  function clearErrs() {
    document.querySelectorAll('.form-error').forEach((el) => (el.textContent = ''));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrs();

    const first    = (document.getElementById('notify-first') as HTMLInputElement).value.trim();
    const last     = (document.getElementById('notify-last') as HTMLInputElement).value.trim();
    const email    = (document.getElementById('notify-email') as HTMLInputElement).value.trim();
    const programs = document.querySelectorAll('input[name="programs[]"]:checked');

    let valid = true;
    if (!first) { setErr('err-notify-first', 'First name is required.'); valid = false; }
    if (!last)  { setErr('err-notify-last',  'Last name is required.');  valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('err-notify-email', 'Valid email required.'); valid = false; }
    if (programs.length === 0) { setErr('err-notify-programs', 'Please select at least one program.'); valid = false; }
    if (!valid) return;

    const btn = document.getElementById('notify-submit-btn') as HTMLButtonElement;
    btn.textContent = 'Signing up…';
    btn.disabled = true;

    try {
      const recaptchaToken = await executeRecaptcha('notify_submission');
      const tokenInput = form.querySelector<HTMLInputElement>('.g-recaptcha-token, input[name="g-recaptcha-response"]');
      if (tokenInput && recaptchaToken) {
        tokenInput.value = recaptchaToken;
      }
      const data = new FormData(form);
      if (recaptchaToken) {
        data.set('g-recaptcha-response', recaptchaToken);
      }
      const resp = await fetch('/send-mail.php', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: data
      });
      const result = await resp.json().catch(() => ({}));
      if (resp.ok && result.success !== false) {
        form.style.display = 'none';
        success.classList.add('show');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        btn.textContent = 'Notify Me When Open →';
        btn.disabled = false;
        alert(result.error || result.message || 'Something went wrong. Please email info@naacanada.org directly.');
      }
    } catch {
      // Fallback to native form submission
      form.submit();
    }
  });
</script>

<style>
  @media (max-width: 860px) {
    section.section-padding > .container-naa > div { grid-template-columns: 1fr !important; gap: 3rem !important; }
  }
</style>
