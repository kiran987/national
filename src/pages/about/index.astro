---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="About | National Athletics Academy"
  description="Learn about National Athletics Academy Inc. — our mission, vision, values, brand, and the story behind Regina's premier multi-sport training organization."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero" aria-labelledby="about-heading">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1.25rem;">Our Story</span>
        <h1 id="about-heading" style="font-size:clamp(2rem,5vw,3.5rem);color:white;margin-bottom:1rem;">About NAA</h1>
        <p style="color:rgba(255,255,255,0.75);font-size:1.1rem;max-width:600px;margin:0 auto;">
          National Athletics Academy Inc. — a Regina-based multi-sport training and competition organization built to develop athletes across every sport, every age, and every level.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission + Vision -->
  <section class="section-padding" aria-labelledby="mission-heading">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;">
        <div class="reveal">
          <span class="badge" style="background:rgba(2,31,71,0.1);color:var(--color-naa-navy);margin-bottom:1rem;">Who We Are</span>
          <h2 id="mission-heading" class="gold-accent" style="font-size:clamp(1.75rem,3vw,2.5rem);margin-bottom:1.5rem;">One Academy. Every Sport.</h2>
          <p style="color:#374151;line-height:1.8;margin-bottom:1.5rem;">
            National Athletics Academy Inc. is a non-profit corporation headquartered in Regina, Saskatchewan. We deliver structured developmental training in Basketball, Volleyball, Badminton, Soccer for Little Kids (U2–U5 with Wascana FC), Athletics (Track &amp; Field), and Tournaments — all under one brand, one coaching philosophy, and one unified registration system.
          </p>
          <p style="color:#374151;line-height:1.8;margin-bottom:2rem;">
            Most youth sport in Saskatchewan is delivered by single-sport clubs operating in isolation. A family with two children in three activities deals with three organizations, three portals, and three fee schedules. NAA consolidates that experience — so every family in Regina has one trusted home for every sport their children love, with more sports and activities starting soon.
          </p>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            <div style="display:flex;gap:0.875rem;align-items:flex-start;">
              <div style="width:44px;height:44px;border-radius:12px;background:rgba(2,31,71,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">🏢</div>
              <div>
                <strong style="font-family:var(--font-outfit);font-size:0.9rem;color:var(--color-naa-navy);">Legal Entity</strong>
                <p style="font-size:0.88rem;color:#6b7280;margin-top:0.25rem;">Non-Profit Corporation under The Non-profit Corporations Act, 1995 (Saskatchewan)</p>
              </div>
            </div>
            <div style="display:flex;gap:0.875rem;align-items:flex-start;">
              <div style="width:44px;height:44px;border-radius:12px;background:rgba(2,31,71,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">📍</div>
              <div>
                <strong style="font-family:var(--font-outfit);font-size:0.9rem;color:var(--color-naa-navy);">Headquarters</strong>
                <p style="font-size:0.88rem;color:#6b7280;margin-top:0.25rem;">Regina, Saskatchewan, Canada</p>
              </div>
            </div>
            <div style="display:flex;gap:0.875rem;align-items:flex-start;">
              <div style="width:44px;height:44px;border-radius:12px;background:rgba(2,31,71,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">🗓️</div>
              <div>
                <strong style="font-family:var(--font-outfit);font-size:0.9rem;color:var(--color-naa-navy);">Founded</strong>
                <p style="font-size:0.88rem;color:#6b7280;margin-top:0.25rem;">2026</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Logo -->
        <div class="reveal" style="text-align:center;">
          <img
            src="/images/naa-logo-md.webp"
            alt="National Athletics Academy Logo"
            width="320"
            height="320"
            style="border-radius:50%;box-shadow:0 20px 60px rgba(2,31,71,0.15);margin:0 auto;"
          />
          <div style="margin-top:2rem;background:var(--color-naa-grey);border-radius:16px;padding:1.5rem;text-align:left;">
            <p style="font-family:var(--font-outfit);font-weight:700;font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-naa-navy);margin-bottom:0.75rem;">The NAA Emblem</p>
            <p style="font-size:0.85rem;color:#374151;line-height:1.65;">The circular emblem features a maple leaf, multi-sport athlete silhouettes, and stars framed by the National Athletics Academy mark. It represents high-quality coaching, multi-sport accessibility, and Canadian athletic development.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission / Vision / Values -->
  <section style="background:var(--color-naa-navy);padding:6rem 0;" aria-labelledby="mvv-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:4rem;">
        <h2 id="mvv-heading" style="font-size:clamp(1.75rem,3vw,2.5rem);color:white;margin-bottom:1rem;">Mission, Vision &amp; Values</h2>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-bottom:3rem;">
        <!-- Mission -->
        <div class="reveal" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:20px;padding:2.5rem;">
          <div style="font-size:2rem;margin-bottom:1rem;">🎯</div>
          <h3 style="font-family:var(--font-outfit);font-weight:800;color:var(--color-naa-gold);font-size:1.1rem;margin-bottom:1rem;">Mission</h3>
          <p style="color:rgba(255,255,255,0.85);line-height:1.85;font-size:0.95rem;">
            To make high-quality, structured, multi-sport training accessible to every family in Regina — building physical literacy, competitive ability and character in athletes of all ages, across all sports, from one trusted academy.
          </p>
        </div>

        <!-- Vision -->
        <div class="reveal" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:20px;padding:2.5rem;animation-delay:0.1s;">
          <div style="font-size:2rem;margin-bottom:1rem;">🔭</div>
          <h3 style="font-family:var(--font-outfit);font-weight:800;color:var(--color-naa-gold);font-size:1.1rem;margin-bottom:1rem;">Vision</h3>
          <p style="color:rgba(255,255,255,0.85);line-height:1.85;font-size:0.95rem;">
            To be Saskatchewan's leading multi-sport academy: the first place a family looks when a child wants to try a sport, when a youth athlete wants to get better, and when an adult wants to get stronger.
          </p>
        </div>
      </div>

      <!-- Values -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;">
        {[
          { icon: '🏅', value: 'Excellence', desc: 'Certified coaches, structured curricula, measurable athlete progress. No filler sessions.' },
          { icon: '🤝', value: 'Access', desc: 'Newcomer outreach, equipment lending, and financial assistance support. No child turned away for cost alone.' },
          { icon: '🛡️', value: 'Safety', desc: 'Screened coaches, Respect in Sport Certified, age-appropriate loading, concussion protocols.' },
          { icon: '🎽', value: 'Multi-Sport', desc: 'Athletes are encouraged to play several sports. Early specialization is actively discouraged.' },
          { icon: '🌍', value: 'Community', desc: 'Sport as a place where a diverse city meets, competes and belongs together.' },
          { icon: '💎', value: 'Integrity', desc: 'Transparent fees, honest communication with families, accountable financial management.' },
        ].map((v, i) => (
          <div class="reveal" style={`animation-delay:${i*80}ms;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:2rem;`}>
            <div style="font-size:2rem;margin-bottom:0.75rem;">{v.icon}</div>
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);margin-bottom:0.5rem;font-size:0.95rem;">{v.value}</h3>
            <p style="color:rgba(255,255,255,0.65);font-size:0.85rem;line-height:1.65;">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>



  <!-- Service area -->
  <section style="background:var(--color-naa-grey);padding:5rem 0;" aria-labelledby="area-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3rem;">
        <h2 id="area-heading" class="gold-accent-center" style="font-size:clamp(1.75rem,3vw,2.5rem);">Service Area</h2>
        <p style="color:#374151;max-width:500px;margin:0 auto;line-height:1.75;">Where NAA delivers programs and events across Saskatchewan.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;" class="reveal">
        {[
          { tier: 'Core', area: 'City of Regina', role: 'All programs, all pillars, primary participant base', icon: '📍', color: 'var(--color-naa-navy)' },
          { tier: 'Secondary', area: 'Regina CMA', role: 'White City, Emerald Park, Pilot Butte, Balgonie, Lumsden, Pense', icon: '🗺️', color: 'var(--color-naa-maroon)' },
          { tier: 'Regional', area: 'Southern Saskatchewan', role: 'Moose Jaw, Fort Qu\'Appelle, Indian Head, Weyburn, Yorkton', icon: '🌾', color: 'var(--color-naa-maple)' },
          { tier: 'Provincial', area: 'Saskatchewan', role: 'Provincial competitions, camps, and regional sports partnerships', icon: '🏔️', color: '#a07820' },
        ].map((location, i) => (
          <div style={`background:white;border-radius:16px;padding:1.75rem;border-top:4px solid ${location.color};box-shadow:0 4px 20px rgba(2,31,71,0.08);`}>
            <div style="font-size:2rem;margin-bottom:0.875rem;">{location.icon}</div>
            <span class="badge" style={`background:rgba(2,31,71,0.07);color:${location.color};margin-bottom:0.75rem;`}>{location.tier}</span>
            <h3 style={`color:${location.color};font-size:0.95rem;margin-bottom:0.5rem;`}>{location.area}</h3>
            <p style="font-size:0.82rem;color:#6b7280;line-height:1.6;">{location.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:linear-gradient(135deg,var(--color-naa-maroon) 0%,var(--color-naa-maple) 100%);padding:4rem 0;">
    <div class="container-naa" style="text-align:center;">
      <div class="reveal">
        <h2 style="font-size:2rem;color:white;margin-bottom:1rem;">Be Part of Something New</h2>
        <p style="color:rgba(255,255,255,0.85);max-width:500px;margin:0 auto 2rem;line-height:1.7;">Register your interest now and be among the first families to join National Athletics Academy.</p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="/registration/" class="btn btn-gold btn-lg" id="about-cta-btn">Register Now</a>
          <a href="/contact/" class="btn btn-outline btn-lg" id="about-contact-btn">Get In Touch</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
