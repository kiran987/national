            open={i === 0}
          >
            <summary class="flex items-center justify-between gap-4 cursor-pointer select-none px-5 py-4 sm:px-6 sm:py-5 font-outfit font-bold text-sm sm:text-base text-[#0B192C] hover:bg-slate-50 list-none">
              <div class="flex items-center gap-3">
                <span class="w-7 h-7 rounded-lg bg-[#0B192C] text-amber-300 font-mono text-xs font-extrabold flex items-center justify-center shrink-0">
                  {i + 1}
                </span>
                <span>{p.title}</span>
              </div>
              <span class="w-7 h-7 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center shrink-0 transition-transform duration-200 group-open:rotate-180">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 sm:px-6 sm:pb-6 pt-1 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100">
              {p.intro && <p class={p.items ? 'mb-3' : ''}>{p.intro}</p>}
              {p.items && (
                <ul class="space-y-2 pl-5 list-disc marker:text-[#83161B]">
                  {p.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  function updateSmashCountdown() {
    const gameDay = new Date('2027-02-27T08:00:00-06:00').getTime();
    const diff = Math.max(0, gameDay - Date.now());
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const mins = Math.floor((diff / (1000 * 60)) % 60);
    const secs = Math.floor((diff / 1000) % 60);

    const set = (id: string, val: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(val).padStart(2, '0');
    };
    set('cd-days', days);
    set('cd-hours', hours);
    set('cd-mins', mins);
    set('cd-secs', secs);
  }

  updateSmashCountdown();
  setInterval(updateSmashCountdown, 1000);
</script>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
