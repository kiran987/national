---
import Layout from '../../../../../layouts/Layout.astro';
import Header from '../../../../../components/Header.astro';
import Footer from '../../../../../components/Footer.astro';

const highlights = [
  {
    title: '8 Dedicated Indoor Courts',
    desc: 'Running simultaneously inside the U of R KHS Gymnasium for non-stop tournament play.',
    icon: 'court',
  },
  {
    title: 'Fast-Paced Championship Flow',
    desc: 'Streamlined match scheduling and capped draws mean zero wasted downtime waiting around.',
    icon: 'bolt',
  },
  {
    title: 'Premium Tournament Shuttles',
    desc: 'Official match-grade shuttles supplied for every single match across all brackets.',
    icon: 'shuttle',
  },
  {
    title: 'Custom Medals & Trophies',
    desc: 'Custom championship medals and division trophies awarded across all 20 brackets.',
    icon: 'trophy',
  },
  {
    title: 'Grand Unified Podium Ceremony',
    desc: 'Official championship awards & podium photo ceremony from 5:00 PM – 6:00 PM.',
    icon: 'podium',
  },
];

const juniorDivisions = [
  { code: 'U11', name: 'Under-11', brackets: ['Boys Singles', 'Girls Singles', 'Open Doubles'] },
  { code: 'U13', name: 'Under-13', brackets: ['Boys Singles', 'Girls Singles', 'Open Doubles'] },
  { code: 'U15', name: 'Under-15', brackets: ['Boys Singles', 'Girls Singles', 'Open Doubles'] },
  { code: 'U17', name: 'Under-17', brackets: ['Boys Singles', 'Girls Singles', 'Open Doubles'] },
  { code: 'U19', name: 'Under-19', brackets: ['Boys Singles', 'Girls Singles', 'Open Doubles'] },
];

const adultDivisions = [
  { code: 'MS', name: "Men's Singles", type: 'Singles · 1v1' },
  { code: 'WS', name: "Women's Singles", type: 'Singles · 1v1' },
  { code: 'MD', name: "Men's Doubles", type: 'Gender Doubles · 2v2' },
  { code: 'WD', name: "Women's Doubles", type: 'Gender Doubles · 2v2' },
  { code: 'XD', name: 'Mixed Doubles', type: 'Mixed Pair · 2v2' },
];

const timeline = [
  {
    date: 'Opening Soon',
    tag: 'Registration Opens',
    label: 'Official Online Registration Opens',
    desc: 'First-come, first-served entry across all 20 brackets.',
    active: true,
  },
  {
    date: 'February 15, 2027',
    tag: 'Entry Deadline',
    label: 'Registration Closes',
    desc: 'Closes at 11:59 PM CST — or earlier as individual division caps are hit.',
    active: false,
  },
  {
    date: 'February 20, 2027',
    tag: 'Draws Live',
    label: 'Official Draws & Match Timetable Published',
    desc: 'Full bracket seedings and court schedules published online.',
    active: false,
  },
  {
    date: 'February 27, 2027',
    tag: 'Championship Day',
    label: 'GAME DAY — National Smash Open 2027',
    desc: '8:00 AM – 6:00 PM Sharp at KHS Gymnasium, University of Regina.',
    active: false,
  },
];

const gameDay = [
  { time: '07:30 AM', title: 'Athlete Check-in & Warm-ups', detail: 'Registration desk open, court warm-up rotation' },
  { time: '08:00 AM', title: 'Tournament Play Commences', detail: 'All 8 courts running simultaneously' },
  { time: '03:45 PM', title: 'Championship Finals', detail: 'Showdown finals on Courts 1–4' },
  { time: '05:00 – 06:00 PM', title: 'Grand Award Ceremony & Podium Photos', detail: 'Medals, trophies & official championship photography' },
];

const policies: { title: string; intro?: string; items?: string[] }[] = [
  {
    title: 'Independent Open Event Status',
    intro:
      'National Smash Open 2027 is an independent, unsanctioned tournament organized by National Athletics Academy Inc. It is not affiliated with or sanctioned by Badminton Canada or Sask Badminton. No provincial membership is required to participate, and matches will not count toward provincial or national ranking points.',
  },
  {
    title: 'Format & Schedule Adjustment Rights',
    intro: 'Tournament management reserves the right to:',
    items: [
      'Combine under-subscribed age categories or convert brackets into round-robin pool play based on final entry counts.',
      'Adjust match scoring formats (e.g., set length and point caps) to guarantee that all events conclude within venue rental hours.',
      'Enforce strict 3-minute walkover/default rules to keep courts moving on time.',
    ],
  },
  {
    title: 'Withdrawal & Refund Policy',
    items: [
      'Full refund (minus a $5 administrative processing fee) for cancellations requested in writing prior to the registration deadline (February 15, 2027).',
      'No refunds will be issued for withdrawals, injuries, or no-shows after the draws and schedule have been published on February 20, 2027.',
    ],
  },
  {
    title: 'Injury, Liability & Media Notice',
    intro:
      'Badminton is a high-intensity, physically demanding sport. All athletes participate at their own risk. By registering, players (and parent/legal guardians for minor athletes) acknowledge personal responsibility for injury, property loss, or damage, and consent to the use of tournament photography and video for event promotional purposes.',
  },
];

const eventSchema = {
  '@type': 'SportsEvent',
  name: 'National Smash Open 2027',
  description:
    'A one-day independent open badminton championship on 8 courts with 20 brackets across youth and adult divisions at KHS Gymnasium, University of Regina.',
  startDate: '2027-02-27T08:00:00-06:00',
  endDate: '2027-02-27T18:00:00-06:00',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  sport: 'Badminton',
  location: {
    '@type': 'SportsActivityLocation',
    name: 'KHS Gymnasium, University of Regina',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '3925 Goldenrod Loop (or 3737 Wascana Pkwy)',
      addressLocality: 'Regina',
      addressRegion: 'SK',
      postalCode: 'S4S 0A2',
      addressCountry: 'CA',
    },
  },
  organizer: { '@id': 'https://naacanada.org/#organization' },
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '20',
    highPrice: '35',
    priceCurrency: 'CAD',
    url: 'https://naacanada.org/programs/tournaments/badminton/national-smash-open-2027/',
  },
};
---

<Layout
  title="National Smash Open 2027 | Badminton Tournament | National Athletics Academy"
  description="National Smash Open 2027 — the ultimate one-day badminton showdown on 8 courts at KHS Gymnasium, University of Regina on Saturday, February 27, 2027. Youth & Adult divisions. Registration opens soon."
  schemaGraph={[eventSchema]}
>
  <Header />

  <!-- ═══════════════════════════════════════════════════════
       1. CHAMPIONSHIP HERO SECTION
  ════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#020b18] via-[#0B192C] to-[#5e0f13] text-white pt-36 pb-14 sm:pt-40 sm:pb-16 lg:pt-44 lg:pb-20 border-b border-white/10">
    <!-- Ambient Glows & Court Grid Pattern -->
    <div class="pointer-events-none absolute -top-40 -right-24 w-[480px] h-[480px] rounded-full bg-amber-400/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-24 w-[480px] h-[480px] rounded-full bg-[#83161B]/35 blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm text-white/70 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="text-white/40">&rsaquo;</span>
        <a href="/programs/" class="hover:text-white transition-colors">Programs</a>
        <span class="text-white/40">&rsaquo;</span>
        <a href="/programs/tournaments/" class="hover:text-white transition-colors">Tournaments</a>
        <span class="text-white/40">&rsaquo;</span>
        <a href="/programs/tournaments/badminton/" class="hover:text-white transition-colors">Badminton</a>
        <span class="text-white/40">&rsaquo;</span>
        <span class="text-amber-400 font-semibold">National Smash Open 2027</span>
      </nav>

      <!-- Hero Main Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left Column: Headlines & CTA -->
        <div class="lg:col-span-7">
          <div class="inline-flex flex-wrap items-center gap-2 bg-amber-400/15 border border-amber-400/40 rounded-full px-3.5 py-1.5 mb-5">
            <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span class="font-outfit font-bold text-xs sm:text-xs text-amber-300 tracking-wider uppercase">
              Independent Open Championship &bull; No Membership Required
            </span>
          </div>

          <p class="font-outfit font-bold text-xs sm:text-sm uppercase tracking-[0.18em] text-amber-400 mb-2">
            The Ultimate One-Day Showdown on 8 Courts
          </p>

          <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-[1.03] mb-4">
            NATIONAL SMASH <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-200">OPEN 2027</span>
          </h1>

          <p class="font-outfit font-bold text-xl sm:text-2xl text-white/95 mb-3">
            Bring Your Smash. Claim Your Glory.
          </p>

          <p class="text-slate-200 text-sm sm:text-base lg:text-lg leading-relaxed max-w-2xl mb-6">
            The most electric single-day badminton championship of 2027 is coming to Regina. Eight courts, twenty championship brackets across Youth (U11–U19) and Adult Open divisions, and non-stop competitive energy from first serve to match point.
          </p>

          <!-- Registration Opens Alert Box -->
          <div class="rounded-2xl bg-gradient-to-r from-amber-400/20 via-amber-400/10 to-transparent border border-amber-400/40 p-4 sm:p-5 mb-6 backdrop-blur-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <div class="inline-flex items-center gap-2 text-amber-300 font-outfit font-extrabold text-xs sm:text-sm uppercase tracking-wider">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Registration Opens Soon</span>
                </div>
                <p class="text-xs sm:text-sm text-white/85 mt-1">
                  Strict entry caps apply to all categories. First-come, first-served.
                </p>
              </div>
              <span class="self-start sm:self-center shrink-0 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400 text-slate-950">
                Opening Soon
              </span>
            </div>
          </div>

          <!-- Primary CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
            <button
              type="button"
              data-notify-btn
              data-program="National Smash Open 2027"
              class="btn btn-gold btn-lg w-full sm:w-auto justify-center text-center cursor-pointer shadow-lg shadow-amber-500/20"
            >
              <span>Secure Your Spot — Notify Me</span>
              <span aria-hidden="true">&rarr;</span>
            </button>
            <a
              href="#categories"
              class="btn btn-outline btn-lg w-full sm:w-auto justify-center text-center"
            >
              Explore 20 Brackets
            </a>
          </div>
        </div>

        <!-- Right Column: Action Visual & Live Countdown Card -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 bg-slate-950/70 shadow-2xl">
            <div class="relative h-64 sm:h-72 overflow-hidden">
              <img
                src="/images/programs/badminton-action-1.webp"
                alt="Badminton athlete hitting an overhead smash at National Smash Open"
                class="w-full h-full object-cover object-center scale-105"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#060E18] via-[#060E18]/40 to-transparent"></div>

              <!-- Top Floating Badge -->
              <div class="absolute top-4 left-4 right-4 flex items-center justify-between gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#83161B] text-white border border-white/20 shadow">
                  Sat, Feb 27, 2027
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-950/80 text-amber-300 border border-amber-400/30 backdrop-blur-md">
                  8:00 AM – 6:00 PM
                </span>
              </div>

              <!-- Bottom Overlay Title -->
              <div class="absolute bottom-3 left-5 right-5">
                <div class="text-xs font-semibold uppercase tracking-wider text-amber-300">Official Championship Venue</div>
                <div class="text-lg sm:text-xl font-bold text-white leading-snug">
                  KHS Gymnasium &bull; University of Regina
                </div>
              </div>
            </div>

            <!-- Countdown + Quick Spec Pills -->
            <div class="p-5 sm:p-6 bg-[#060E18]/95 border-t border-white/10">
              <div class="flex items-center justify-between text-xs text-slate-300 mb-3">
                <span id="smash-countdown-label" class="font-semibold uppercase tracking-wider text-amber-300">
                  Countdown to Game Day (Feb 27, 2027)
                </span>
                <span class="text-white/60 font-mono">CST</span>
              </div>

              <div class="grid grid-cols-4 gap-2 text-center mb-5" aria-label="Countdown timer">
                <div class="rounded-xl bg-white/5 border border-white/10 py-2.5 px-2">
                  <div id="cd-days" class="font-display font-black text-2xl sm:text-3xl text-white">--</div>
                  <div class="text-xs uppercase tracking-wider text-slate-400 mt-0.5">Days</div>
                </div>
                <div class="rounded-xl bg-white/5 border border-white/10 py-2.5 px-2">
                  <div id="cd-hours" class="font-display font-black text-2xl sm:text-3xl text-white">--</div>
                  <div class="text-xs uppercase tracking-wider text-slate-400 mt-0.5">Hours</div>
                </div>
                <div class="rounded-xl bg-white/5 border border-white/10 py-2.5 px-2">
                  <div id="cd-mins" class="font-display font-black text-2xl sm:text-3xl text-white">--</div>
                  <div class="text-xs uppercase tracking-wider text-slate-400 mt-0.5">Mins</div>
                </div>
                <div class="rounded-xl bg-white/5 border border-white/10 py-2.5 px-2">
                  <div id="cd-secs" class="font-display font-black text-2xl sm:text-3xl text-amber-400">--</div>
                  <div class="text-xs uppercase tracking-wider text-slate-400 mt-0.5">Secs</div>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-2 pt-3 border-t border-white/10 text-center">
                <div>
                  <div class="text-xs text-slate-400">Courts</div>
                  <div class="font-outfit font-extrabold text-sm sm:text-base text-white">8 Indoor</div>
                </div>
                <div class="border-x border-white/10">
                  <div class="text-xs text-slate-400">Divisions</div>
                  <div class="font-outfit font-extrabold text-sm sm:text-base text-amber-300">20 Brackets</div>
                </div>
                <div>
                  <div class="text-xs text-slate-400">Entry From</div>
                  <div class="font-outfit font-extrabold text-sm sm:text-base text-white">$20 CAD</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4-Card Key Specs Strip -->
      <div class="mt-8 sm:mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
        <div class="rounded-2xl bg-white/8 border border-white/15 p-4 sm:p-5 backdrop-blur-sm">
          <div class="text-xs font-outfit uppercase tracking-wider text-amber-300 font-bold">Date &amp; Time</div>
          <div class="text-base sm:text-lg font-extrabold text-white mt-1">Sat, Feb 27, 2027</div>
          <div class="text-xs text-white/75 mt-0.5">8:00 AM – 6:00 PM Sharp</div>
        </div>

        <div class="rounded-2xl bg-white/8 border border-white/15 p-4 sm:p-5 backdrop-blur-sm">
          <div class="text-xs font-outfit uppercase tracking-wider text-amber-300 font-bold">Venue &amp; Location</div>
          <div class="text-base sm:text-lg font-extrabold text-white mt-1">KHS Gymnasium, U of R</div>
          <div class="text-xs text-white/75 mt-0.5">3925 Goldenrod Loop (or 3737 Wascana Pkwy)</div>
        </div>

        <div class="rounded-2xl bg-white/8 border border-white/15 p-4 sm:p-5 backdrop-blur-sm">
          <div class="text-xs font-outfit uppercase tracking-wider text-amber-300 font-bold">Format &amp; Scale</div>
          <div class="text-base sm:text-lg font-extrabold text-white mt-1">8 Courts &middot; 20 Brackets</div>
          <div class="text-xs text-white/75 mt-0.5">Youth (U11–U19) &amp; Adult Open</div>
        </div>

        <div class="rounded-2xl bg-white/8 border border-white/15 p-4 sm:p-5 backdrop-blur-sm">
          <div class="text-xs font-outfit uppercase tracking-wider text-amber-300 font-bold">Sanction Status</div>
          <div class="text-base sm:text-lg font-extrabold text-white mt-1">Independent Open</div>
          <div class="text-xs text-white/75 mt-0.5">No Provincial/National Membership Needed</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       2. WHY NATIONAL SMASH OPEN 2027?
  ════════════════════════════════════════════════════════════ -->
  <section class="py-14 sm:py-20 bg-white" aria-labelledby="why-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Left Copy + Photo Mosaic -->
        <div class="lg:col-span-6 reveal">
          <span class="badge bg-[#83161B]/10 text-[#83161B] mb-3">Why National Smash Open 2027?</span>
          <h2 id="why-heading" class="gold-accent text-3xl sm:text-4xl font-extrabold text-[#0B192C] mb-4">
            One Venue. Eight Courts. Non-Stop Competitive Energy.
          </h2>
          <p class="text-slate-700 text-base sm:text-lg leading-relaxed mb-4">
            One venue. Eight courts. Non-stop competitive energy from first serve to match point.
          </p>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-4">
            National Smash Open 2027 brings together junior prodigies and adult competitors for an adrenaline-fueled championship day. Built with a streamlined, fast-paced match flow and capped draw sizes, every athlete gets intense court action without hours of waiting around.
          </p>
          <p class="text-slate-700 font-semibold text-sm sm:text-base leading-relaxed mb-6 border-l-4 border-amber-400 pl-4 py-1 bg-amber-50/60 rounded-r-lg">
            Whether you are fighting for junior bragging rights or the Adult Open crown, this is where your season’s hard work gets tested.
          </p>

          <!-- 2-Photo Mini Action Grid -->
          <div class="grid grid-cols-2 gap-3 sm:gap-4">
            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] shadow-md">
              <img
                src="/images/programs/badminton-action-2.webp"
                alt="High-speed badminton rally on indoor courts"
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-3 text-xs font-bold text-white">Fast-Paced Match Flow</span>
            </div>
            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] shadow-md">
              <img
                src="/images/programs/badminton-portrait-1.webp"
                alt="Junior badminton competitor ready to serve"
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-3 text-xs font-bold text-white">Youth &amp; Adult Crowns</span>
            </div>
          </div>
        </div>

        <!-- Right 5 Highlights Stack -->
        <div class="lg:col-span-6 reveal">
          <div class="rounded-3xl bg-slate-50 border border-slate-200/90 p-5 sm:p-8 shadow-sm">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200">
              <div>
                <span class="text-xs font-outfit font-bold uppercase tracking-wider text-[#83161B]">Championship Standard</span>
                <h3 class="text-xl sm:text-2xl font-extrabold text-[#0B192C]">What Sets This Event Apart</h3>
              </div>
              <div class="w-11 h-11 rounded-2xl bg-amber-400/20 text-amber-600 flex items-center justify-center font-bold text-xl shrink-0">
                🏆
              </div>
            </div>

            <div class="space-y-3.5">
              {highlights.map((item, idx) => (
                <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:border-amber-400 transition-colors">
                  <div class="w-9 h-9 rounded-xl bg-[#0B192C] text-amber-400 font-outfit font-extrabold text-sm flex items-center justify-center shrink-0 mt-0.5">
                    0{idx + 1}
                  </div>
                  <div>
                    <h4 class="font-outfit font-bold text-base text-[#0B192C]">{item.title}</h4>
                    <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       3. TOURNAMENT CATEGORIES (20 BRACKETS)
  ════════════════════════════════════════════════════════════ -->
  <section id="categories" class="py-14 sm:py-20 bg-slate-50 border-y border-slate-200" aria-labelledby="categories-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12 reveal">
        <span class="badge bg-[#021F47]/10 text-[#021F47] mb-3">20 Championship Brackets</span>
        <h2 id="categories-heading" class="gold-accent-center text-3xl sm:text-4xl font-extrabold text-[#0B192C] mb-3">
          Tournament Categories &amp; Divisions
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Both Singles and Doubles divisions are offered across every age group.
        </p>
      </div>

      <!-- Max 2 Events Rule Banner -->
      <div class="rounded-3xl bg-gradient-to-r from-[#0B192C] via-[#021F47] to-[#83161B] text-white p-6 sm:p-8 mb-8 sm:mb-10 shadow-xl reveal">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="max-w-xl">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400 text-slate-950 mb-2.5">
              Entry Rule &bull; Maximum 2 Events
            </span>
            <h3 class="text-xl sm:text-2xl font-extrabold text-white">
              Athletes May Enter a MAXIMUM of 2 Events
            </h3>
            <p class="text-xs sm:text-sm text-white/80 mt-1">
              Designed to keep court rotations moving cleanly and prevent scheduling conflicts.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 lg:w-[540px]">
            <div class="rounded-2xl bg-white/10 border border-white/15 p-4 backdrop-blur-sm">
              <div class="text-xs font-outfit font-bold uppercase tracking-wider text-amber-300">Youth Athletes</div>
              <div class="font-bold text-sm sm:text-base text-white mt-1">1 Singles + 1 Open Doubles</div>
              <div class="text-xs text-white/70 mt-1">Across U11, U13, U15, U17, or U19</div>
            </div>
            <div class="rounded-2xl bg-white/10 border border-white/15 p-4 backdrop-blur-sm">
              <div class="text-xs font-outfit font-bold uppercase tracking-wider text-amber-300">Adult Competitors</div>
