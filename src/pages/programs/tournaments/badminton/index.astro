---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';

// Continuous yearly NAA Badminton Championship Circuit:
// 1. Winter Edition (Every February — 1-Day Showdown)
// 2. Summer Edition (Every June — 2-Day Prestigious Championship)
const tournaments = [
  {
    edition: 'Annual Winter Championship · Edition I',
    season: 'Winter',
    year: 2027,
    name: 'National Smash Open 2027',
    tagline: 'Bring Your Smash. Claim Your Glory. · 1-Day Showdown',
    slug: 'national-smash-open-2027',
    status: 'Registration Opens Nov 15, 2026',
    statusTone: 'open',
    date: 'Saturday, February 27, 2027',
    scheduleLines: ['Saturday, Feb 27, 2027: 8:00 AM – 6:00 PM Sharp'],
    venue: 'KHS Gymnasium, University of Regina',
    address: '3925 Goldenrod Loop (or 3737 Wascana Pkwy), Regina, SK S4S 0A2',
    image: '/images/programs/badminton-action-1.webp',
    summary:
      'The ultimate one-day showdown on 8 courts. 20 championship brackets across Youth (U11–U19) and Adult Open divisions — fast-paced match flow, custom medals & trophies, and no provincial or national membership required.',
    notice: 'Official prospectus & online registration go live November 15, 2026.',
    facts: [
      '1-Day Showdown',
      '8 Courts · 20 Brackets',
      'Youth U11–U19 & Adult Open',
      'Singles & Doubles',
      'From $20 CAD / player',
    ],
    href: '/programs/tournaments/badminton/national-smash-open-2027/',
    startDateIso: '2027-02-27T08:00:00-06:00',
    endDateIso: '2027-02-27T18:00:00-06:00',
  },
  {
    edition: 'Annual Summer Grand Championship · Edition II',
    season: 'Summer',
    year: 2027,
    name: 'National Smash Summer Open 2027',
    tagline: '2-Day Prestigious Summer Championship on 8 Courts',
    slug: 'summer-2027',
    status: 'Registration Opens Mar 1, 2027',
    statusTone: 'upcoming',
    date: 'Saturday, June 19 – Sunday, June 20, 2027 (2 Days)',
    scheduleLines: [
      'Saturday, June 19, 2027: 8:00 AM – 7:30 PM',
      'Sunday, June 20, 2027: 8:00 AM – 6:00 PM',
    ],
    venue: 'KHS Gymnasium, University of Regina',
    address: '3925 Goldenrod Loop (or 3737 Wascana Pkwy), Regina, SK S4S 0A2',
    image: '/images/programs/badminton-action-2.webp',
    summary:
      'Our flagship two-day summer championship built as a premier, prestigious tournament destination for youth and adult competitors across the Prairies. Extended two-day championship format on 8 dedicated courts at the University of Regina.',
    notice:
      'Registration opens March 1, 2027. Full division prospectus, bracket structures & entry package will be published at registration launch.',
    facts: [
      '2-Day Championship',
      '8 Courts · KHS Gym',
      'Youth & Adult Divisions',
      'Prestigious Crown & Trophies',
      'Reg Opens Mar 1, 2027',
    ],
    href: null,
    startDateIso: '2027-06-19T08:00:00-06:00',
    endDateIso: '2027-06-20T18:00:00-06:00',
  },
];

const locationSchema = {
  '@type': 'SportsActivityLocation',
  name: 'KHS Gymnasium, University of Regina',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3925 Goldenrod Loop (or 3737 Wascana Pkwy)',
    addressLocality: 'Regina',
    addressRegion: 'SK',
    postalCode: 'S4S 0A2',
    addressCountry: 'CA',
  },
};

const eventsSchema = tournaments.map((t) => ({
  '@type': 'SportsEvent',
  name: t.name,
  description: t.summary,
  sport: 'Badminton',
  startDate: t.startDateIso,
  endDate: t.endDateIso,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: locationSchema,
  url: t.href ? `https://naacanada.org${t.href}` : 'https://naacanada.org/programs/tournaments/badminton/',
  organizer: { '@id': 'https://naacanada.org/#organization' },
}));
---

<Layout
  title="Badminton Tournaments | Annual Winter & Summer Championships | National Athletics Academy"
  description="NAA's continuous annual badminton championship circuit at KHS Gymnasium, University of Regina — Winter Championship (Feb 27, 2027) and 2-Day Summer Grand Championship (June 19–20, 2027)."
  schemaGraph={eventsSchema}
>
  <Header />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#020b18] via-[#0B192C] to-[#5e0f13] text-white pt-36 pb-14 sm:pt-40 sm:pb-16 lg:pt-44 lg:pb-20 border-b border-white/10">
    <div class="pointer-events-none absolute -top-36 -right-20 w-[440px] h-[440px] rounded-full bg-amber-400/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-36 -left-20 w-[440px] h-[440px] rounded-full bg-[#83161B]/35 blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm text-white/70 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="text-white/40">&rsaquo;</span>
        <a href="/programs/" class="hover:text-white transition-colors">Programs</a>
        <span class="text-white/40">&rsaquo;</span>
        <a href="/programs/tournaments/" class="hover:text-white transition-colors">Tournaments</a>
        <span class="text-white/40">&rsaquo;</span>
        <span class="text-amber-400 font-semibold">Badminton</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex flex-wrap items-center gap-2 bg-amber-400/15 border border-amber-400/35 rounded-full px-3.5 py-1.5 mb-5">
          <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="font-outfit font-bold text-xs text-amber-300 tracking-wider uppercase">
            🏸 Continuous Annual Championship Series &bull; Every Winter &amp; Summer
          </span>
        </div>

        <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-[1.05] mb-4">
          NAA Badminton <span class="text-amber-400">Championship Circuit</span>
        </h1>

        <p class="text-slate-200 text-base sm:text-lg leading-relaxed mb-8">
          Held continuously every year at the University of Regina's <strong class="text-white">KHS Gymnasium</strong>, NAA's prestigious two-event annual badminton circuit brings together youth prodigies and adult open competitors for a <strong class="text-amber-300">1-Day Winter Showdown</strong> in February and a flagship <strong class="text-amber-300">2-Day Summer Grand Championship</strong> in June.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="rounded-2xl bg-white/8 border border-white/15 p-3.5 sm:p-4">
            <div class="text-[11px] uppercase tracking-wider text-amber-300 font-bold">Annual Tradition</div>
            <div class="text-sm sm:text-base font-extrabold text-white mt-0.5">2 Yearly Majors</div>
          </div>
          <div class="rounded-2xl bg-white/8 border border-white/15 p-3.5 sm:p-4">
            <div class="text-[11px] uppercase tracking-wider text-amber-300 font-bold">Winter Showdown</div>
            <div class="text-sm sm:text-base font-extrabold text-white mt-0.5">Feb 27, 2027</div>
          </div>
          <div class="rounded-2xl bg-white/8 border border-white/15 p-3.5 sm:p-4">
            <div class="text-[11px] uppercase tracking-wider text-amber-300 font-bold">Summer 2-Day Open</div>
            <div class="text-sm sm:text-base font-extrabold text-white mt-0.5">June 19–20, 2027</div>
          </div>
          <div class="rounded-2xl bg-white/8 border border-white/15 p-3.5 sm:p-4">
            <div class="text-[11px] uppercase tracking-wider text-amber-300 font-bold">Host Arena</div>
            <div class="text-sm sm:text-base font-extrabold text-white mt-0.5">KHS Gym, U of R</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Winter & Summer Tournament Cards -->
  <section class="py-14 sm:py-20 bg-slate-50" aria-labelledby="events-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12 reveal">
        <span class="badge bg-[#83161B]/10 text-[#83161B] mb-3">Annual Recurring Circuit</span>
        <h2 id="events-heading" class="gold-accent-center text-3xl sm:text-4xl font-extrabold text-[#0B192C]">
          Winter &amp; Summer Championships
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-2">
          Both championships return every year at the University of Regina KHS Gymnasium, building a lasting competitive tradition across Saskatchewan.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {tournaments.map((t) => (
          <article class="bg-white rounded-3xl border border-slate-200 shadow-md overflow-hidden flex flex-col justify-between hover:shadow-xl transition-all reveal">
            <div>
              <!-- Image Header -->
              <div class="relative h-60 sm:h-68 overflow-hidden bg-[#0B192C]">
                <img
                  src={t.image}
                  alt={t.name}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0B192C] via-[#0B192C]/50 to-transparent"></div>

                <div class="absolute top-4 left-4 right-4 flex flex-wrap items-center justify-between gap-2">
                  <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#0B192C]/90 text-white border border-white/20 backdrop-blur-sm">
                    {t.season === 'Winter' ? '❄️' : '☀️'} {t.season} {t.year} &bull; Yearly Event
                  </span>
                  <span
                    class={`px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
                      t.statusTone === 'open'
                        ? 'bg-amber-400 text-slate-950 shadow'
                        : 'bg-[#83161B] text-amber-200 border border-amber-400/40 shadow'
                    }`}
                  >
                    {t.status}
                  </span>
                </div>

                <div class="absolute bottom-4 left-5 right-5">
                  <p class="text-[11px] sm:text-xs font-outfit font-bold uppercase tracking-wider text-amber-300">
                    {t.edition}
                  </p>
                  <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-0.5">{t.name}</h3>
                  <p class="text-xs sm:text-sm text-white/85 mt-0.5 font-medium">{t.tagline}</p>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-6 sm:p-8">
                <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-5">
                  {t.summary}
                </p>

                <!-- Structured Schedule & Venue Box -->
                <div class="rounded-2xl bg-slate-50 border border-slate-200/90 p-4 sm:p-5 space-y-3 text-xs sm:text-sm text-slate-700 mb-5">
                  <div class="flex items-start gap-3">
                    <span class="text-[#83161B] font-bold shrink-0 mt-0.5">📅 Dates:</span>
                    <span class="font-bold text-[#0B192C]">{t.date}</span>
                  </div>

                  <div class="flex items-start gap-3">
                    <span class="text-[#83161B] font-bold shrink-0 mt-0.5">⏰ Hours:</span>
                    <div class="space-y-1">
                      {t.scheduleLines.map((line) => (
                        <div class="font-semibold text-slate-800">{line}</div>
                      ))}
                    </div>
                  </div>

                  <div class="flex items-start gap-3">
                    <span class="text-[#83161B] font-bold shrink-0 mt-0.5">📍 Venue:</span>
                    <div>
                      <div class="font-bold text-[#0B192C]">{t.venue}</div>
                      <div class="text-xs text-slate-500">{t.address}</div>
                    </div>
                  </div>
                </div>

                <!-- Registration / Update Notice -->
                <div class="rounded-xl bg-amber-50/90 border border-amber-200/80 px-4 py-3 text-xs text-amber-950 font-medium mb-5">
                  <strong class="font-bold">📢 Registration Update:</strong> {t.notice}
                </div>

                {t.facts.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {t.facts.map((f) => (
                      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700">
                        {f}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>

            <div class="px-6 py-4 sm:px-8 sm:py-5 bg-slate-50 border-t border-slate-200">
              {t.href ? (
                <a href={t.href} class="btn btn-primary w-full justify-center text-center">
                  View Full Tournament Page &rarr;
                </a>
              ) : (
                <button
                  type="button"
                  class="btn btn-navy w-full justify-center text-center cursor-pointer"
                  data-notify-btn
                  data-program={`${t.name} (Opens March 1, 2027)`}
                >
                  Notify Me When Registration Opens (Mar 1, 2027) &rarr;
                </button>
              )}
            </div>
          </article>
        ))}
      </div>

      <!-- Continuous Yearly Tradition Banner -->
      <div class="mt-10 rounded-3xl bg-gradient-to-r from-[#0B192C] via-[#021F47] to-[#83161B] text-white p-6 sm:p-8 shadow-lg reveal">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div class="lg:col-span-8">
            <span class="inline-block px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-400 text-slate-950 mb-2.5">
              Prestigious Yearly Circuit
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-2">
              Two Continuous Annual Championships — Built for the Long Term
            </h3>
            <p class="text-sm sm:text-base text-white/85 leading-relaxed">
              Every Winter and every Summer, NAA brings athletes back to the 8 courts at the University of Regina's KHS Gymnasium. Whether competing in the high-intensity 1-day February showdown or the flagship 2-day June championship weekend, athletes can count on a permanent, prestigious tournament calendar year after year.
            </p>
          </div>
          <div class="lg:col-span-4 flex flex-col gap-3">
            <a href="/programs/tournaments/badminton/national-smash-open-2027/" class="btn btn-gold w-full justify-center text-center">
              Winter 2027 (Feb 27) &rarr;
            </a>
            <button
              type="button"
              data-notify-btn
              data-program="National Smash Summer Open 2027 (June 19–20, 2027)"
              class="btn btn-outline w-full justify-center text-center cursor-pointer"
            >
              Summer 2027 Priority List &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Contact CTA -->
  <section class="bg-gradient-to-r from-[#83161B] to-[#0B192C] text-white py-14 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-2">
        Questions About Our Annual Badminton Circuit?
      </h2>
      <p class="text-white/85 text-sm sm:text-base mb-6">
        Reach the NAA tournament desk for bracket eligibility, club entries, or championship sponsorship opportunities.
      </p>
      <div class="flex flex-col sm:flex-row gap-3.5 justify-center">
        <!--email_off-->
        <a href="mailto:info@naacanada.org?subject=Badminton%20Tournaments" class="btn btn-gold btn-lg w-full sm:w-auto justify-center">
          Email info@naacanada.org
        </a>
        <!--/email_off-->
        <a href="/programs/tournaments/" class="btn btn-outline btn-lg w-full sm:w-auto justify-center">
          All NAA Tournaments
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
