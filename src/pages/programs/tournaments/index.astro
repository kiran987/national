---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { activePrograms, comingSoonPrograms } from '../../../data/programs';

const program = comingSoonPrograms.find((p) => p.slug === 'tournaments')!;
const otherPrograms = activePrograms;
---

<Layout
  title={`${program.name} & Competition Series | National Athletics Academy Regina`}
  description={program.description}
>
  <Header />

  <!-- Hero Header -->
  <section class="page-hero" style="background:linear-gradient(160deg, #010f24 0%, #83161B 50%, #021F47 100%);padding:9.75rem 0 7.5rem;position:relative;overflow:hidden;">
    <div style="position:absolute;top:-40%;right:-10%;width:550px;height:550px;background:radial-gradient(circle,rgba(221,170,64,0.18) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>
    <div style="position:absolute;bottom:-30%;left:-5%;width:450px;height:450px;background:radial-gradient(circle,rgba(131,22,27,0.25) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>

    <div class="container-naa" style="position:relative;z-index:2;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:0.5rem;font-size:0.82rem;color:rgba(255,255,255,0.65);margin-bottom:1.5rem;">
        <a href="/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Home</a>
        <span>&rsaquo;</span>
        <a href="/programs/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Programs</a>
        <span>&rsaquo;</span>
        <span style="color:var(--color-naa-gold);font-weight:600;">{program.name}</span>
      </nav>

      <div style="max-width:840px;">
        <div style="display:inline-flex;align-items:center;gap:0.6rem;background:rgba(221,170,64,0.15);border:1px solid rgba(221,170,64,0.35);border-radius:9999px;padding:0.4rem 1.1rem;margin-bottom:1.25rem;">
          <span style="font-size:1.1rem;">{program.emoji}</span>
          <span style="font-family:var(--font-outfit);font-weight:700;font-size:0.8rem;color:var(--color-naa-gold);letter-spacing:0.06em;text-transform:uppercase;">
            Program 06 · {program.badge}
          </span>
        </div>

        <h1 style="font-size:clamp(2.2rem,4.5vw,3.5rem);font-weight:900;color:white;line-height:1.1;margin-bottom:1rem;letter-spacing:-0.01em;">
          {program.name} &amp; Competition Series
        </h1>

        <p style="font-size:1.25rem;color:var(--color-naa-gold);font-family:var(--font-outfit);font-weight:600;margin-bottom:1rem;">
          {program.subtitle}
        </p>

        <p style="font-size:1.05rem;color:rgba(255,255,255,0.85);line-height:1.75;margin-bottom:2rem;max-width:720px;">
          {program.description}
        </p>

        <!-- Quick Specs Strip -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:1.25rem 1.5rem;margin-bottom:2rem;">
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Divisions</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">Youth, Juniors &amp; Open</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Officials</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">Certified Referees</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Digital Sync</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">Full Digital Feed</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Guarantee</div>
            <div style="font-size:0.95rem;font-weight:700;color:var(--color-naa-gold);margin-top:0.25rem;">3-Game Minimum</div>
          </div>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
          <button type="button" class="btn btn-gold btn-lg" data-notify-btn data-program="Tournaments & Showcases" style="cursor:pointer;">
            Notify Me When Tournaments Open &rarr;
          </button>
          <a href="/programs/enquiry/" class="btn btn-outline btn-lg">
            Inquire &amp; Contact Desk
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Overview Section -->
  <section class="section-padding" style="background:#ffffff;" aria-labelledby="overview-heading">
    <div class="container-naa">
      <div class="naa-overview-split">
        <div class="reveal">
          <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">Competitive Standards</span>
          <h2 id="overview-heading" class="gold-accent" style="font-size:clamp(1.75rem,3vw,2.4rem);margin-bottom:1.25rem;">
            Where Character Meets Competition
          </h2>
          <p style="color:#374151;font-size:1.02rem;line-height:1.8;margin-bottom:1.5rem;">
            {program.longDescription}
          </p>
          <p style="color:#4b5563;font-size:0.95rem;line-height:1.75;margin-bottom:2rem;">
            Every tournament fixture features certified referees, electronic scoreboards, real-time live digital scorekeeping, awards ceremonies, and strict adherence to the Sask Sport Respect in Sport code of conduct.
          </p>

          <h3 style="font-family:var(--font-outfit);font-size:1.15rem;color:var(--color-naa-navy);margin-bottom:1rem;">
            Key Tournament Pillars:
          </h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0.75rem;">
            {program.skillsFocus.map((skill) => (
              <div style="display:flex;align-items:flex-start;gap:0.65rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:0.75rem 1rem;">
                <span style="color:var(--color-naa-maroon);font-weight:800;font-size:1rem;">✓</span>
                <span style="font-size:0.88rem;color:#1e293b;font-weight:500;">{skill}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Highlights Card -->
        <div class="card reveal" style="padding:2.5rem 2rem;background:linear-gradient(145deg, #f8fafc 0%, #ffffff 100%);border:1px solid #e2e8f0;border-top:5px solid var(--color-naa-maroon);">
          <div style="width:44px;height:44px;margin-bottom:0.75rem;border-radius:10px;background:rgba(221,170,64,0.15);display:flex;align-items:center;justify-content:center;color:var(--color-naa-gold);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
          </div>
          <h3 style="font-family:var(--font-outfit);font-size:1.25rem;color:var(--color-naa-navy);margin-bottom:1.25rem;">
            Tournament Operations &amp; Standards
          </h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:1rem;margin-bottom:2rem;">
            {program.highlights.map((item) => (
              <li style="display:flex;align-items:flex-start;gap:0.75rem;font-size:0.9rem;color:#334155;line-height:1.6;">
                <span style="color:var(--color-naa-gold);font-weight:900;font-size:1rem;flex-shrink:0;">★</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div style="background:rgba(131,22,27,0.05);border-radius:12px;padding:1.25rem;border-left:4px solid var(--color-naa-maroon);">
            <div style="font-size:0.8rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-maroon);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.25rem;">
              Venues
            </div>
            <p style="font-size:0.85rem;color:#475569;line-height:1.5;">
              {program.venue}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming Tournaments -->
  <section class="section-padding" style="background:#ffffff;border-top:1px solid #e2e8f0;" aria-labelledby="upcoming-heading">
    <div class="container-naa">
      <div class="reveal" style="margin-bottom:2rem;">
        <span class="badge" style="background:rgba(221,170,64,0.18);color:#926508;margin-bottom:0.75rem;">Upcoming Tournaments</span>
        <h2 id="upcoming-heading" style="font-size:clamp(1.6rem,3vw,2.2rem);color:var(--color-naa-navy);">Featured Events</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem;">
        <a href="/programs/tournaments/badminton/national-smash-open-2027/" class="card reveal" style="display:block;padding:2rem;text-decoration:none;border-left:5px solid var(--color-naa-maroon);">
          <div style="display:flex;flex-direction:column;gap:0.6rem;">
            <div style="font-size:0.8rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-maroon);text-transform:uppercase;letter-spacing:0.05em;">🏸 Winter Championship &bull; Sat, Feb 27, 2027 (8:00 AM – 6:00 PM)</div>
            <h3 style="font-size:1.45rem;color:var(--color-naa-navy);margin:0;">National Smash Open 2027</h3>
            <p style="font-size:0.9rem;color:#475569;margin:0;line-height:1.6;">1-Day Open Championship &bull; 8 Courts &bull; 20 Brackets &bull; Youth (U11–U19) &amp; Adult Open. Registration opens Nov 15, 2026.</p>
            <p style="font-size:0.84rem;color:#1e293b;margin:0;font-weight:600;">📍 Venue: KHS Gymnasium, University of Regina — 3925 Goldenrod Loop (or 3737 Wascana Pkwy), Regina, SK S4S 0A2</p>
            <span style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-maroon);margin-top:0.25rem;">View Winter Tournament Details &rarr;</span>
          </div>
        </a>

        <a href="/programs/tournaments/badminton/" class="card reveal" style="display:block;padding:2rem;text-decoration:none;border-left:5px solid var(--color-naa-gold);">
          <div style="display:flex;flex-direction:column;gap:0.6rem;">
            <div style="font-size:0.8rem;font-family:var(--font-outfit);font-weight:700;color:#926508;text-transform:uppercase;letter-spacing:0.05em;">☀️ Summer 2-Day Championship &bull; June 19–20, 2027</div>
            <h3 style="font-size:1.45rem;color:var(--color-naa-navy);margin:0;">National Smash Summer Open 2027</h3>
            <p style="font-size:0.9rem;color:#475569;margin:0;line-height:1.6;">2-Day Prestigious Championship (Sat 8:00 AM–7:30 PM &middot; Sun 8:00 AM–6:00 PM). Registration opens March 1, 2027.</p>
            <p style="font-size:0.84rem;color:#1e293b;margin:0;font-weight:600;">📍 Venue: KHS Gymnasium, University of Regina — 3925 Goldenrod Loop (or 3737 Wascana Pkwy), Regina, SK S4S 0A2</p>
            <span style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);margin-top:0.25rem;">View Annual Badminton Circuit &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>


  <!-- Featured Tournament Series -->
  <section class="section-padding" style="background:#f8fafc;" aria-labelledby="series-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3.5rem;">
        <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:1rem;">Seasonal Series</span>
        <h2 id="series-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.6rem);margin-bottom:1rem;">
          Signature Tournament Series in Regina
        </h2>
        <p style="color:#4b5563;font-size:1.02rem;max-width:640px;margin:0 auto;line-height:1.7;">
          Open to club teams, school programs, community squads, and individual free-agent players.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:2rem;">
        <!-- Badminton: National Smash Open 2027 (registration opens Nov 15, 2026) -->
        <div class="card reveal" style="display:flex;flex-direction:column;border-top:4px solid var(--color-naa-gold);">
          <div style="padding:2rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
              <span class="badge" style="background:rgba(221,170,64,0.15);color:#926508;font-size:0.75rem;font-weight:700;">BADMINTON</span>
              <span style="font-size:0.85rem;font-weight:700;color:var(--color-naa-navy);font-family:var(--font-outfit);text-align:right;">Youth U11–U19 &amp; Adult Open</span>
            </div>

            <h3 style="font-size:1.3rem;color:var(--color-naa-navy);margin-bottom:0.5rem;">Badminton Tournaments</h3>

            <p style="font-size:0.85rem;color:#64748b;font-weight:600;font-family:var(--font-outfit);margin-bottom:1rem;">
              Winter &amp; Summer &bull; 2 Open Championships Every Year
            </p>

            <p style="font-size:0.9rem;color:#334155;line-height:1.65;margin-bottom:1.5rem;">
              Continuous yearly badminton championship circuit on 8 courts at KHS Gymnasium (University of Regina) — featuring our 1-Day Winter Showdown and 2-Day Summer Grand Championship.
            </p>

            <div style="border-top:1px solid #e2e8f0;padding-top:1.25rem;">
              <div style="font-size:0.78rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem;">
                Annual Circuit Schedule &amp; Highlights
              </div>
              <ul style="list-style:none;display:flex;flex-direction:column;gap:0.6rem;padding:0;margin:0;">
                <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.85rem;color:#475569;line-height:1.5;"><span style="color:var(--color-naa-maroon);font-weight:700;">&bull;</span><span><strong>Winter (1-Day):</strong> National Smash Open &mdash; Sat, Feb 27, 2027 (Reg opens Nov 15, 2026)</span></li>
                <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.85rem;color:#475569;line-height:1.5;"><span style="color:var(--color-naa-maroon);font-weight:700;">&bull;</span><span><strong>Summer (2-Day):</strong> Summer Grand Open &mdash; June 19&ndash;20, 2027 (Reg opens Mar 1, 2027)</span></li>
                <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.85rem;color:#475569;line-height:1.5;"><span style="color:var(--color-naa-maroon);font-weight:700;">&bull;</span><span>KHS Gymnasium, U of R &bull; Youth (U11&ndash;U19) &amp; Adult Open</span></li>
              </ul>
            </div>
          </div>

          <div style="margin-top:auto;padding:1.25rem 2rem;background:#f8fafc;border-top:1px solid #e2e8f0;display:flex;flex-direction:column;gap:0.5rem;">
            <a href="/programs/tournaments/badminton/" class="btn btn-navy btn-sm" style="width:100%;justify-content:center;">
              View Badminton Tournaments &rarr;
            </a>
          </div>
        </div>

        {program.tiers.map((tier, i) => (
          <div class="card reveal" style={`animation-delay:${i * 120}ms;display:flex;flex-direction:column;border-top:4px solid ${i === 0 ? 'var(--color-naa-maroon)' : i === 1 ? 'var(--color-naa-navy)' : i === 2 ? '#059669' : 'var(--color-naa-gold)'};`}>
            <div style="padding:2rem;">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
                <span class="badge" style="background:rgba(221,170,64,0.15);color:#926508;font-size:0.75rem;font-weight:700;">
                  {tier.badge}
                </span>
                <span style="font-size:0.85rem;font-weight:700;color:var(--color-naa-navy);font-family:var(--font-outfit);">
                  {tier.ages}
                </span>
              </div>

              <h3 style="font-size:1.3rem;color:var(--color-naa-navy);margin-bottom:0.5rem;">
                {tier.name}
              </h3>

              <p style="font-size:0.85rem;color:#64748b;font-weight:600;font-family:var(--font-outfit);margin-bottom:1rem;">
                {tier.format} &bull; {tier.ratio}
              </p>

              <p style="font-size:0.9rem;color:#334155;line-height:1.65;margin-bottom:1.5rem;">
                {tier.focus}
              </p>

              <div style="border-top:1px solid #e2e8f0;padding-top:1.25rem;">
                <div style="font-size:0.78rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem;">
                  Tournament Details &amp; Highlights
                </div>
                <ul style="list-style:none;display:flex;flex-direction:column;gap:0.6rem;">
                  {tier.curriculum.map((c) => (
                    <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.85rem;color:#475569;line-height:1.5;">
                      <span style="color:var(--color-naa-maroon);font-weight:700;">&bull;</span>
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div style="margin-top:auto;padding:1.25rem 2rem;background:#f8fafc;border-top:1px solid #e2e8f0;">
              <button type="button" class="btn btn-navy btn-sm" data-notify-btn data-program={tier.name} style="width:100%;justify-content:center;cursor:pointer;">
                Notify Me When Open &rarr;
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's Included Card -->
  <section class="section-padding" style="background:#ffffff;" aria-labelledby="included-heading">
    <div class="container-naa">
      <div class="naa-feature-banner" style="background:linear-gradient(135deg,var(--color-naa-navy) 0%,#83161B 100%);color:white;">
        <div class="naa-report-split">
          <div>
            <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1rem;">
              Team &amp; Free Agent Entry
            </span>
            <h2 id="included-heading" style="font-size:clamp(1.75rem,3vw,2.4rem);color:white;margin-bottom:1rem;">
              Turnkey Tournament Experience
            </h2>
            <p style="color:rgba(255,255,255,0.85);font-size:1rem;line-height:1.75;margin-bottom:1.5rem;">
              NAA handles all facility bookings, certified officiating crews, scorekeepers, awards, and live schedule management. Whether registering a complete club roster or entering as an individual free agent, your team is guaranteed a professional sporting event.
            </p>
            <div style="display:flex;gap:1.5rem;flex-wrap:wrap;">
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> 3-Game guarantee minimum
              </div>
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> Certified referee crews
              </div>
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> Championship awards &amp; medals
              </div>
            </div>
          </div>

          <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:18px;padding:2rem;">
            <div style="font-family:var(--font-outfit);font-size:1.1rem;font-weight:700;color:var(--color-naa-gold);margin-bottom:1rem;">
              What's Included in Entry:
            </div>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;">
              {program.whatsIncluded.map((item) => (
                <li style="display:flex;align-items:flex-start;gap:0.65rem;font-size:0.88rem;color:rgba(255,255,255,0.85);line-height:1.6;">
                  <span style="color:var(--color-naa-gold);font-weight:700;">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section-padding" style="background:#f8fafc;" aria-labelledby="faq-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:1rem;">Have Questions?</span>
        <h2 id="faq-heading" class="gold-accent-center" style="font-size:clamp(1.75rem,3vw,2.4rem);margin-bottom:1rem;">
          Tournaments &amp; Competitions FAQs
        </h2>
      </div>

      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:1.25rem;">
        {program.faqs.map((faq) => (
          <div class="card reveal" style="padding:1.75rem 2rem;">
            <h3 style="font-family:var(--font-outfit);font-size:1.05rem;color:var(--color-naa-navy);margin-bottom:0.75rem;">
              {faq.question}
            </h3>
            <p style="color:#4b5563;font-size:0.92rem;line-height:1.7;">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Other Programs Navigation Strip -->
  <section class="section-padding" style="background:#ffffff;border-top:1px solid #e2e8f0;" aria-label="Explore other programs">
    <div class="container-naa">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;">
        <div>
          <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:0.5rem;">Multi-Sport Academy</span>
          <h2 style="font-size:1.5rem;color:var(--color-naa-navy);">Explore More NAA Sports</h2>
        </div>
        <a href="/programs/" style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-maroon);text-decoration:underline;font-size:0.9rem;">
          View All 6 Programs &rarr;
        </a>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;">
        {otherPrograms.map((op) => (
          <a
            href={`/programs/${op.slug}/`}
            class="card"
            style="padding:1.25rem;text-decoration:none;display:flex;flex-direction:column;gap:0.5rem;border-left:4px solid var(--color-naa-navy);transition:all 0.2s;"
          >
            <div style="font-size:1.5rem;">{op.emoji}</div>
            <div style="font-family:var(--font-outfit);font-weight:700;font-size:0.95rem;color:var(--color-naa-navy);line-height:1.2;">
              {op.name}
            </div>
            <div style="font-size:0.75rem;color:#64748b;">{op.ages}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section style="background:var(--color-naa-maroon);color:white;padding:4.5rem 0;text-align:center;">
    <div class="container-naa">
      <div class="reveal">
        <h2 style="font-size:clamp(1.8rem,3.5vw,2.5rem);font-weight:800;color:white;margin-bottom:1rem;">
          Get Notified for Upcoming Showcases &amp; Tournaments
        </h2>
        <p style="color:rgba(255,255,255,0.85);max-width:560px;margin:0 auto 2rem;line-height:1.7;">
          Tournaments fill quickly. Get on the early access notification list to secure a spot for your squad or player as soon as registration opens!
        </p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <button type="button" class="btn btn-gold btn-lg" data-notify-btn data-program="Tournaments & Showcases" style="cursor:pointer;">Get Notified When Tournaments Open &rarr;</button>
          <a href="/programs/enquiry/" class="btn btn-outline btn-lg">Contact Tournament Desk</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
