---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { activePrograms } from '../../../data/programs';

const program = activePrograms.find((p) => p.slug === 'badminton')!;
const otherPrograms = activePrograms.filter((p) => p.slug !== 'badminton');

const priceOf = (t: any) => {
  const m = /\$(\d+)/.exec(`${t.badge ?? ''} ${t.format ?? ''}`);
  return m ? '$' + m[1] : '';
};
const withoutPrice = (s: string) => (s || '').replace(/\s*[·•]\s*\$\d+\s*CAD/gi, '');

const curriculumMatrix = [
  {
    week: 1,
    theme: 'Grip & Racket Readiness',
    kids: {
      points: [
        'Shake-hands grip ("V-shape")',
        'Pancake grip correction',
        'Birdie balance challenges & ready stance',
      ],
      drill: '“Shake hands with the racket”, shuttle juggling contest (forehand/backhand alternations), and red-light-green-light ready position.',
      game: 'Racket Balance Relay (running down the court while balancing a birdie on the strings).',
    },
    teens: {
      points: [
        'Forehand vs. Backhand bevel grips',
        'Split-step timing & posture',
        'Dynamic reaction drills off feed',
      ],
      drill: 'Instant grip switching (forehand clear grip → backhand thumb-press grip). Wall rebound test for grip looseness.',
      game: 'Feeder rapid-fire split-step reaction drill (coach feeds unpredictably to left/right body).',
    },
  },
  {
    week: 2,
    theme: 'Underhand Serving & Low Net Play',
    kids: {
      points: [
        'High underhand tee serve',
        'Target hoop scoring in service boxes',
        'Net taps and underhand scoop lifts',
      ],
      drill: '“Rocket Launch” high underhand serves targeting colored cones at the back baseline.',
      game: 'Battleship (placing hoops in the receiver\'s court; hitting inside a hoop sinks a ship).',
    },
    teens: {
      points: [
        'Low backhand flick vs. short drive serve',
        'Deceptive service variations',
        'Push return mechanics to vulnerable zones',
      ],
      drill: 'Low backhand serve consistency (shuttle skimming ≤ 2 inches over tape). 3rd-shot drive and net kill patterns.',
      game: '3-Shot Rally Battle: If the receiver cannot attack the serve, the server earns a bonus point.',
    },
  },
  {
    week: 3,
    theme: 'Footwork & Court Navigation',
    kids: {
      points: [
        'Lateral shuffle & 2-foot hop jumps',
        '“Floor is Lava” court boundary games',
        'Quick recover to the center “T”',
      ],
      drill: 'Agility ladder footwork, bunny hops over foam lines, lunging to grab a birdie off the net tape and sprint back to base.',
      game: 'Hungry Hippos (running to the net, scooping up one birdie with the racket, and depositing it back into their home hoop).',
    },
    teens: {
      points: [
        '6-Corner footwork cadence (split → push → recover)',
        'Forward lunges & push-off recovery',
        'Chassé footwork to rear court',
      ],
      drill: '6-corner timed shadow drills. Focusing on the plant-and-push heel-to-toe lunge on the front forehand/backhand.',
      game: 'Shadow Ghosting Challenge: Coach points to corners at random; players sprint/shadow-hit with laser timing gates.',
    },
  },
  {
    week: 4,
    theme: 'High Overhead Clears',
    kids: {
      points: [
        'Scissor-throw throwing motion',
        'Reaching for the high “12 o\'clock” contact point',
        'Sky-ball rally games',
      ],
      drill: 'Throwing tennis balls or foam javelins over the net to learn hip rotation and high release. Hitting high lobs over the net.',
      game: 'Sky Ball (rallies where the shuttle must fly higher than the basketball backboards).',
    },
    teens: {
      points: [
        'Forehand attacking clear vs. defensive high clear',
        'Scissor-kick transition in rear court',
        'Deep-court court coverage & body uncoiling',
      ],
      drill: 'Baseline-to-baseline clear exchanges. Scissor-kick transition off the rear right foot.',
      game: 'Line-Target Game: Hitting clears landing exclusively between the doubles long service line and baseline.',
    },
  },
  {
    week: 5,
    theme: 'Drop Shots & Net Control',
    kids: {
      points: [
        'Gentle push drops over the tape',
        'Soft hands drill with foam shuttles',
        'Catch & hit relay games at the net',
      ],
      drill: 'Gentle net taps; catching a shuttle on the racket face without it bouncing.',
      game: '“Drop the Bomb” (softly tapping over the net into laundry baskets set directly along the T).',
    },
    teens: {
      points: [
        'Slow slice drops vs. fast disguised cut drops',
        'Tight tumbling net spin shots',
        'Net kill reaction & brush technique',
      ],
      drill: 'Slicing drops from the deep court; spinning net tumbles off the lunge; hair-pin net shots.',
      game: 'Narrow Court Cat-and-Mouse (playing exclusively inside the short service line and net zone).',
    },
  },
  {
    week: 6,
    theme: 'Drive Shots & Mid-Court Speed',
    kids: {
      points: [
        'Rapid-fire mid-court taps against wall/partner',
        'Side-to-side reaction games',
        '“Speed alley” team rallies',
      ],
      drill: 'Short-distance wall volleys; forehand and backhand flat slap drills with coaches.',
      game: 'Fast-Paced Dodge-Rally: Pairs keep a shuttle alive at mid-court without letting it rise above shoulder height.',
    },
    teens: {
      points: [
        'Flat flat-trajectory driving battles',
        'Transitioning from defense to attack',
        'Counter-attacking mid-court lifts',
      ],
      drill: 'Side-by-side drive battles (2 vs 2 flat fast-paced exchanges down the tramlines). Thumb-press backhand punch drives.',
      game: '“Speed Trap”: First team to reach a 20-shot continuous flat rally without an overhead clear earns match points.',
    },
  },
  {
    week: 7,
    theme: 'Smash Defense & Attack',
    kids: {
      points: [
        '“Defend the Castle” block drills',
        'Fun jumping overhead swat games',
        'Safe distance and racket-up positioning',
      ],
      drill: 'The “Monster Swat” (jumping to hit high floating feeds downward safely). Defending soft coach lobs using high shield blocks.',
      game: 'Shield Protectors: One child tries to swat downward into a target zone; two defenders try to pop it back up.',
    },
    teens: {
      points: [
        'Jump smash mechanics & steep downward angle',
        'Full-body pronation and snap',
        'Defensive blocks: short lift vs. cross-court drop',
      ],
      drill: 'Jump smash mechanics (approach, explosive vertical hop, wrist snap, steep trajectory). Smash defense (short block into net vs. drive counter).',
      game: 'Attack vs. Defense Gauntlet: Attacking pair smashes continuously; defending pair gets 2 points for every clean cross-court net return.',
    },
  },
  {
    week: 8,
    theme: 'Rally Patterns & Doubles Systems',
    kids: {
      points: [
        'Cooperative rally counting',
        'Court boundary awareness',
        'Serve-and-return confidence',
      ],
      drill: 'Partner rally patterns: keep the birdie alive for 10 hits, then serve and return from the correct service box.',
      game: '“Keep It Up”: Pairs work together to beat their own rally record on a shared scoreboard.',
    },
    teens: {
      points: [
        'Doubles rotation (front/back vs. side-by-side)',
        'Communication calls and court cover',
        'Switching between attack and defense formations',
      ],
      drill: 'Doubles movement system with called rotations; coach feeds force pairs to switch formation on every change of lift.',
      game: 'Rotation Relay: Pairs earn points for clean formation switches without leaving a gap.',
    },
  },
  {
    week: 9,
    theme: 'Review, Tactics & Match Prep',
    kids: {
      points: [
        'Skills circuit: grip, serve, drop, swat',
        'Personal-best challenges',
        'Sportsmanship and etiquette',
      ],
      drill: 'Rotating skills circuit where every athlete tries to beat their own best score at each station.',
      game: 'Personal Best Bingo: Complete a card of skill challenges to earn stickers ahead of the Jamboree.',
    },
    teens: {
      points: [
        'Serve and 3rd-shot patterns under pressure',
        'Shot selection and rally construction',
        'Ladder matchplay and reflection',
      ],
      drill: 'Pressure serves with a scripted 3rd-shot target, followed by short ladder matches with coach debriefs.',
      game: 'Challenge Ladder: Win to move up a court; losers reset with a new partner.',
    },
  },
  {
    week: 10,
    theme: 'Match Play & Mini-Tournament',
    kids: {
      points: [
        '“King of the Court” rally challenges',
        'Basic scoring & sportsmanship ribbons',
        'Fun coach-vs-kids showcase',
      ],
      drill: 'Reviewing in/out boundary lines, proper handshake etiquette, and simple counting (1, 2, 3).',
      game: 'Jamboree Mini-Meet: 5-minute timed rounds with rotating partners. Every player leaves with an achievement certificate.',
    },
    teens: {
      points: [
        'Doubles rotation (front/back vs. side-by-side)',
        'Round-robin sudden-death tournament (to 11 pts)',
        'Individual skill evaluation & feedback cards',
      ],
      drill: 'Doubles movement system (Attacking = Front & Back; Defending = Side-by-Side). Match strategy debriefs.',
      game: 'Sudden-Death Grudge Cup: 11-point games with real refereeing, scoring, and performance evaluation sheets.',
    },
  },
];
const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": program.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};

const sportsActivityLocationSchema = {
  "@type": "SportsActivityLocation",
  "@id": "https://naacanada.org/programs/badminton/#location",
  "name": "NAA Badminton Gymnasium - Green Gym, Centre for Kinesiology and Health Studies",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "3737 Wascana Parkway",
    "addressLocality": "Regina",
    "addressRegion": "SK",
    "postalCode": "S4S 0A2",
    "addressCountry": "CA"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 50.4185,
    "longitude": -104.5889
  }
};

const sportsEventSchema = {
  "@type": "SportsEvent",
  "name": "National Smash - Badminton — Winter 2027 Season",
  "description": program.description,
  "startDate": "2027-01-26T18:00:00-06:00",
  "endDate": "2027-03-11T19:30:00-06:00",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": sportsActivityLocationSchema,
  "organizer": {
    "@id": "https://naacanada.org/#organization"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "150",
    "highPrice": "295",
    "priceCurrency": "CAD",
    "availability": "https://schema.org/InStock",
    "url": "https://naacanada.org/programs/badminton/"
  }
};
---

<Layout
  title="Kids Badminton Lessons & Training in Regina, SK | National Smash"
  description="Regina's premier youth badminton academy for kids and teens. Professional coaching, footwork drills, and court play in Regina, SK."
  schemaGraph={[faqSchema, sportsActivityLocationSchema, sportsEventSchema]}
>
  <Header />

  <!-- Hero Header -->
  <section class="page-hero" style="background:linear-gradient(160deg, #010f24 0%, #021F47 60%, #0a3a7a 100%);padding:9.75rem 0 7.5rem;position:relative;overflow:hidden;">
    <div style="position:absolute;top:-40%;right:-10%;width:550px;height:550px;background:radial-gradient(circle,rgba(221,170,64,0.14) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>
    <div style="position:absolute;bottom:-30%;left:-5%;width:450px;height:450px;background:radial-gradient(circle,rgba(2,31,71,0.3) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>

    <div class="container-naa" style="position:relative;z-index:2;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:0.5rem;font-size:0.82rem;color:rgba(255,255,255,0.65);margin-bottom:1.5rem;">
        <a href="/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Home</a>
        <span>&rsaquo;</span>
        <a href="/programs/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Programs</a>
        <span>&rsaquo;</span>
        <span style="color:var(--color-naa-gold);font-weight:600;">{program.name}</span>
      </nav>

      <div style="max-width:840px;">
        <div style="display:inline-flex;align-items:center;gap:0.6rem;background:rgba(221,170,64,0.15);border:1px solid rgba(221,170,64,0.35);border-radius:9999px;padding:0.4rem 1.1rem;margin-bottom:1.25rem;">
          <span style="font-family:var(--font-outfit);font-weight:700;font-size:0.8rem;color:var(--color-naa-gold);letter-spacing:0.06em;text-transform:uppercase;">
            Program 0{program.order} &bull; {program.badge}
          </span>
        </div>

        <h1 style="font-size:clamp(2.2rem,4.5vw,3.5rem);font-weight:900;color:white;line-height:1.1;margin-bottom:1rem;letter-spacing:-0.01em;">
          {program.name}
        </h1>

        <p style="font-size:1.25rem;color:var(--color-naa-gold);font-family:var(--font-outfit);font-weight:600;margin-bottom:1rem;">
          {program.subtitle}
        </p>

        <p style="font-size:1.05rem;color:rgba(255,255,255,0.85);line-height:1.75;margin-bottom:2rem;max-width:720px;">
          {program.description}
        </p>

        <!-- Quick Specs Strip -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;overflow:hidden;">
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Age Groups</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">{program.ages.split('(')[0]}</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Coach Ratio</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">1:8 to 1:15 Max</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Schedule &amp; Duration</div>
            <div style="font-size:0.88rem;font-weight:700;color:white;margin-top:0.25rem;">10 sessions &middot; 45-min batches</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Tuition Fees</div>
            <div style="font-size:0.92rem;font-weight:700;color:var(--color-naa-gold);margin-top:0.25rem;white-space:nowrap;">$150 &ndash; $295 CAD</div>
          </div>
        </div>

        <!-- Winter 2027 Program Banner -->
        <div style="background:rgba(255,255,255,0.08);border:1px solid rgba(221,170,64,0.35);border-radius:14px;padding:1.25rem 1.5rem;margin-bottom:2rem;display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <span style="display:inline-block;padding:0.25rem 0.65rem;border-radius:6px;background:rgba(221,170,64,0.2);color:var(--color-naa-gold);font-weight:800;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;border:1px solid rgba(221,170,64,0.5);">Registration Open</span>
              <div>
                <div style="font-family:var(--font-outfit);font-weight:800;font-size:0.9rem;color:white;text-transform:uppercase;letter-spacing:0.07em;">Winter 2027 Program &bull; University of Regina Green Gym</div>
                <div style="font-size:0.8rem;color:rgba(255,255,255,0.85);margin-top:0.2rem;">Centre for Kinesiology and Health Studies, 3737 Wascana Parkway &bull; Jan 26 &ndash; Mar 11, 2027</div>
              </div>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0.75rem;">
            <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:0.85rem 1rem;">
              <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.25rem;">Batch 1 &middot; 6:00 &ndash; 6:45 PM</div>
              <div style="font-size:0.8rem;font-weight:700;color:white;margin-bottom:0.25rem;">Smash Juniors &amp; Smash Elite</div>
              <div style="font-size:0.85rem;color:white;">Tuesdays &amp; Thursdays &middot; 45-min slot</div>
              <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">40&ndash;45 min of on-court coaching</div>
            </div>
            <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:0.85rem 1rem;">
              <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.25rem;">Batch 2 &middot; 6:45 &ndash; 7:30 PM</div>
              <div style="font-size:0.8rem;font-weight:700;color:white;margin-bottom:0.25rem;">Smash Juniors &amp; Smash Elite</div>
              <div style="font-size:0.85rem;color:white;">Tuesdays &amp; Thursdays &middot; 45-min slot</div>
              <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">40&ndash;45 min of on-court coaching</div>
            </div>
          </div>

          <div style="background:rgba(221,170,64,0.12);border:1px solid rgba(221,170,64,0.45);border-radius:10px;padding:0.85rem 1rem;">
            <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.25rem;">Smash Pro &middot; 6:00 &ndash; 7:30 PM &middot; $295 CAD</div>
            <div style="font-size:0.85rem;color:white;">Tuesdays &amp; Thursdays &middot; 90-min sessions</div>
            <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">Intensive tactical training &amp; matchplay</div>
          </div>

          <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:0.85rem 1rem;">
            <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.35rem;">Fees at a Glance</div>
            <div style="font-size:0.85rem;color:white;line-height:1.6;">Smash Juniors $150 &middot; Smash Elite $175 &middot; Smash Pro $295</div>
            <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">Mandatory Training Kit fee: $30 CAD per athlete, paid in full (no installments). Tuition can be split into 3 installments.</div>
          </div>

          <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:0.85rem 1rem;">
            <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.35rem;">10 Sessions &middot; Twice Weekly</div>
            <div style="font-size:0.85rem;color:white;line-height:1.6;">Jan 26, 28 &middot; Feb 2, 4 &middot; Feb 23, 25 &middot; Mar 2, 4 &middot; Mar 9, 11</div>
            <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">No sessions Feb 9&ndash;18. Smash Juniors (Ages 6&ndash;10) &amp; Smash Elite (Ages 11&ndash;16): open, mixed-level classes for beginners through advanced players.</div>
          </div>
        </div>

        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;">
          <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:1rem;font-size:0.85rem;color:rgba(255,255,255,0.85);line-height:1.5;">
            <div>
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.25rem;">Live Schedules in TeamLinkt</strong>
              Batch assignments and court check-in at the Green Gym are updated in real time through the TeamLinkt app.
            </div>
            <div>
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.25rem;">Equipment</strong>
              Yonex practice shuttles are provided for every session. Athletes bring their own racket (rackets are not provided). Non-marking indoor running shoes required.
            </div>
            <div>
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.25rem;">Safe Sport Standards</strong>
              All coaches undergo police background screening (CRC-VSS), Respect in Sport, and CAC Rule of Two enforcement.
            </div>
          </div>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
          <a href="https://app.teamlinkt.com/register/find/nationalathleticsacademy?cid=81569" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-lg">
            Register for Winter 2027 &rarr;
          </a>
          <a href="/programs/enquiry/" class="btn btn-outline btn-lg">
            Program Enquiry
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Age Tiers & Curricula -->
  <section class="section-padding" style="background:#f8fafc;" aria-labelledby="tiers-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3.5rem;">
        <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">Structured Tiers</span>
        <h2 id="tiers-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.6rem);margin-bottom:1rem;">
          Badminton Age Tiers &amp; Progression
        </h2>
        <p style="color:#4b5563;font-size:1.02rem;max-width:640px;margin:0 auto;line-height:1.7;">
          Tailored 10-session developmental blocks for Tuesday and Thursday evening sessions — from hand-eye coordination &amp; physical literacy to high-speed match tactics.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:2rem;">
        {program.tiers.map((tier, i) => (
          <div class="card reveal" style={`animation-delay:${i * 120}ms;display:flex;flex-direction:column;border-top:4px solid ${i === 0 ? 'var(--color-naa-navy)' : 'var(--color-naa-maroon)'};`}>
            <div style="padding:2rem;">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
                <span class="badge" style={`background:${i === 0 ? 'rgba(2,31,71,0.08)' : 'rgba(131,22,27,0.08)'};color:${i === 0 ? 'var(--color-naa-navy)' : 'var(--color-naa-maroon)'};font-size:0.75rem;font-weight:700;`}>
                  {withoutPrice(tier.badge)}
                </span>
                <span style="font-size:0.85rem;font-weight:700;color:var(--color-naa-navy);font-family:var(--font-outfit);">
                  {tier.ages}
                </span>
              </div>

