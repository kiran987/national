---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { activePrograms } from '../../../data/programs';

const program = activePrograms.find((p) => p.slug === 'volleyball')!;
const otherPrograms = activePrograms.filter((p) => p.slug !== 'volleyball');

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": program.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};

const sportsActivityLocationSchema = {
  "@type": "SportsActivityLocation",
  "@id": "https://naacanada.org/programs/volleyball/#location",
  "name": "NAA Volleyball Court - Green Gym, Centre for Kinesiology and Health Studies",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "3737 Wascana Parkway",
    "addressLocality": "Regina",
    "addressRegion": "SK",
    "postalCode": "S4S 0A2",
    "addressCountry": "CA"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 50.4185,
    "longitude": -104.5889
  }
};

const sportsEventSchema = {
  "@type": "SportsEvent",
  "name": "NAA Youth Volleyball Academy — Winter 2027 Season",
  "description": program.description,
  "startDate": "2027-01-26T18:00:00-06:00",
  "endDate": "2027-03-11T19:30:00-06:00",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": sportsActivityLocationSchema,
  "organizer": {
    "@id": "https://naacanada.org/#organization"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "230",
    "highPrice": "260",
    "priceCurrency": "CAD",
    "availability": "https://schema.org/InStock",
    "url": "https://naacanada.org/programs/volleyball/"
  }
};
---

<Layout
  title="Youth Volleyball Training & Leagues in Regina, SK | NAA"
  description="Youth volleyball training programs in Regina, SK. Skill development, passing, setting, and team play for kids and teens in Saskatchewan."
  schemaGraph={[faqSchema, sportsActivityLocationSchema, sportsEventSchema]}
>
  <Header />

  <!-- Hero Header -->
  <section class="page-hero" style="background:linear-gradient(160deg, #010f24 0%, #021F47 50%, #83161B 100%);padding:9.75rem 0 7.5rem;position:relative;overflow:hidden;">
    <div style="position:absolute;top:-40%;right:-10%;width:550px;height:550px;background:radial-gradient(circle,rgba(221,170,64,0.14) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>
    <div style="position:absolute;bottom:-30%;left:-5%;width:450px;height:450px;background:radial-gradient(circle,rgba(131,22,27,0.2) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>

    <div class="container-naa" style="position:relative;z-index:2;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:0.5rem;font-size:0.82rem;color:rgba(255,255,255,0.65);margin-bottom:1.5rem;">
        <a href="/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Home</a>
        <span>&rsaquo;</span>
        <a href="/programs/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Programs</a>
        <span>&rsaquo;</span>
        <span style="color:var(--color-naa-gold);font-weight:600;">{program.name}</span>
      </nav>

      <div style="max-width:840px;">
        <div style="display:inline-flex;align-items:center;gap:0.6rem;background:rgba(221,170,64,0.15);border:1px solid rgba(221,170,64,0.35);border-radius:9999px;padding:0.4rem 1.1rem;margin-bottom:1.25rem;">
          <span style="font-family:var(--font-outfit);font-weight:700;font-size:0.8rem;color:var(--color-naa-gold);letter-spacing:0.06em;text-transform:uppercase;">
            Program 02 &bull; {program.badge}
          </span>
        </div>

        <h1 style="font-size:clamp(2.2rem,4.5vw,3.5rem);font-weight:900;color:white;line-height:1.1;margin-bottom:1rem;letter-spacing:-0.01em;">
          {program.name}
        </h1>

        <p style="font-size:1.25rem;color:var(--color-naa-gold);font-family:var(--font-outfit);font-weight:600;margin-bottom:1rem;">
          {program.subtitle}
        </p>

        <p style="font-size:1.05rem;color:rgba(255,255,255,0.85);line-height:1.75;margin-bottom:2rem;max-width:720px;">
          {program.description}
        </p>

        <!-- Quick Specs Strip -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:1.25rem 1.5rem;margin-bottom:2rem;overflow:hidden;">
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Age Groups</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">{program.ages.split('(')[0]}</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Coach Ratio</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">1:10 to 1:14 Max</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Block Length</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">10 Classes &middot; 2&times;/wk &middot; 45 min</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Tuition Fees</div>
            <div style="font-size:0.92rem;font-weight:700;color:var(--color-naa-gold);margin-top:0.25rem;white-space:nowrap;">$230 &ndash; $260 CAD</div>
          </div>
        </div>

        <!-- Winter 2027 Program Banner -->
        <div style="background:rgba(255,255,255,0.08);border:1px solid rgba(221,170,64,0.35);border-radius:14px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <span style="display:inline-block;padding:0.25rem 0.65rem;border-radius:6px;background:rgba(221,170,64,0.2);color:var(--color-naa-gold);font-weight:800;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;border:1px solid rgba(221,170,64,0.5);">Registration Opens Nov 1</span>
            <div>
              <div style="font-family:var(--font-outfit);font-weight:800;font-size:0.9rem;color:white;text-transform:uppercase;letter-spacing:0.07em;">Winter 2027 Program &bull; University of Regina Green Gym</div>
              <div style="font-size:0.8rem;color:rgba(255,255,255,0.85);margin-top:0.2rem;">Centre for Kinesiology and Health Studies, 3737 Wascana Parkway &bull; Jan 26 &ndash; Mar 11, 2027</div>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0.75rem;">
            <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:0.85rem 1rem;">
              <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.25rem;">Batch 1 &middot; 6:00 &ndash; 6:45 PM</div>
              <div style="font-size:0.8rem;font-weight:700;color:white;margin-bottom:0.25rem;">Spike Juniors &amp; Spike Elite</div>
              <div style="font-size:0.85rem;color:white;">Tuesdays &amp; Thursdays &middot; 45-min slot</div>
              <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">40&ndash;45 min of on-court coaching</div>
            </div>
            <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:0.85rem 1rem;">
              <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.25rem;">Batch 2 &middot; 6:45 &ndash; 7:30 PM</div>
              <div style="font-size:0.8rem;font-weight:700;color:white;margin-bottom:0.25rem;">Spike Juniors &amp; Spike Elite</div>
              <div style="font-size:0.85rem;color:white;">Tuesdays &amp; Thursdays &middot; 45-min slot</div>
              <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">40&ndash;45 min of on-court coaching</div>
            </div>
          </div>

          <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:0.85rem 1rem;">
            <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.35rem;">Fees at a Glance</div>
            <div style="font-size:0.85rem;color:white;line-height:1.6;">Spike Juniors (Ages 8&ndash;12) $230 &middot; Spike Elite (Ages 13&ndash;16) $260</div>
            <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">Mandatory Training Kit fee: $30 CAD per athlete, paid in full (no installments). Tuition can be split into 3 installments.</div>
          </div>

          <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:0.85rem 1rem;">
            <div style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);font-size:0.9rem;margin-bottom:0.35rem;">10 Sessions &middot; Twice Weekly</div>
            <div style="font-size:0.85rem;color:white;line-height:1.6;">Jan 26, 28 &middot; Feb 2, 4 &middot; Feb 23, 25 &middot; Mar 2, 4 &middot; Mar 9, 11</div>
            <div style="font-size:0.78rem;color:rgba(255,255,255,0.7);margin-top:0.25rem;">No sessions Feb 9&ndash;18.</div>
          </div>
        </div>

        <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:1.25rem 1.5rem;margin-bottom:2rem;">
          <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:1rem;font-size:0.85rem;color:rgba(255,255,255,0.85);line-height:1.5;">
            <div>
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.25rem;">Live Schedules in TeamLinkt</strong>
              Batch assignments and court check-in at the Green Gym are updated in real time through the TeamLinkt app.
            </div>
            <div>
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.25rem;">Training Balls &amp; Nets</strong>
              Mikasa lightweight trainer balls and age-adjusted net heights are set up for every practice. Non-marking court shoes required.
            </div>
            <div>
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.25rem;">Safe Sport Standards</strong>
              All coaches undergo police background screening (CRC-VSS), Respect in Sport, and CAC Rule of Two enforcement.
            </div>
          </div>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
          <a href="/registration/" class="btn btn-gold btn-lg">
            Notify Me: Winter Registration Starts Soon &rarr;
          </a>
          <a href="/contact/" class="btn btn-outline btn-lg">
            Contact Coaching Desk
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Detailed Overview Section -->
  <section class="section-padding" style="background:#ffffff;" aria-labelledby="overview-heading">
    <div class="container-naa">
      <div class="naa-overview-split">
        <div class="reveal">
          <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">Technical Precision</span>
          <h2 id="overview-heading" class="gold-accent" style="font-size:clamp(1.75rem,3vw,2.4rem);margin-bottom:1.25rem;">
            Mastering the 3-Touch Rally Principle
          </h2>
          <p style="color:#374151;font-size:1.02rem;line-height:1.8;margin-bottom:1.5rem;">
            {program.longDescription}
          </p>
          <p style="color:#4b5563;font-size:0.95rem;line-height:1.75;margin-bottom:2rem;">
            Our screened, Safe Sport–trained coaches (including Volleyball Canada trained leadership) use progressive net heights and soft-touch trainer volleyballs, ensuring players develop correct shoulder shrugs, forearm platform angles, and wrist snap mechanics without arm stinging or bad habits.
          </p>

          <h3 style="font-family:var(--font-outfit);font-size:1.15rem;color:var(--color-naa-navy);margin-bottom:1rem;">
            Core Skills Developed:
          </h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0.75rem;">
            {program.skillsFocus.map((skill) => (
              <div style="display:flex;align-items:flex-start;gap:0.65rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:0.75rem 1rem;">
                <span style="color:var(--color-naa-maroon);font-weight:800;font-size:1rem;">✓</span>
                <span style="font-size:0.88rem;color:#1e293b;font-weight:500;">{skill}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Highlights Card with Action Photo -->
        <div class="card reveal" style="padding:0;overflow:hidden;background:linear-gradient(145deg, #f8fafc 0%, #ffffff 100%);border:1px solid #e2e8f0;border-top:5px solid var(--color-naa-maroon);">
          <div style="position:relative;height:220px;overflow:hidden;background:#0B192C;">
            <img
              src="/images/programs/volleyball-action-1.webp"
              alt="National Spike Volleyball athletes practicing pass and attack mechanics on court"
              style="width:100%;height:100%;object-fit:cover;"
              loading="lazy"
            />
            <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(11,25,44,0.85) 0%, transparent 60%);"></div>
            <div style="position:absolute;bottom:1rem;left:1.25rem;right:1.25rem;display:flex;justify-content:space-between;align-items:flex-end;">
              <div>
                <span class="badge" style="background:rgba(131,22,27,0.9);color:white;font-weight:800;font-size:0.7rem;text-transform:uppercase;">On Court</span>
                <div style="color:white;font-weight:800;font-size:0.95rem;margin-top:0.25rem;font-family:var(--font-outfit);">University of Regina Green Gym</div>
              </div>
            </div>
          </div>

          <div style="padding:2rem;">
            <h3 style="font-family:var(--font-outfit);font-size:1.2rem;color:var(--color-naa-navy);margin-bottom:1.25rem;">
              Program Standards &amp; Inclusions
            </h3>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:1rem;margin-bottom:1.5rem;">
              {program.highlights.map((item) => (
                <li style="display:flex;align-items:flex-start;gap:0.75rem;font-size:0.9rem;color:#334155;line-height:1.6;">
                  <span style="color:var(--color-naa-gold);font-weight:900;font-size:1rem;flex-shrink:0;">★</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div style="background:rgba(131,22,27,0.05);border-radius:12px;padding:1.25rem;border-left:4px solid var(--color-naa-maroon);">
              <div style="font-size:0.8rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-maroon);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.25rem;">
                Venue
              </div>
              <p style="font-size:0.85rem;color:#475569;line-height:1.5;margin:0;">
                {program.venue}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Action Showcase Gallery -->
  <section class="section-padding" style="background:#0B192C;color:white;padding:4.5rem 0;" aria-label="Volleyball photo gallery">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="badge" style="background:rgba(245,158,11,0.15);color:var(--color-naa-gold);border:1px solid rgba(245,158,11,0.3);margin-bottom:0.75rem;">Authentic Court Action</span>
        <h2 style="font-size:clamp(1.8rem,3.5vw,2.6rem);color:white;margin-bottom:0.75rem;">
          Volleyball in Action &mdash; Technical Court Reps
        </h2>
        <p style="color:rgba(255,255,255,0.8);max-width:620px;margin:0 auto;font-size:0.95rem;line-height:1.7;">
          Focused skill development at the University of Regina Green Gym. Overhand serve consistency, platform passing angles, and spike approach footwork.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;">
        <div class="reveal" style="position:relative;border-radius:18px;overflow:hidden;box-shadow:0 10px 25px rgba(0,0,0,0.3);aspect-ratio:4/3;">
          <img src="/images/programs/volleyball-action-1.webp" alt="Volleyball athletes setting and hitting drills" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
          <div style="position:absolute;bottom:1rem;left:1.25rem;color:white;font-size:0.85rem;font-weight:700;">Overhand Setting &amp; Net Attacks</div>
        </div>

        <div class="reveal" style="position:relative;border-radius:18px;overflow:hidden;box-shadow:0 10px 25px rgba(0,0,0,0.3);aspect-ratio:4/3;">
          <img src="/images/programs/volleyball-portrait-1.webp" alt="Regina youth volleyball player in forearm passing ready stance" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
          <div style="position:absolute;bottom:1rem;left:1.25rem;color:white;font-size:0.85rem;font-weight:700;">Platform Angle &amp; Serve Receive</div>
        </div>

        <div class="reveal" style="position:relative;border-radius:18px;overflow:hidden;box-shadow:0 10px 25px rgba(0,0,0,0.3);aspect-ratio:4/3;">
          <img src="/images/programs/volleyball-portrait-2.webp" alt="Youth volleyball athlete in jumping approach" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
          <div style="position:absolute;bottom:1rem;left:1.25rem;color:white;font-size:0.85rem;font-weight:700;">3-Contact Team Rallies</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Age Tiers & Curricula -->
  <section class="section-padding" style="background:#f8fafc;" aria-labelledby="tiers-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3.5rem;">
        <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:1rem;">Skill Streams</span>
        <h2 id="tiers-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.6rem);margin-bottom:1rem;">
          Volleyball Developmental Streams
        </h2>
        <p style="color:#4b5563;font-size:1.02rem;max-width:640px;margin:0 auto;line-height:1.7;">
          Structured streams designed to transition players from fundamental rally enjoyment to competitive high school and club gameplay.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:2rem;">
        {program.tiers.map((tier, i) => (
          <div class="card reveal" style={`animation-delay:${i * 120}ms;display:flex;flex-direction:column;border-top:4px solid ${i === 0 ? 'var(--color-naa-maroon)' : 'var(--color-naa-navy)'};`}>
            <div style="padding:2rem;">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
                <span class="badge" style={`background:${i === 0 ? 'rgba(131,22,27,0.08)' : 'rgba(2,31,71,0.08)'};color:${i === 0 ? 'var(--color-naa-maroon)' : 'var(--color-naa-navy)'};font-size:0.75rem;font-weight:700;`}>
                  {tier.badge}
                </span>
                <span style="font-size:0.85rem;font-weight:700;color:var(--color-naa-navy);font-family:var(--font-outfit);">
                  {tier.ages}
                </span>
              </div>

              <h3 style="font-size:1.3rem;color:var(--color-naa-navy);margin-bottom:0.5rem;">
                {tier.name}
              </h3>

              <p style="font-size:0.85rem;color:#64748b;font-weight:600;font-family:var(--font-outfit);margin-bottom:1rem;">
                {tier.format} &bull; {tier.ratio}
              </p>

              <p style="font-size:0.9rem;color:#334155;line-height:1.65;margin-bottom:1.5rem;">
                {tier.focus}
              </p>

              <div style="border-top:1px solid #e2e8f0;padding-top:1.25rem;">
                <div style="font-size:0.78rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem;">
                  Weekly Curriculum Modules
                </div>
                <ul style="list-style:none;display:flex;flex-direction:column;gap:0.6rem;">
                  {tier.curriculum.map((c) => (
                    <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.85rem;color:#475569;line-height:1.5;">
                      <span style="color:var(--color-naa-maroon);font-weight:700;">&bull;</span>
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div style="margin-top:auto;padding:1.25rem 2rem;background:#f8fafc;border-top:1px solid #e2e8f0;display:flex;flex-direction:column;gap:0.5rem;">
              <a href="/registration/" class="btn btn-navy btn-sm" style="width:100%;justify-content:center;">
                Notify Me When Registration Opens &rarr;
              </a>
              <div style="font-size:0.75rem;color:#64748b;text-align:center;">
                Winter 2027 (U of R Green Gym) registration opens Nov 1, 2026
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tuition & What's Included Card -->
  <section class="section-padding" style="background:#ffffff;" aria-labelledby="tuition-heading">
    <div class="container-naa">
      <div class="naa-feature-banner" style="background:linear-gradient(135deg,var(--color-naa-navy) 0%,#0a3a7a 100%);color:white;">
        <div class="naa-report-split">
          <div>
            <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1rem;">
              NAA Quality Standard
            </span>
            <h2 id="tuition-heading" style="font-size:clamp(1.75rem,3vw,2.4rem);color:white;margin-bottom:1rem;">
              The NAA Athlete Progress Report
            </h2>
            <p style="color:rgba(255,255,255,0.85);font-size:1rem;line-height:1.75;margin-bottom:1.5rem;">
              Every volleyball athlete receives an end-of-block evaluation tracking passing target accuracy, setting touch consistency, serving percentages, and court communication on an objective coach rubric.
            </p>
            <div style="display:flex;gap:1.5rem;flex-wrap:wrap;">
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> Respect in Sport certified staff
              </div>
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> 10% sibling discount
              </div>
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> Dedicated parent communication feed
              </div>
            </div>
          </div>

          <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:18px;padding:2rem;">
            <div style="font-family:var(--font-outfit);font-size:1.1rem;font-weight:700;color:var(--color-naa-gold);margin-bottom:1rem;">
              What's Included in Tuition:
            </div>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;">
              {program.whatsIncluded.map((item) => (
                <li style="display:flex;align-items:flex-start;gap:0.65rem;font-size:0.88rem;color:rgba(255,255,255,0.85);line-height:1.6;">
                  <span style="color:var(--color-naa-gold);font-weight:700;">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section-padding" style="background:#f8fafc;" aria-labelledby="faq-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="badge" style="background:rgba(131,22,27,0.08);color:var(--color-naa-maroon);margin-bottom:1rem;">Have Questions?</span>
        <h2 id="faq-heading" class="gold-accent-center" style="font-size:clamp(1.75rem,3vw,2.4rem);margin-bottom:1rem;">
          Volleyball Academy FAQs
        </h2>
      </div>

      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:1.25rem;">
        {program.faqs.map((faq) => (
          <div class="card reveal" style="padding:1.75rem 2rem;">
            <h3 style="font-family:var(--font-outfit);font-size:1.05rem;color:var(--color-naa-navy);margin-bottom:0.75rem;">
              {faq.question}
            </h3>
            <p style="color:#4b5563;font-size:0.92rem;line-height:1.7;">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Other Programs Navigation Strip -->
  <section class="section-padding" style="background:#ffffff;border-top:1px solid #e2e8f0;" aria-label="Explore other programs">
    <div class="container-naa">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;">
        <div>
          <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:0.5rem;">Multi-Sport Academy</span>
          <h2 style="font-size:1.5rem;color:var(--color-naa-navy);">Explore More NAA Sports</h2>
        </div>
        <a href="/programs/" style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-maroon);text-decoration:underline;font-size:0.9rem;">
          View All 6 Programs &rarr;
        </a>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;">
        {otherPrograms.map((op) => (
          <a
            href={`/programs/${op.slug}/`}
            class="card"
            style="padding:1.25rem;text-decoration:none;display:flex;flex-direction:column;gap:0.5rem;border-left:4px solid var(--color-naa-maroon);transition:all 0.2s;"
          >
            <div style="font-size:1.5rem;">{op.emoji}</div>
            <div style="font-family:var(--font-outfit);font-weight:700;font-size:0.95rem;color:var(--color-naa-navy);line-height:1.2;">
              {op.name}
            </div>
            <div style="font-size:0.75rem;color:#64748b;">{op.ages}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section style="background:var(--color-naa-maroon);color:white;padding:4.5rem 0;text-align:center;">
    <div class="container-naa">
      <div class="reveal">
        <h2 style="font-size:clamp(1.8rem,3.5vw,2.5rem);font-weight:800;color:white;margin-bottom:1rem;">
          Step Onto the Volleyball Court in Regina
        </h2>
        <p style="color:rgba(255,255,255,0.85);max-width:560px;margin:0 auto 2rem;line-height:1.7;">
          Winter 2027 volleyball runs 10 sessions at the University of Regina Green Gym (Jan 26 – Mar 11). Registration opens November 1, 2026.
        </p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="/registration/" class="btn btn-gold btn-lg">Notify Me: Registration Starts Soon &rarr;</a>
          <a href="/contact/" class="btn btn-outline btn-lg">Contact Coaching Desk</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
