---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  activePrograms,
  comingSoonPrograms,
  upcomingSports,
  athleteProgressReportDetails,
  pathwayStages,
  discountPolicies,
} from '../../data/programs';

const milestoneIcons: Record<string, string> = {
  technical: '<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1"></circle>',
  movement: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>',
  tactics: '<polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon><circle cx="12" cy="12" r="10"></circle>',
  character: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>',
};
---

<Layout
  title="Sports & Programs | National Athletics Academy"
  description="Explore National Athletics Academy's programs: Basketball, Volleyball, Badminton, National Shield - Martial Arts — plus Camps, Tournaments, Athletics, and more. Certified coaches, structured curricula, and progress reports."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero" aria-labelledby="programs-page-heading" style="background:linear-gradient(160deg,var(--color-naa-navy) 0%,#010f24 50%,#83161B 100%);">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1.25rem;">
          In-Session &amp; Starting Soon
        </span>
        <h1 id="programs-page-heading" style="font-size:clamp(2.2rem,5vw,3.5rem);color:white;margin-bottom:1rem;font-weight:900;">
          Our Sports &amp; Programs
        </h1>
        <p style="color:rgba(255,255,255,0.85);font-size:1.15rem;max-width:680px;margin:0 auto;line-height:1.75;">
          Badminton and Volleyball are running in session now. Basketball and National Shield Martial Arts are starting soon with pre-registration open. Every NAA program has certified coaches, structured curricula, and end-of-block Progress Reports.
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky Sport Navigation Bar in Exact Order -->
  <nav aria-label="Program sections" style="background:white;box-shadow:0 2px 14px rgba(2,31,71,0.08);position:sticky;top:76px;z-index:40;border-bottom:1px solid #e2e8f0;">
    <div class="container-naa" style="overflow-x:auto;">
      <ul style="display:flex;gap:0.25rem;list-style:none;min-width:max-content;padding:0.5rem 0;" role="list">
        {activePrograms.map((prog) => (
          <li>
            <a
              href={`#${prog.slug}`}
              style="display:inline-flex;align-items:center;gap:0.45rem;padding:0.6rem 1rem;border-radius:8px;font-family:var(--font-outfit);font-weight:700;font-size:0.85rem;color:var(--color-naa-navy);transition:all 0.2s;"
              onmouseover="this.style.background='var(--color-naa-grey)';this.style.color='var(--color-naa-maroon)';"
              onmouseout="this.style.background='transparent';this.style.color='var(--color-naa-navy)';"
            >
              <span>{prog.shortName}</span>
            </a>
          </li>
        ))}
        <li>
          <a
            href="#starting-soon"
            style="display:inline-flex;align-items:center;gap:0.45rem;padding:0.6rem 1rem;border-radius:8px;font-family:var(--font-outfit);font-weight:700;font-size:0.85rem;color:var(--color-naa-maroon);background:rgba(131,22,27,0.08);transition:all 0.2s;"
          >
            <span>Starting Soon</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════════════════════
       6 ACTIVE PROGRAMS IN EXACT ORDER
  ════════════════════════════════════════════════════════════ -->
  <section class="section-padding" style="background:#ffffff;" aria-label="Active Sport Academies">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:4rem;">
        <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:0.75rem;">Sport Academies</span>
        <h2 class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.75rem);margin-bottom:1rem;">
          Active &amp; Starting Soon Programs
        </h2>
        <p style="color:#4b5563;font-size:1.05rem;max-width:640px;margin:0 auto;line-height:1.7;">
          Click any program to access its dedicated detailed page with full curriculum modules, age tiers, coach ratios, schedule, and fees.
        </p>
      </div>

      <div style="display:flex;flex-direction:column;gap:3.5rem;">
        {activePrograms.map((prog, index) => (
          <article
            id={prog.slug}
            class="card reveal"
            style={`scroll-margin-top:140px;border-top:5px solid ${index % 2 === 0 ? 'var(--color-naa-navy)' : 'var(--color-naa-maroon)'};`}
          >
            <div class="naa-overview-split" style="padding:3rem 2.5rem;align-items:center;">
              <!-- Left: Content -->
              <div>
                <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;flex-wrap:wrap;">
                  <span class="badge" style="background:rgba(221,170,64,0.18);color:#926508;font-weight:700;font-size:0.78rem;">
                    Program 0{prog.order}
                  </span>
                  <span class="badge" style={`background:${prog.bgColor};color:${prog.color};font-weight:700;font-size:0.78rem;`}>
                    {prog.badge}
                  </span>
                </div>

                <div style="margin-bottom:0.5rem;">
                  <h3 style="font-size:clamp(1.5rem,2.5vw,2rem);color:var(--color-naa-navy);margin:0;">
                    {prog.name}
                  </h3>
                </div>

                <p style="color:var(--color-naa-maroon);font-family:var(--font-outfit);font-weight:600;font-size:1rem;margin-bottom:1rem;">
                  {prog.subtitle}
                </p>

                <p style="color:#374151;font-size:0.98rem;line-height:1.75;margin-bottom:1.5rem;">
                  {prog.description}
                </p>

                <!-- Highlights Bullet List -->
                <ul style="list-style:none;display:flex;flex-direction:column;gap:0.6rem;margin-bottom:2rem;">
                  {prog.highlights.slice(0, 3).map((item) => (
                    <li style="display:flex;align-items:flex-start;gap:0.65rem;font-size:0.88rem;color:#475569;line-height:1.5;">
                      <span style="color:var(--color-naa-gold);font-weight:900;">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
                  <a href={`/programs/${prog.slug}/`} class="btn btn-navy btn-md">
                    View Detailed Program Page &rarr;
                  </a>
                  <a
                    href={prog.status === 'starting-soon' || prog.status === 'coming-soon' ? '/notify/' : '/registration/'}
                    class="btn btn-outline-dark btn-md"
                  >
                    {prog.status === 'starting-soon' || prog.status === 'coming-soon' ? 'Get Notified When Open' : 'Register Now'}
                  </a>
                </div>
              </div>

              <!-- Right: Specs Box with Action Photo -->
              <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;">
                {prog.image && (
                  <div style="position:relative;height:180px;overflow:hidden;background:#0B192C;">
                    <img
                      src={prog.image}
                      alt={prog.name}
                      style="width:100%;height:100%;object-fit:cover;"
                      loading="lazy"
                    />
                    <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(11,25,44,0.7) 0%, transparent 60%);"></div>
                    <span class="badge" style="position:absolute;bottom:0.75rem;left:1rem;background:rgba(245,158,11,0.9);color:#0f172a;font-weight:800;font-size:0.75rem;text-transform:uppercase;">
                      {prog.id === 'national-shield' ? 'In Training' : prog.status === 'coming-soon' ? 'Coming Soon' : 'On Court'}
                    </span>
                  </div>
                )}
                <div style="padding:1.75rem;display:flex;flex-direction:column;gap:1.25rem;">
                  <div style="font-family:var(--font-outfit);font-size:1rem;font-weight:700;color:var(--color-naa-navy);border-bottom:1px solid #e2e8f0;padding-bottom:0.75rem;">
                    Quick Program Snapshot
                  </div>

                <div>
                  <div style="font-size:0.75rem;color:#64748b;font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Ages &amp; Tiers</div>
                  <div style="font-size:0.95rem;font-weight:700;color:var(--color-naa-navy);margin-top:0.2rem;">{prog.ages}</div>
                </div>

                <div>
                  <div style="font-size:0.75rem;color:#64748b;font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Coach-to-Athlete Ratio</div>
                  <div style="font-size:0.95rem;font-weight:700;color:var(--color-naa-navy);margin-top:0.2rem;">{prog.ratio}</div>
                </div>

                <div>
                  <div style="font-size:0.75rem;color:#64748b;font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Venue</div>
                  <div style="font-size:0.85rem;color:#334155;margin-top:0.2rem;line-height:1.4;">{prog.venue}</div>
                </div>

                <div>
                  <div style="font-size:0.75rem;color:#64748b;font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Tuition &amp; Duration</div>
                  <div style="font-size:1.1rem;font-weight:800;color:var(--color-naa-maroon);margin-top:0.2rem;">
                    {
                      prog.id === 'badminton' ? '$150 – $295 / block' :
                      prog.id === 'volleyball' ? '$195 – $245 / block' :
                      prog.id === 'basketball' ? '$205 – $225 / block' :
                      prog.id === 'national-shield' ? '$100 CAD total (Starting Soon)' :
                      prog.blockPrice > 0 ? `$${prog.blockPrice} / block` : 'Contact Us'
                    }
                  </div>
                </div>

                <a
                  href={`/programs/${prog.slug}/`}
                  style="margin-top:0.5rem;text-align:center;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);font-size:0.88rem;text-decoration:underline;"
                >
                  Read full curriculum &amp; FAQs &rarr;
                </a>
              </div>
            </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Camps & Clinics + Tournaments Starting Soon Preview -->
  <section id="starting-soon" class="section-padding" style="background:#021F47;color:white;scroll-margin-top:80px;" aria-labelledby="starting-soon-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3.5rem;">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1rem;">Starting Soon</span>
        <h2 id="starting-soon-heading" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:white;margin-bottom:1rem;font-weight:900;">
          More Programs Starting at NAA
        </h2>
        <p style="color:rgba(255,255,255,0.85);font-size:1.05rem;max-width:680px;margin:0 auto;line-height:1.75;">
          Camps &amp; Clinics, Tournaments, Athletics, Flag Football, Pickleball, and more are starting soon. Register early interest to be notified first.
        </p>
      </div>

      <!-- ── Starting Soon: Full Detail Preview (Camps & Tournaments) ── -->
      <div class="reveal" style="margin-bottom:3rem;">
        <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(221,170,64,0.18);border:1px solid rgba(221,170,64,0.3);border-radius:9999px;padding:0.35rem 1rem;margin-bottom:1.5rem;">
          <span style="font-size:0.75rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);letter-spacing:0.06em;text-transform:uppercase;">Full Program Details Available Now</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:1.5rem;">
          {comingSoonPrograms.map((prog, i) => (
            <div
              class="reveal"
              style={`animation-delay:${i * 100}ms;background:rgba(255,255,255,0.07);border:1px solid rgba(221,170,64,0.3);border-radius:20px;padding:0;overflow:hidden;display:flex;flex-direction:column;`}
            >
              <!-- Top accent bar -->
              <div style={`height:4px;background:var(--color-naa-gold);`}></div>
              <div style="padding:1.75rem 1.75rem 1.25rem;flex:1;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
                  <span style="display:inline-flex;align-items:center;gap:0.4rem;background:rgba(221,170,64,0.18);border:1px solid rgba(221,170,64,0.3);border-radius:9999px;padding:0.25rem 0.75rem;font-size:0.75rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);letter-spacing:0.04em;text-transform:uppercase;">
                    Starting Soon
                  </span>
                  <span style="font-size:0.8rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);">{prog.ages.split('(')[0].trim()}</span>
                </div>
                <div style="margin-bottom:0.5rem;">
                  <h3 style="font-size:1.25rem;color:white;font-family:var(--font-outfit);font-weight:700;line-height:1.2;">{prog.name}</h3>
                </div>
                <p style="font-size:0.82rem;color:var(--color-naa-gold);font-weight:600;font-family:var(--font-outfit);margin-bottom:0.75rem;">{prog.subtitle}</p>
                <p style="font-size:0.88rem;color:rgba(255,255,255,0.78);line-height:1.65;margin-bottom:1.25rem;">
                  {prog.description.slice(0, 160)}{prog.description.length > 160 ? '...' : ''}
                </p>
                <ul style="list-style:none;display:flex;flex-direction:column;gap:0.45rem;margin-bottom:1.25rem;">
                  {prog.highlights.slice(0, 3).map((h) => (
                    <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.8rem;color:rgba(255,255,255,0.7);line-height:1.45;">
                      <span style="color:var(--color-naa-gold);font-weight:900;flex-shrink:0;">✓</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div style="padding:1.25rem 1.75rem;border-top:1px solid rgba(255,255,255,0.1);display:flex;gap:0.75rem;flex-wrap:wrap;">
                <a
                  href={`/programs/${prog.slug}/`}
                  class="btn btn-gold btn-sm"
                  style="flex:1;justify-content:center;min-width:140px;"
                >
                  View Full Details &rarr;
                </a>
                <button
                  type="button"
                  class="btn btn-outline btn-sm"
                  data-notify-btn
                  data-program={prog.name}
                  style="flex:1;justify-content:center;min-width:120px;font-size:0.8rem;border-color:rgba(255,255,255,0.25);cursor:pointer;"
                >
                  Notify Me
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ── Starting Soon: Other Sports (3-column grid) ── -->
      <div class="naa-grid-3" style="margin-bottom:3.5rem;">
        {upcomingSports.filter(s => !s.detailPageUrl).map((sport, i) => (
          <div
            class="reveal"
            style={`animation-delay:${i * 60}ms;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:18px;padding:1.75rem;display:flex;flex-direction:column;height:100%;transition:all 0.3s;`}
            onmouseover="this.style.background='rgba(255,255,255,0.09)';"
            onmouseout="this.style.background='rgba(255,255,255,0.05)';"
          >
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.5rem;">
              <span class="badge" style="background:rgba(221,170,64,0.18);color:var(--color-naa-gold);font-size:0.75rem;font-weight:700;">Starting Soon</span>
              <span style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);">{sport.targetAges}</span>
            </div>
            <h3 style="font-size:1.05rem;color:white;margin-bottom:0.3rem;font-family:var(--font-outfit);font-weight:700;line-height:1.3;">{sport.name}</h3>
            <p style="font-size:0.75rem;color:var(--color-naa-gold);font-weight:600;margin-bottom:0.6rem;font-family:var(--font-outfit);">{sport.tag}</p>
            <p style="font-size:0.83rem;color:rgba(255,255,255,0.7);line-height:1.6;margin-bottom:1.25rem;flex:1;">{sport.description}</p>
            <button
              type="button"
              class="btn btn-outline btn-sm"
              data-notify-btn
              data-program={sport.name}
              style="width:100%;justify-content:center;font-size:0.8rem;padding:0.45rem 1rem;border-color:rgba(255,255,255,0.2);cursor:pointer;"
            >
              Notify Me When Open &rarr;
            </button>
          </div>
        ))}
      </div>

      <div class="reveal" style="text-align:center;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:2rem;max-width:700px;margin:0 auto;">
        <h4 style="font-family:var(--font-outfit);font-size:1.1rem;color:var(--color-naa-gold);margin-bottom:0.5rem;">
          Have a sport or activity you want to see in Regina?
        </h4>
        <p style="color:rgba(255,255,255,0.8);font-size:0.9rem;line-height:1.6;margin-bottom:1.25rem;">
          We welcome feedback from parents, schools, and community associations to help shape our seasonal programming.
        </p>
        <a href="/contact/" class="btn btn-gold btn-sm">Suggest a Sport to NAA Desk</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       LONG-TERM ATHLETE PATHWAY (LTAD)
  ════════════════════════════════════════════════════════════ -->
  <section class="section-padding" style="background:#f8fafc;" aria-labelledby="pathway-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3.5rem;">
        <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:1rem;">Long-Term Development</span>
        <h2 id="pathway-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.75rem);margin-bottom:1rem;">
          The NAA Athlete Pathway
        </h2>
        <p style="color:#4b5563;font-size:1.05rem;max-width:600px;margin:0 auto;line-height:1.7;">
          A progressive continuum from early toddler movement through multi-sport mastery, competitive showcases, and active lifelong recreation.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem;" class="reveal">
        {pathwayStages.map((stage, i) => (
          <div style={`background:white;border-radius:18px;padding:1.75rem;border-top:4px solid ${i < 2 ? 'var(--color-naa-navy)' : i < 4 ? 'var(--color-naa-maroon)' : 'var(--color-naa-gold)'};box-shadow:0 4px 20px rgba(2,31,71,0.06);`}>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.875rem;">
              <div style={`width:36px;height:36px;border-radius:8px;background:${i < 2 ? 'rgba(2,31,71,0.08)' : i < 4 ? 'rgba(131,22,27,0.08)' : 'rgba(221,170,64,0.18)'};display:flex;align-items:center;justify-content:center;font-weight:800;font-family:var(--font-outfit);font-size:0.85rem;color:${i < 2 ? 'var(--color-naa-navy)' : i < 4 ? 'var(--color-naa-maroon)' : '#926508'};`}>
                {i + 1}
              </div>
              <div>
                <h3 style="font-size:1.05rem;color:var(--color-naa-navy);margin:0;">{stage.stage}</h3>
                <span style="font-size:0.78rem;color:#64748b;font-weight:600;">Ages {stage.ages}</span>
              </div>
            </div>
            <p style="font-size:0.82rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-maroon);margin-bottom:0.5rem;">
              {stage.programs}
            </p>
            <p style="font-size:0.88rem;color:#475569;line-height:1.6;">
              {stage.objective}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ATHLETE PROGRESS REPORT
  ════════════════════════════════════════════════════════════ -->
  <section class="section-padding" style="background:#ffffff;" aria-labelledby="report-overview-heading">
    <div class="container-naa">
      <div class="naa-split-even">
        <div class="reveal">
          <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">
            {athleteProgressReportDetails.tagline}
          </span>
          <h2 id="report-overview-heading" class="gold-accent" style="font-size:clamp(1.8rem,3vw,2.5rem);margin-bottom:1.25rem;">
            {athleteProgressReportDetails.title}
          </h2>
          <p style="color:#374151;font-size:1rem;line-height:1.75;margin-bottom:2rem;">
            {athleteProgressReportDetails.description}
          </p>

          <div style="display:flex;flex-direction:column;gap:1.25rem;">
            {athleteProgressReportDetails.milestones.map((m) => (
              <div style="display:flex;gap:1rem;align-items:flex-start;">
                <div style="width:40px;height:40px;border-radius:10px;background:var(--color-naa-grey);display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-naa-navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={milestoneIcons[m.icon]}></svg>
                </div>
                <div>
                  <h3 style="font-size:0.98rem;color:var(--color-naa-navy);margin-bottom:0.25rem;font-family:var(--font-outfit);">
                    {m.category}
                  </h3>
                  <p style="font-size:0.86rem;color:#64748b;line-height:1.55;">
                    {m.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Card -->
        <div class="card reveal" style="padding:3rem 2.5rem;background:linear-gradient(145deg,var(--color-naa-navy) 0%,#0a3a7a 100%);color:white;">
