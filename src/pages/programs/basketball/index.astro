---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { activePrograms } from '../../../data/programs';

const program = activePrograms.find((p) => p.slug === 'basketball')!;
const otherPrograms = activePrograms.filter((p) => p.slug !== 'basketball');

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": program.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};

const sportsActivityLocationSchema = {
  "@type": "SportsActivityLocation",
  "@id": "https://naacanada.org/programs/basketball/#location",
  "name": "NAA Basketball Court - Fellowship Hall Gymnasium",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2340 Victoria Ave",
    "addressLocality": "Regina",
    "addressRegion": "SK",
    "postalCode": "S4P 0S6",
    "addressCountry": "CA"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 50.4485,
    "longitude": -104.6094
  }
};

const sportsEventSchema = {
  "@type": "SportsEvent",
  "name": "National Hoops - Basketball — Regina",
  "description": program.description,
  "startDate": "2026-10-19T17:30:00-06:00",
  "endDate": "2026-12-16T19:00:00-06:00",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": sportsActivityLocationSchema,
  "organizer": {
    "@id": "https://naacanada.org/#organization"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "160",
    "highPrice": "200",
    "priceCurrency": "CAD",
    "availability": "https://schema.org/InStock",
    "url": "https://naacanada.org/programs/basketball/"
  }
};
---

<Layout
  title="Youth Basketball Lessons & Training in Regina, SK | NAA"
  description="Structured youth basketball lessons, skill development, and training for kids & teens in Regina, SK. Certified NCCP coaches. Registration starts soon!"
  schemaGraph={[faqSchema, sportsActivityLocationSchema, sportsEventSchema]}
>
  <Header />

  <!-- Hero Header -->
  <section class="page-hero" style="background:linear-gradient(160deg, #010f24 0%, #021F47 55%, #1a3a6b 100%);padding:9.75rem 0 7.5rem;position:relative;overflow:hidden;">
    <div style="position:absolute;top:-40%;right:-10%;width:550px;height:550px;background:radial-gradient(circle,rgba(221,170,64,0.14) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>
    <div style="position:absolute;bottom:-30%;left:-5%;width:450px;height:450px;background:radial-gradient(circle,rgba(131,22,27,0.12) 0%,transparent 70%);border-radius:50%;pointer-events:none;"></div>

    <div class="container-naa" style="position:relative;z-index:2;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:0.5rem;font-size:0.82rem;color:rgba(255,255,255,0.65);margin-bottom:1.5rem;">
        <a href="/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Home</a>
        <span>&rsaquo;</span>
        <a href="/programs/" style="color:rgba(255,255,255,0.7);text-decoration:none;">Programs</a>
        <span>&rsaquo;</span>
        <span style="color:var(--color-naa-gold);font-weight:600;">{program.name}</span>
      </nav>

      <div style="max-width:840px;">
        <div style="display:inline-flex;align-items:center;gap:0.6rem;background:rgba(221,170,64,0.15);border:1px solid rgba(221,170,64,0.35);border-radius:9999px;padding:0.4rem 1.1rem;margin-bottom:1.25rem;">
          <span style="font-family:var(--font-outfit);font-weight:700;font-size:0.8rem;color:var(--color-naa-gold);letter-spacing:0.06em;text-transform:uppercase;">
            Program 01 &bull; {program.badge}
          </span>
        </div>

        <h1 style="font-size:clamp(2.2rem,4.5vw,3.5rem);font-weight:900;color:white;line-height:1.1;margin-bottom:1rem;letter-spacing:-0.01em;">
          {program.name}
        </h1>

        <p style="font-size:1.25rem;color:var(--color-naa-gold);font-family:var(--font-outfit);font-weight:600;margin-bottom:1rem;">
          {program.subtitle}
        </p>

        <p style="font-size:1.05rem;color:rgba(255,255,255,0.85);line-height:1.75;margin-bottom:2rem;max-width:720px;">
          {program.description}
        </p>

        <!-- Quick Specs Strip -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:1.25rem 1.5rem;margin-bottom:2rem;overflow:hidden;">
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Age Groups</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">{program.ages.split('(')[0]}</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Coach Ratio</div>
            <div style="font-size:0.95rem;font-weight:700;color:white;margin-top:0.25rem;">1:10 to 1:14 Max</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Registration</div>
            <div style="font-size:0.88rem;font-weight:700;color:var(--color-naa-gold);margin-top:0.25rem;">Starts Soon</div>
          </div>
          <div>
            <div style="font-size:0.75rem;color:rgba(255,255,255,0.55);font-family:var(--font-outfit);text-transform:uppercase;letter-spacing:0.05em;">Tuition Fees</div>
            <div style="font-size:0.92rem;font-weight:700;color:var(--color-naa-gold);margin-top:0.25rem;white-space:nowrap;">$205 &ndash; $225 CAD</div>
          </div>
        </div>

        <!-- Winter 2027 Upcoming Schedule Banner -->
        <div style="background:rgba(221,170,64,0.12);border:1px solid rgba(221,170,64,0.4);border-radius:14px;padding:1.25rem 1.5rem;margin-bottom:2rem;display:flex;flex-direction:column;gap:1rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-naa-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
            <div style="font-family:var(--font-outfit);font-weight:800;font-size:0.95rem;color:var(--color-naa-gold);text-transform:uppercase;letter-spacing:0.07em;">Winter 2027 Season &bull; Starting Soon</div>
          </div>
          <p style="font-size:0.9rem;color:rgba(255,255,255,0.88);line-height:1.6;margin:0;">
            Winter 2027 basketball cohorts (Junior Hoops ages 6–10 &amp; Youth Hoops ages 11–15) run 16 structured classes at Knox-Met Fellowship Hall Gym &amp; Balfour Collegiate. Pre-registration &amp; notification lists open on TeamLinkt.
          </p>
          <div style="border-top:1px solid rgba(255,255,255,0.15);padding-top:0.85rem;display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:0.85rem;font-size:0.82rem;color:rgba(255,255,255,0.85);line-height:1.45;">
            <div>
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.2rem;">TeamLinkt App Required</strong>
              Families are required to use the TeamLinkt app for live schedules, locations, roster updates, and announcements.
            </div>
            <div>
              <strong style="color:var(--color-naa-gold);display:block;margin-bottom:0.2rem;">Safe Sport Standards</strong>
              All coaches undergo police background screening (CRC-VSS), Respect in Sport, and CAC Rule of Two enforcement.
            </div>
          </div>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
          <a href="/notify/" class="btn btn-gold btn-lg">
            Registration Starts Soon &mdash; Notify Me &rarr;
          </a>
          <a href="/contact/" class="btn btn-outline btn-lg">
            Contact Coaching Desk
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Detailed Overview Section -->
  <section class="section-padding" style="background:#ffffff;" aria-labelledby="overview-heading">
    <div class="container-naa">
      <div class="naa-overview-split">
        <div class="reveal">
          <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:1rem;">Training Philosophy</span>
          <h2 id="overview-heading" class="gold-accent" style="font-size:clamp(1.75rem,3vw,2.4rem);margin-bottom:1.25rem;">
            Deliberate Skill Progression, Not Just Rec Scrimmages
          </h2>
          <p style="color:#374151;font-size:1.02rem;line-height:1.8;margin-bottom:1.5rem;">
            {program.longDescription}
          </p>
          <p style="color:#4b5563;font-size:0.95rem;line-height:1.75;margin-bottom:2rem;">
            Every session is divided into distinct, intentional blocks: technical motor skill mechanics (ball handling and footwork), high-repetition shooting technique, tactical decision-making drills, and small-sided games (3v3 / 4v4) where athletes apply what they learned under realistic pressure.
          </p>

          <h3 style="font-family:var(--font-outfit);font-size:1.15rem;color:var(--color-naa-navy);margin-bottom:1rem;">
            What Athletes Master:
          </h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0.75rem;">
            {program.skillsFocus.map((skill) => (
              <div style="display:flex;align-items:flex-start;gap:0.65rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:0.75rem 1rem;">
                <span style="color:var(--color-naa-maroon);font-weight:800;font-size:1rem;">✓</span>
                <span style="font-size:0.88rem;color:#1e293b;font-weight:500;">{skill}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Highlights Card with Action Photo -->
        <div class="card reveal" style="padding:0;overflow:hidden;background:linear-gradient(145deg, #f8fafc 0%, #ffffff 100%);border:1px solid #e2e8f0;border-top:5px solid var(--color-naa-navy);">
          <div style="position:relative;height:220px;overflow:hidden;background:#0B192C;">
            <img
              src="/images/programs/basketball-action-1.webp"
              alt="National Hoops Basketball youth players practicing dribbling and court mechanics"
              style="width:100%;height:100%;object-fit:cover;"
              loading="lazy"
            />
            <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(11,25,44,0.85) 0%, transparent 60%);"></div>
            <div style="position:absolute;bottom:1rem;left:1.25rem;right:1.25rem;display:flex;justify-content:space-between;align-items:flex-end;">
              <div>
                <span class="badge" style="background:rgba(245,158,11,0.9);color:#0f172a;font-weight:800;font-size:0.7rem;text-transform:uppercase;">On Court</span>
                <div style="color:white;font-weight:800;font-size:0.95rem;margin-top:0.25rem;font-family:var(--font-outfit);">Hardwood Gymnasium Sessions</div>
              </div>
            </div>
          </div>

          <div style="padding:2rem;">
            <h3 style="font-family:var(--font-outfit);font-size:1.2rem;color:var(--color-naa-navy);margin-bottom:1.25rem;">
              Program Standards &amp; Inclusions
            </h3>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:1rem;margin-bottom:1.5rem;">
              {program.highlights.map((item) => (
                <li style="display:flex;align-items:flex-start;gap:0.75rem;font-size:0.9rem;color:#334155;line-height:1.6;">
                  <span style="color:var(--color-naa-gold);font-weight:900;font-size:1rem;flex-shrink:0;">★</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div style="background:rgba(2,31,71,0.05);border-radius:12px;padding:1.25rem;border-left:4px solid var(--color-naa-navy);">
              <div style="font-size:0.8rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.25rem;">
                Venue
              </div>
              <p style="font-size:0.85rem;color:#475569;line-height:1.5;margin:0;">
                {program.venue}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Action Showcase Gallery -->
  <section class="section-padding" style="background:#0B192C;color:white;padding:4.5rem 0;" aria-label="Basketball photo gallery">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="badge" style="background:rgba(245,158,11,0.15);color:var(--color-naa-gold);border:1px solid rgba(245,158,11,0.3);margin-bottom:0.75rem;">Authentic Court Action</span>
        <h2 style="font-size:clamp(1.8rem,3.5vw,2.6rem);color:white;margin-bottom:0.75rem;">
          Basketball in Action &mdash; Fundamentals &amp; Game IQ
        </h2>
        <p style="color:rgba(255,255,255,0.8);max-width:620px;margin:0 auto;font-size:0.95rem;line-height:1.7;">
          Focused skill development across Regina hardwood gymnasiums. Dribbling mechanics, shooting balance, and decision-rich 3v3 play.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;">
        <div class="reveal" style="position:relative;border-radius:18px;overflow:hidden;box-shadow:0 10px 25px rgba(0,0,0,0.3);aspect-ratio:4/3;">
          <img src="/images/programs/basketball-action-1.webp" alt="Youth basketball players practicing ball handling and spacing" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
          <div style="position:absolute;bottom:1rem;left:1.25rem;color:white;font-size:0.85rem;font-weight:700;">Ball Handling &amp; Triple Threat</div>
        </div>

        <div class="reveal" style="position:relative;border-radius:18px;overflow:hidden;box-shadow:0 10px 25px rgba(0,0,0,0.3);aspect-ratio:4/3;">
          <img src="/images/programs/basketball-portrait-1.webp" alt="Basketball youth athlete in defensive stance" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
          <div style="position:absolute;bottom:1rem;left:1.25rem;color:white;font-size:0.85rem;font-weight:700;">Shooting Form &amp; Arc Balance</div>
        </div>

        <div class="reveal" style="position:relative;border-radius:18px;overflow:hidden;box-shadow:0 10px 25px rgba(0,0,0,0.3);aspect-ratio:4/3;">
          <img src="/images/programs/basketball-portrait-2.webp" alt="Youth basketball player driving to the hoop" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);"></div>
          <div style="position:absolute;bottom:1rem;left:1.25rem;color:white;font-size:0.85rem;font-weight:700;">3v3 Small-Sided Decision Making</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Age Tiers & Curricula -->
  <section class="section-padding" style="background:#f8fafc;" aria-labelledby="tiers-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3.5rem;">
        <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">Age-Appropriate Stages</span>
        <h2 id="tiers-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.6rem);margin-bottom:1rem;">
          Developmental Cohorts &amp; Curricula
        </h2>
        <p style="color:#4b5563;font-size:1.02rem;max-width:640px;margin:0 auto;line-height:1.7;">
          Athletes are grouped by age and developmental stage to ensure appropriate rim heights, ball sizes, and challenge levels.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:2rem;">
        {program.tiers.map((tier, i) => (
          <div class="card reveal" style={`animation-delay:${i * 120}ms;display:flex;flex-direction:column;border-top:4px solid ${i === 0 ? 'var(--color-naa-navy)' : i === 1 ? 'var(--color-naa-maroon)' : 'var(--color-naa-gold)'};`}>
            <div style="padding:2rem;">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
                <span class="badge" style={`background:${i === 0 ? 'rgba(2,31,71,0.08)' : i === 1 ? 'rgba(131,22,27,0.08)' : 'rgba(221,170,64,0.15)'};color:${i === 0 ? 'var(--color-naa-navy)' : i === 1 ? 'var(--color-naa-maroon)' : '#926508'};font-size:0.75rem;font-weight:700;`}>
                  {tier.badge}
                </span>
                <span style="font-size:0.85rem;font-weight:700;color:var(--color-naa-navy);font-family:var(--font-outfit);">
                  {tier.ages}
                </span>
              </div>

              <h3 style="font-size:1.3rem;color:var(--color-naa-navy);margin-bottom:0.5rem;">
                {tier.name}
              </h3>

              <p style="font-size:0.85rem;color:#64748b;font-weight:600;font-family:var(--font-outfit);margin-bottom:1rem;">
                {tier.format} &bull; {tier.ratio}
              </p>

              <p style="font-size:0.9rem;color:#334155;line-height:1.65;margin-bottom:1.5rem;">
                {tier.focus}
              </p>

              <div style="border-top:1px solid #e2e8f0;padding-top:1.25rem;">
                <div style="font-size:0.78rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem;">
                  Weekly Curriculum Highlights
                </div>
                <ul style="list-style:none;display:flex;flex-direction:column;gap:0.6rem;">
                  {tier.curriculum.map((c) => (
                    <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.85rem;color:#475569;line-height:1.5;">
                      <span style="color:var(--color-naa-maroon);font-weight:700;">&bull;</span>
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div style="margin-top:auto;padding:1.25rem 2rem;background:#f8fafc;border-top:1px solid #e2e8f0;">
              <a href="/notify/" class="btn btn-navy btn-sm" style="width:100%;justify-content:center;">
                Registration Starts Soon &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NAA Athlete Progress Report Feature -->
  <section class="section-padding" style="background:#ffffff;" aria-labelledby="report-heading">
    <div class="container-naa">
      <div class="naa-feature-banner" style="background:linear-gradient(135deg,var(--color-naa-navy) 0%,#0a3a7a 100%);color:white;">
        <div class="naa-report-split">
          <div>
            <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1rem;">
              NAA Quality Standard
            </span>
            <h2 id="report-heading" style="font-size:clamp(1.75rem,3vw,2.4rem);color:white;margin-bottom:1rem;">
              The NAA Athlete Progress Report
            </h2>
            <p style="color:rgba(255,255,255,0.85);font-size:1rem;line-height:1.75;margin-bottom:1.5rem;">
              Unlike typical recreational leagues where athletes play without personalized guidance, every basketball participant receives an official end-of-block Progress Report. Our screened, Safe Sport–trained coaches assess shooting mechanics, ball handling fluency, defensive positioning, and sportsmanship against age-appropriate benchmarks.
            </p>
            <div style="display:flex;gap:1.5rem;flex-wrap:wrap;">
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> Objective skill rubric
              </div>
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> Actionable coach feedback
              </div>
              <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.9);font-size:0.88rem;">
                <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> Clear next-tier recommendations
              </div>
            </div>
          </div>

          <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:18px;padding:2rem;">
            <div style="font-family:var(--font-outfit);font-size:1.1rem;font-weight:700;color:var(--color-naa-gold);margin-bottom:1rem;">
              What's Included in Tuition:
            </div>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;">
              {program.whatsIncluded.map((item) => (
                <li style="display:flex;align-items:flex-start;gap:0.65rem;font-size:0.88rem;color:rgba(255,255,255,0.85);line-height:1.6;">
                  <span style="color:var(--color-naa-gold);font-weight:700;">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section-padding" style="background:#f8fafc;" aria-labelledby="faq-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:1rem;">Have Questions?</span>
        <h2 id="faq-heading" class="gold-accent-center" style="font-size:clamp(1.75rem,3vw,2.4rem);margin-bottom:1rem;">
          National Hoops FAQs
        </h2>
      </div>

      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:1.25rem;">
        {program.faqs.map((faq) => (
          <div class="card reveal" style="padding:1.75rem 2rem;">
            <h3 style="font-family:var(--font-outfit);font-size:1.05rem;color:var(--color-naa-navy);margin-bottom:0.75rem;">
              {faq.question}
            </h3>
            <p style="color:#4b5563;font-size:0.92rem;line-height:1.7;">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Other Programs Navigation Strip -->
  <section class="section-padding" style="background:#ffffff;border-top:1px solid #e2e8f0;" aria-label="Explore other programs">
    <div class="container-naa">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;">
        <div>
          <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:0.5rem;">Multi-Sport Academy</span>
          <h2 style="font-size:1.5rem;color:var(--color-naa-navy);">Explore More NAA Sports</h2>
        </div>
        <a href="/programs/" style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-maroon);text-decoration:underline;font-size:0.9rem;">
          View All 6 Programs &rarr;
        </a>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;">
        {otherPrograms.map((op) => (
          <a
            href={`/programs/${op.slug}/`}
            class="card"
            style="padding:1.25rem;text-decoration:none;display:flex;flex-direction:column;gap:0.5rem;border-left:4px solid var(--color-naa-navy);transition:all 0.2s;"
          >
            <div style="font-size:1.5rem;">{op.emoji}</div>
            <div style="font-family:var(--font-outfit);font-weight:700;font-size:0.95rem;color:var(--color-naa-navy);line-height:1.2;">
              {op.name}
            </div>
            <div style="font-size:0.75rem;color:#64748b;">{op.ages}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section style="background:var(--color-naa-maroon);color:white;padding:4.5rem 0;text-align:center;">
    <div class="container-naa">
      <div class="reveal">
        <h2 style="font-size:clamp(1.8rem,3.5vw,2.5rem);font-weight:800;color:white;margin-bottom:1rem;">
          Ready to Elevate Your Basketball Game?
        </h2>
        <p style="color:rgba(255,255,255,0.85);max-width:560px;margin:0 auto 2rem;line-height:1.7;">
          Registration starts soon for our upcoming basketball training blocks in Regina. Sign up for notifications to be the first to know.
        </p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="/notify/" class="btn btn-gold btn-lg">Registration Starts Soon &mdash; Notify Me &rarr;</a>
          <a href="/contact/" class="btn btn-outline btn-lg">Contact Coaching Desk</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
