---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { coaches } from '../../data/coaches';
---

<Layout
  title="Our Coaches | National Athletics Academy"
  description="Meet the certified coaches at National Athletics Academy in Regina. Qualified, screened, and Respect in Sport Certified across Basketball, Volleyball, Badminton, Soccer for Little Kids (U2–U5 with Wascana FC), Athletics, and Tournaments."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero" aria-labelledby="coaches-heading">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1.25rem;">Our Team</span>
        <h1 id="coaches-heading" style="font-size:clamp(2rem,5vw,3.5rem);color:white;margin-bottom:1rem;">Our Coaches</h1>
        <p style="color:rgba(255,255,255,0.75);font-size:1.1rem;max-width:580px;margin:0 auto;">
          Every NAA coach holds current sport certifications, a valid First Aid / CPR certificate, and has passed criminal record and vulnerable sector screening. Respect in Sport certification is mandatory for all coaching staff.
        </p>
      </div>
    </div>
  </section>

  <!-- Coach Standards Banner -->
  <section style="background:var(--color-naa-grey);padding:3rem 0;" aria-label="Coach standards">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;" class="reveal">
        {[
          { icon: '🎓', title: 'Certified', text: 'Current sport-specific coaching certification for every coach' },
          { icon: '🛡️', title: 'Respect in Sport', text: 'Mandatory Respect in Sport certification and compliance for all coaches' },
          { icon: '🔍', title: 'Screened', text: 'Criminal record check with vulnerable sector screening' },
          { icon: '❤️', title: 'First Aid', text: 'Valid First Aid / CPR certification maintained year-round' },
        ].map((standard) => (
          <div style="text-align:center;">
            <div style="font-size:2.25rem;margin-bottom:0.875rem;">{standard.icon}</div>
            <h3 style="font-family:var(--font-outfit);font-size:1rem;color:var(--color-naa-navy);margin-bottom:0.5rem;">{standard.title}</h3>
            <p style="font-size:0.85rem;color:#6b7280;line-height:1.6;">{standard.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════
       MEET THE TEAM (Hidden temporarily per user request)
  ════════════════════════════════════════════════════════════
  <section class="section-padding" aria-labelledby="coaches-grid-heading">
    <div class="container-naa">
      <div class="reveal" style="margin-bottom:3rem;">
        <h2 id="coaches-grid-heading" class="gold-accent" style="font-size:clamp(1.75rem,3vw,2.5rem);">Meet the Team</h2>
        <p style="color:#374151;font-size:1rem;line-height:1.7;max-width:600px;margin-top:0.5rem;">
          NAA is actively recruiting a founding coach group across all pillars. Below are the founding leadership roles and coach profiles. Additional coaching staff will be announced ahead of program launch.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;">
        {coaches.map((coach, i) => (
          <article class="card reveal" id={coach.id} style={`animation-delay:${i*80}ms;`}>
            <div style="background:linear-gradient(135deg,var(--color-naa-navy) 0%,#0a3a7a 100%);padding:2.5rem 2rem;text-align:center;">
              <div style="width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,0.12);border:3px solid rgba(221,170,64,0.5);display:flex;align-items:center;justify-content:center;font-size:2.25rem;margin:0 auto 1rem;">
                {coach.emoji}
              </div>
              <h2 style="font-family:var(--font-outfit);font-weight:700;color:white;font-size:1.05rem;margin-bottom:0.25rem;">{coach.name}</h2>
              <p style="color:var(--color-naa-gold);font-size:0.82rem;font-weight:600;font-family:var(--font-outfit);letter-spacing:0.03em;">{coach.role}</p>
            </div>
            <div style="padding:1.75rem;">
              <p style="font-size:0.875rem;color:#374151;line-height:1.7;margin-bottom:1.25rem;">{coach.bio}</p>

              <div style="margin-bottom:1rem;">
                <p style="font-size:0.75rem;font-weight:700;font-family:var(--font-outfit);color:var(--color-naa-navy);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:0.5rem;">Sports</p>
                <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
                  {coach.sports.map((sport) => (
                    <span class="sport-tag">{sport}</span>
                  ))}
                </div>
              </div>

              <div>
                <p style="font-size:0.75rem;font-weight:700;font-family:var(--font-outfit);color:var(--color-naa-navy);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:0.5rem;">Certifications</p>
                <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
                  {coach.certifications.map((cert) => (
                    <span class="badge" style="background:rgba(131,22,27,0.08);color:var(--color-naa-maroon);font-size:0.7rem;">{cert}</span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  */}

  <!-- Join the Team -->
  <section style="background:var(--color-naa-navy);padding:5rem 0;" aria-labelledby="join-team-heading">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;">
        <div class="reveal">
          <span class="badge" style="background:rgba(221,170,64,0.15);color:var(--color-naa-gold);margin-bottom:1rem;">We're Hiring</span>
          <h2 id="join-team-heading" style="font-size:clamp(1.75rem,3vw,2.5rem);color:white;margin-bottom:1rem;">Join the NAA Coaching Team</h2>
          <p style="color:rgba(255,255,255,0.75);line-height:1.8;margin-bottom:2rem;">
            National Athletics Academy is building a founding group of 8–12 certified coaches across all pillars. We're looking for passionate, qualified coaches who believe in multi-sport development, long-term athlete pathways, and community-first values.
          </p>
          <a href="/contact/#coach-application" class="btn btn-gold" id="coach-apply-btn">Apply as a Coach</a>
        </div>
        <div class="reveal" style="animation-delay:0.2s;">
          <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);margin-bottom:1.25rem;font-size:1rem;letter-spacing:0.05em;text-transform:uppercase;">Minimum Requirements</h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:0.875rem;">
            {[
              'Current sport-specific coaching certification (e.g., Canada Soccer B License, Basketball Canada)',
              'Valid First Aid / CPR certificate',
              'Criminal record check including vulnerable sector screening',
              'Respect in Sport (Activity Leader) certified',
              'Ability to commit to assigned programming blocks',
              'Experience working with youth athletes preferred',
            ].map((req) => (
              <li style="display:flex;gap:0.75rem;align-items:flex-start;color:rgba(255,255,255,0.8);font-size:0.9rem;line-height:1.6;">
                <span style="color:var(--color-naa-gold);font-size:1.1rem;flex-shrink:0;">✓</span>
                {req}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
