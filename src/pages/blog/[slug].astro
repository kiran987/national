---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return allPosts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Get related posts (same category, excluding current)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.data.category === post.data.category && p.data.slug !== post.data.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// Get latest posts for sidebar
const latestPosts = allPosts
  .filter(p => p.data.slug !== post.data.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}

function shortDate(dateStr: string): string {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-CA', { month: 'short', day: 'numeric' });
}

const catColors: Record<string, {bg: string, text: string, dot: string}> = {
  'Community': { bg: 'rgba(22,163,74,0.08)', text: '#15803d', dot: '#22c55e' },
  'Parent Resources': { bg: 'rgba(37,99,235,0.08)', text: '#1d4ed8', dot: '#3b82f6' },
  'Programs': { bg: 'rgba(131,22,27,0.08)', text: '#83161B', dot: '#dc2626' },
  'Gear & Equipment': { bg: 'rgba(124,58,237,0.08)', text: '#6d28d9', dot: '#8b5cf6' },
  'Training Tips': { bg: 'rgba(217,119,6,0.08)', text: '#b45309', dot: '#f59e0b' },
  'Announcements': { bg: 'rgba(2,31,71,0.08)', text: '#021F47', dot: '#3b82f6' },
  'Youth Development': { bg: 'rgba(13,148,136,0.08)', text: '#0d9488', dot: '#14b8a6' },
};

function getCatStyle(cat: string) {
  return catColors[cat] || { bg: 'rgba(0,0,0,0.05)', text: '#555', dot: '#999' };
}

const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readTime = Math.max(1, Math.ceil(wordCount / 220));
const cs = getCatStyle(post.data.category);
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
>
  <Header />

  <!-- ═══ Article Header ═══ -->
  <section class="article-hero">
    <div class="article-hero__bg"></div>
    <div class="container-naa article-hero__inner">
      <a href="/blog/" class="article-hero__back">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        All Articles
      </a>

      <div class="article-hero__meta">
        <span class="article-hero__cat" style={`background:${cs.bg};color:${cs.text};`}>
          <span class="article-hero__cat-dot" style={`background:${cs.dot};`}></span>
          {post.data.category}
        </span>
        <span class="article-hero__divider">·</span>
        <span class="article-hero__date">{formatDate(post.data.date)}</span>
        <span class="article-hero__divider">·</span>
        <span class="article-hero__read">{readTime} min read</span>
      </div>

      <h1 class="article-hero__title">{post.data.title}</h1>

      <p class="article-hero__excerpt">{post.data.excerpt}</p>

      <div class="article-hero__author">
        <img src="/images/naa-logo-sm.webp" alt="NAA" width="36" height="36" class="article-hero__avatar" />
        <div>
          <div class="article-hero__author-name">{post.data.author}</div>
          <div class="article-hero__author-role">Regina, Saskatchewan</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Article Body — Two-Column Layout ═══ -->
  <section style="padding:3.5rem 0 4rem;background:var(--color-naa-offwhite);">
    <div class="container-naa">
      <div class="article-layout">

        <!-- Main Content Column -->
        <article class="article-content">
          <Content />
        </article>

        <!-- Sidebar -->
        <aside class="article-sidebar">
          <!-- Quick Info Card -->
          <div class="sidebar-card sidebar-card--highlight">
            <div class="sidebar-card__header">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              About This Article
            </div>
            <div class="sidebar-card__body">
              <div class="sidebar-info-row">
                <span class="sidebar-info-label">Topic</span>
                <span class="sidebar-info-value" style={`color:${cs.text};`}>{post.data.category}</span>
              </div>
              <div class="sidebar-info-row">
                <span class="sidebar-info-label">Published</span>
                <span class="sidebar-info-value">{shortDate(post.data.date)}, 2026</span>
              </div>
              <div class="sidebar-info-row">
                <span class="sidebar-info-label">Reading Time</span>
                <span class="sidebar-info-value">{readTime} minutes</span>
              </div>
              <div class="sidebar-info-row">
                <span class="sidebar-info-label">Author</span>
                <span class="sidebar-info-value">{post.data.author}</span>
              </div>
            </div>
          </div>

          <!-- Tags -->
          <div class="sidebar-card">
            <div class="sidebar-card__header">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
              Tags
            </div>
            <div class="sidebar-tags">
              {post.data.tags.map((tag: string) => (
                <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="sidebar-tag">#{tag}</a>
              ))}
            </div>
          </div>

          <!-- Register CTA -->
          <div class="sidebar-card sidebar-card--cta">
            <div class="sidebar-cta-emoji">🏸</div>
            <div class="sidebar-cta-text">Winter 2027 registration is open for Smash badminton and Spike volleyball. More programs coming soon.</div>
            <a href="/registration/" class="btn btn-primary btn-sm" style="width:100%;justify-content:center;">Register Now →</a>
          </div>

          <!-- Latest Posts -->
          <div class="sidebar-card">
            <div class="sidebar-card__header">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
              Latest Articles
            </div>
            <div class="sidebar-latest">
              {latestPosts.map((p) => (
                <a href={`/blog/${p.data.slug}/`} class="sidebar-latest__item">
                  <span class="sidebar-latest__date">{shortDate(p.data.date)}</span>
                  <span class="sidebar-latest__title">{p.data.title}</span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ═══ Related Articles ═══ -->
  {relatedPosts.length > 0 && (
    <section class="related-section">
      <div class="container-naa">
        <div class="related-header">
          <h2 class="related-header__title">More in <span style={`color:${cs.text};`}>{post.data.category}</span></h2>
          <a href="/blog/" class="related-header__link">
            View All →
          </a>
        </div>
        <div class="related-grid">
          {relatedPosts.map((related) => (
            <a href={`/blog/${related.data.slug}/`} class="related-card">
              <div class="related-card__date">{shortDate(related.data.date)}</div>
              <h3 class="related-card__title">{related.data.title}</h3>
              <p class="related-card__excerpt">{related.data.excerpt.slice(0, 130)}…</p>
              <span class="related-card__link">Read Article →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ Bottom CTA ═══ -->
  <section class="article-bottom-cta">
    <div class="container-naa">
      <div class="article-bottom-cta__inner">
        <h2 class="article-bottom-cta__title">Join the NAA Community</h2>
        <p class="article-bottom-cta__text">Register your athlete for structured, certified-coach-led sports programming in Regina.</p>
        <div class="article-bottom-cta__actions">
          <a href="/registration/" class="btn btn-primary">Register Now →</a>
          <a href="/blog/" class="btn btn-outline">More Articles</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ══════════════════════════════════════════════════════
     ARTICLE HERO
     ══════════════════════════════════════════════════════ */
  .article-hero {
    position: relative;
    padding: 9.75rem 0 3.5rem;
    overflow: hidden;
  }
  .article-hero__bg {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, #010f24 0%, #021F47 55%, #4a0e11 100%);
  }
  .article-hero__bg::after {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 50% at 30% 70%, rgba(221,170,64,0.04) 0%, transparent 70%);
  }
  .article-hero__inner {
    position: relative; z-index: 1;
    max-width: 820px;
  }
  .article-hero__back {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-family: var(--font-outfit); font-weight: 600;
    font-size: 0.82rem; color: rgba(255,255,255,0.5);
    margin-bottom: 2rem;
    transition: all 0.2s;
  }
  .article-hero__back:hover {
    color: var(--color-naa-gold);
    gap: 0.5rem;
  }
  .article-hero__meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .article-hero__cat {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.68rem; font-weight: 700;
    font-family: var(--font-outfit);
    letter-spacing: 0.06em; text-transform: uppercase;
  }
  .article-hero__cat-dot {
    width: 5px; height: 5px; border-radius: 50%;
  }
  .article-hero__date,
  .article-hero__read {
    font-size: 0.8rem; color: rgba(255,255,255,0.45);
  }
  .article-hero__divider {
    color: rgba(255,255,255,0.2);
  }
  .article-hero__title {
    font-family: var(--font-outfit); font-weight: 800;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: white; line-height: 1.12;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }
  .article-hero__excerpt {
    color: rgba(255,255,255,0.6);
    font-size: 1.02rem; line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 680px;
  }
  .article-hero__author {
    display: flex; align-items: center; gap: 0.85rem;
  }
  .article-hero__avatar {
    border-radius: 50%;
    border: 2px solid rgba(221,170,64,0.3);
  }
  .article-hero__author-name {
    font-family: var(--font-outfit); font-weight: 700;
    font-size: 0.88rem; color: white;
  }
  .article-hero__author-role {
    font-size: 0.72rem; color: rgba(255,255,255,0.4);
  }

  /* ══════════════════════════════════════════════════════
     TWO-COLUMN ARTICLE LAYOUT
     ══════════════════════════════════════════════════════ */
  .article-body-section {
    padding: 3.5rem 0 4rem;
    background: var(--color-naa-offwhite);
  }
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3.5rem;
    align-items: start;
  }

  /* ── Article Content Typography ── */
  .article-content {
    font-family: var(--font-inter);
    font-size: 1.05rem;
    line-height: 1.85;
    color: rgba(2,31,71,0.78);
    max-width: 100%;
  }
  .article-content :global(h2) {
    font-family: var(--font-outfit); font-weight: 800;
    font-size: 1.45rem;
    color: var(--color-naa-navy);
    margin-top: 3rem;
    margin-bottom: 1rem;
    line-height: 1.2;
    position: relative;
    padding-left: 1.1rem;
  }
  .article-content :global(h2)::before {
    content: '';
    position: absolute;
    left: 0; top: 0.15em; bottom: 0.15em;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--color-naa-gold) 0%, var(--color-naa-maroon) 100%);
  }
  .article-content :global(h3) {
    font-family: var(--font-outfit); font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-naa-navy);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }
  .article-content :global(p) {
    margin-bottom: 1.35rem;
  }
  .article-content :global(p:first-of-type) {
    font-size: 1.12rem;
    line-height: 1.8;
    color: rgba(2,31,71,0.85);
  }
  .article-content :global(strong) {
    font-weight: 700;
    color: var(--color-naa-navy);
  }
  .article-content :global(a) {
    color: var(--color-naa-maroon);
    text-decoration: underline;
    text-decoration-color: rgba(131,22,27,0.25);
    text-underline-offset: 3px;
    transition: all 0.2s;
  }
  .article-content :global(a:hover) {
    color: var(--color-naa-navy);
    text-decoration-color: var(--color-naa-navy);
  }
  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.35rem;
    padding-left: 1.5rem;
  }
  .article-content :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }
  .article-content :global(li::marker) {
    color: var(--color-naa-gold);
    font-weight: 700;
  }
  .article-content :global(hr) {
    border: none;
    border-top: 2px solid rgba(2,31,71,0.06);
    margin: 2.5rem 0;
  }
  .article-content :global(blockquote) {
    border-left: 4px solid var(--color-naa-gold);
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    background: linear-gradient(135deg, rgba(221,170,64,0.04) 0%, rgba(221,170,64,0.08) 100%);
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: rgba(2,31,71,0.7);
  }

  /* ── Rich post blocks (fact cards, tiers, tables, photos, buttons) ── */
  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
  }
  .article-content :global(.post-photos) {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
    grid-template-columns: 1fr;
  }
  .article-content :global(.post-photos.two) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .article-content :global(.post-photos figure) { margin: 0; }
  .article-content :global(.post-photos img) {
    width: 100%;
    height: 360px;
    object-fit: cover;
    display: block;
    box-shadow: 0 14px 34px rgba(2,31,71,0.16);
  }
  .article-content :global(.post-photos.wide img) { height: 420px; }
  .article-content :global(.post-photos figcaption) {
    font-size: 0.82rem;
    color: rgba(2,31,71,0.55);
    margin-top: 0.6rem;
    text-align: center;
  }
  .article-content :global(.post-facts) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.75rem 0 2.25rem;
  }
  .article-content :global(.post-fact) {
    background: #fff;
    border: 1px solid rgba(2,31,71,0.08);
    border-top: 4px solid var(--color-naa-gold);
    border-radius: 14px;
    padding: 1rem 1.1rem;
    box-shadow: 0 6px 18px rgba(2,31,71,0.05);
  }
  .article-content :global(.post-fact .k) {
    display: block;
    font-family: var(--font-outfit);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(2,31,71,0.5);
  }
  .article-content :global(.post-fact .v) {
    display: block;
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1.2;
    color: var(--color-naa-navy);
    margin-top: 0.2rem;
  }
  .article-content :global(.post-fact .n) {
    display: block;
    font-size: 0.8rem;
    line-height: 1.4;
    color: rgba(2,31,71,0.6);
    margin-top: 0.25rem;
  }
  .article-content :global(.post-tiers) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
    margin: 1.75rem 0 2.25rem;
  }
  .article-content :global(.post-tier) {
    background: linear-gradient(160deg, #fff 0%, rgba(221,170,64,0.07) 100%);
    border: 1px solid rgba(2,31,71,0.09);
    border-top: 5px solid var(--color-naa-navy);
    border-radius: 18px;
    padding: 1.4rem 1.3rem;
    box-shadow: 0 10px 26px rgba(2,31,71,0.07);
  }
  .article-content :global(.post-tier.pro) { border-top-color: var(--color-naa-maroon); }
  .article-content :global(.post-tier .ages) {
    display: inline-block;
    font-family: var(--font-outfit);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(2,31,71,0.07);
    color: var(--color-naa-navy);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }
  .article-content :global(.post-tier .name) {
    display: block;
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--color-naa-navy);
    margin: 0.7rem 0 0.2rem;
  }
  .article-content :global(.post-tier .price) {
    display: block;
    font-family: var(--font-outfit);
    font-weight: 900;
    font-size: 2rem;
    line-height: 1.05;
    color: var(--color-naa-navy);
    letter-spacing: -0.02em;
  }
  .article-content :global(.post-tier .price small) {
    font-size: 0.8rem;
    font-weight: 800;
    color: #926508;
    margin-left: 0.3rem;
  }
  .article-content :global(.post-tier .meta) {
    display: block;
    font-size: 0.86rem;
    line-height: 1.55;
    color: rgba(2,31,71,0.7);
    margin-top: 0.7rem;
  }
  .article-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    margin: 2rem 0;
    font-size: 0.95rem;
    border: 1px solid rgba(2,31,71,0.1);
    border-radius: 14px;
  }
  .article-content :global(thead th) {
    background: var(--color-naa-navy);
    color: #fff;
    font-family: var(--font-outfit);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    padding: 0.85rem 1rem;
    white-space: nowrap;
  }
  .article-content :global(tbody td) {
    padding: 0.85rem 1rem;
    border-top: 1px solid rgba(2,31,71,0.07);
    vertical-align: top;
  }
  .article-content :global(tbody tr:nth-child(even)) { background: rgba(2,31,71,0.025); }
  .article-content :global(.post-callout) {
    background: linear-gradient(135deg, rgba(221,170,64,0.14) 0%, rgba(221,170,64,0.05) 100%);
    border: 1px solid rgba(221,170,64,0.45);
    border-left: 5px solid var(--color-naa-gold);
    border-radius: 14px;
    padding: 1.2rem 1.5rem;
    margin: 2rem 0;
    font-size: 0.98rem;
    line-height: 1.7;
  }
  .article-content :global(.post-callout p) { margin: 0 0 0.6rem; font-size: inherit; line-height: inherit; }
  .article-content :global(.post-callout p:last-child) { margin-bottom: 0; }
  .article-content :global(.post-cta) {
    text-align: center;
    background: linear-gradient(135deg, var(--color-naa-navy) 0%, #0a3a7a 100%);
    color: #fff;
    border-radius: 20px;
    padding: 2rem 1.5rem;
    margin: 2.5rem 0;
  }
  .article-content :global(.post-cta p) { color: rgba(255,255,255,0.85); margin: 0 0 1.1rem; font-size: 1rem; }
  .article-content :global(.post-cta .title) {
    display: block;
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 1.35rem;
    color: #fff;
    margin-bottom: 0.4rem;
  }
  .article-content :global(a.post-btn) {
    display: inline-block;
    background: var(--color-naa-gold);
    color: #0b1220;
    text-decoration: none;
    font-family: var(--font-outfit);
    font-weight: 800;
    padding: 0.95rem 1.7rem;
    border-radius: 12px;
    box-shadow: 0 10px 24px rgba(221,170,64,0.35);
    transition: transform 0.2s;
  }
  .article-content :global(a.post-btn:hover) { transform: translateY(-2px); color: #0b1220; }
  @media (max-width: 720px) {
    .article-content :global(.post-facts) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .article-content :global(.post-photos.two) { grid-template-columns: 1fr; }
    .article-content :global(.post-photos img),
    .article-content :global(.post-photos.wide img) { height: 280px; }
  }

  /* ── Sidebar ── */
  .article-sidebar {
