---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AthleticHero from '../components/hero/AthleticHero.astro';
import CoachVerificationBadge from '../components/trust/CoachVerificationBadge.astro';
import { ProgramMatrix } from '../components/programs/ProgramMatrix';
import { GymScheduleTable } from '../components/schedules/GymScheduleTable';
import AthletePathwayRail from '../components/pathway/AthletePathwayRail.astro';
import { comingSoonPrograms, upcomingSports } from '../data/programs';
import { coaches, leadership } from '../data/coaches';

const stats = [
  { number: '4', label: 'Sport Academies' },
  { number: '1:10', label: 'Max Coach-to-Athlete Ratio' },
  { number: '100%', label: 'RPS CRC-VSS Screened' },
  { number: 'Ages 2–16', label: 'Youth Development Span' },
];

const whyChooseNAA = [
  {
    title: 'One Family Account, Multiple Sports',
    text: 'Register siblings and enroll in multiple sports through a single dashboard. Enjoy an automatic 10% sibling discount without juggling three different club websites.',
  },
  {
    title: 'Confirmed Hardwood Gym Locations',
    text: 'Training takes place in clean, spacious university hardwood gymnasiums across Regina — including the Green Gym at the Centre for Kinesiology and Health Studies (University of Regina, 3737 Wascana Parkway) with confirmed court times.',
  },
  {
    title: 'Regina Police Screened Coaches',
    text: 'Every coach completes a Regina Police Service Criminal Record Check with Vulnerable Sector Screening, Respect in Sport certification, and adheres to the CAC Rule of Two.',
  },
  {
    title: 'Official Athlete Progress Reports',
    text: 'Athletes receive structured developmental milestone evaluations at the end of each session block, providing parents with tangible feedback on motor skills, game IQ, and sportsmanship.',
  },
];

const faqs = [
  {
    q: 'Where do we enter and park at Knox-Met Church?',
    a: 'For Fall 2026 sessions at Knox-Met Church (2340 Victoria Ave), enter through the front doors of the church on Victoria Avenue. Free street parking is available on Victoria Ave, additional stalls in the back alley lot and on the right side of the building, plus street parking along Lorne Street. Directions, check-in tables, and room assignments are always posted live in your TeamLinkt schedule.',
  },
  {
    q: 'What should my child wear and bring to practice?',
    a: 'Athletes need clean, non-marking indoor court shoes (outdoor runners are strictly not permitted on the hardwood floor to protect the courts), comfortable gym clothes/shorts, and a labelled refillable water bottle. NAA supplies all sport equipment, including high-grade Yonex shuttles, Mikasa/Wilson training balls, and safety pads. Badminton players bring their own racket.',
  },

  {
    q: 'Can complete beginners join, or is prior experience required?',
    a: 'Beginners are warmly welcomed! Our foundational tiers (Smash Juniors, Spike Juniors, Junior Hoops, and National Shield Juniors) are specifically designed for introductory motor literacy and positive skill building. Coaches divide courts by age and ability so every child feels confident and supported.',
  },
  {
    q: 'How does the Family & Multi-Child Discount work?',
    a: 'We offer a 10% discount starting on your second registered participant (and each additional child). Complete registration for Child 1, then click "+ Register Another Participant" before paying. Your 10% multi-child discount is applied automatically by the TeamLinkt registration system at checkout when the registration is eligible.',
  },
  {
    q: 'Are financial assistance and installment plans available?',
    a: 'Yes. NAA offers flexible 2–3 installment payment options and a 10% multi-child sibling discount on second and subsequent children, applied automatically through the TeamLinkt system at checkout.',
  },
  {
    q: 'What coach screening and safe sport protocols are enforced?',
    a: '100% of NAA coaches hold clear Vulnerable Sector Criminal Record Checks (CRC-VSS) issued by the Regina Police Service, have completed Sask Sport Respect in Sport training, and hold Standard First Aid / CPR-C. We strictly enforce the CAC Rule of Two: all training occurs in open, observable gymnasiums with two screened adults present.',
  },
];
---

<Layout
  title="National Athletics Academy | NAA Canada — Regina Youth Sports"
  description="Canada's premier multi-sport youth development academy for ages 2–16. Structured Badminton, Volleyball, Basketball, and Martial Arts in Regina, Saskatchewan."
>
  <Header />

  <!-- ═══════════════════════════════════════════════════════
       1. DYNAMIC SPLIT ATHLETIC HERO
  ════════════════════════════════════════════════════════════ -->
  <AthleticHero />

  <!-- ═══════════════════════════════════════════════════════
       7b. FEATURED TOURNAMENT: NATIONAL SMASH OPEN 2027
  ════════════════════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-[#010f24] via-[#83161B] to-[#021F47] text-white border-t border-slate-800" aria-labelledby="smash-open-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-center">
        <div class="lg:col-span-3">
          <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/20 text-amber-300 border border-amber-400/30 mb-4">
            🏸 Featured Tournament · Registration Opens Soon
          </span>
          <h2 id="smash-open-heading" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
            National Smash Open 2027
          </h2>
          <p class="mt-2 text-amber-300 font-semibold text-lg">Bring Your Smash. Claim Your Glory.</p>
          <p class="mt-4 text-slate-200 text-sm sm:text-base leading-relaxed max-w-2xl">
            A one-day independent open badminton championship on 8 courts. 20 brackets across youth (U11–U19) and adult divisions, with singles and doubles, custom medals and trophies, and no provincial or national membership required.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/programs/tournaments/badminton/national-smash-open-2027/" class="px-6 py-3 rounded-xl font-bold text-sm bg-amber-400 text-slate-950 hover:bg-amber-300 transition-colors">
              View Tournament Details &rarr;
            </a>
            <a href="/programs/tournaments/" class="px-6 py-3 rounded-xl font-semibold text-sm bg-white/10 text-white border border-white/25 hover:bg-white/20 transition-colors">
              All Tournaments
            </a>
          </div>
        </div>

        <div class="lg:col-span-2 grid grid-cols-2 gap-3">
          <div class="rounded-2xl bg-white/10 border border-white/15 p-4">
            <div class="text-[11px] uppercase tracking-wider text-slate-300">Date</div>
            <div class="mt-1 font-bold">Sat, Feb 27, 2027</div>
          </div>
          <div class="rounded-2xl bg-white/10 border border-white/15 p-4">
            <div class="text-[11px] uppercase tracking-wider text-slate-300">Time</div>
            <div class="mt-1 font-bold">8:00 AM – 6:00 PM</div>
          </div>
          <div class="rounded-2xl bg-white/10 border border-white/15 p-4">
            <div class="text-[11px] uppercase tracking-wider text-slate-300">Format</div>
            <div class="mt-1 font-bold">8 Courts · 20 Brackets</div>
          </div>
          <div class="rounded-2xl bg-white/10 border border-white/15 p-4">
            <div class="text-[11px] uppercase tracking-wider text-slate-300">Entry From</div>
            <div class="mt-1 font-bold text-amber-300">$20 CAD / player</div>
          </div>
          <div class="col-span-2 rounded-2xl bg-white/10 border border-white/15 p-4 text-xs sm:text-sm text-slate-200 space-y-1.5">
            <div>
              <strong class="text-amber-300">📍 Venue:</strong> KHS Gymnasium, University of Regina &middot; 3925 Goldenrod Loop (or 3737 Wascana Pkwy), Regina, SK S4S 0A2
            </div>
            <div class="pt-1.5 border-t border-white/10 text-xs text-slate-300">
              <strong class="text-amber-300">☀️ Summer 2-Day Championship:</strong> Sat, June 19 (8:00 AM – 7:30 PM) &amp; Sun, June 20, 2027 (8:00 AM – 6:00 PM) &middot; Registration opens March 1, 2027
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       2. REPUTABLE CREDENTIALS & SASKATCHEWAN SAFETY
  ════════════════════════════════════════════════════════════ -->
  <CoachVerificationBadge />

  <!-- ═══════════════════════════════════════════════════════
       3. ATHLETIC STATS STRIP
  ════════════════════════════════════════════════════════════ -->
  <section aria-label="Key academy statistics" class="py-10 bg-slate-100 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {stats.map((stat) => (
          <div class="p-3">
            <div class="text-3xl sm:text-4xl font-extrabold text-[#0B192C] font-mono tracking-tight">
              {stat.number}
            </div>
            <div class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-600 mt-1">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       4. ASYMMETRIC BENTO GRID PROGRAM MATRIX (FILTERABLE)
  ════════════════════════════════════════════════════════════ -->
  <ProgramMatrix client:visible />

  <!-- ═══════════════════════════════════════════════════════
       5. LIVE GYM LOCATION & SESSION TIME MATRIX
  ════════════════════════════════════════════════════════════ -->
  <GymScheduleTable client:visible />

  <!-- ═══════════════════════════════════════════════════════
       PRACTICAL PARENT GUIDE: WHAT TO BRING, PARKING & DOORS
  ════════════════════════════════════════════════════════════ -->
  <section class="py-16 bg-amber-50/60 border-y border-amber-200/80" aria-labelledby="parent-guide-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-200 text-amber-950 border border-amber-300 mb-3">
          Parent Logistics &amp; Gym Guidelines
        </span>
        <h2 id="parent-guide-heading" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          First Practice? What to Bring &amp; Where to Go
        </h2>
        <p class="mt-2 text-slate-700 text-sm sm:text-base leading-relaxed">
          Youth sports should feel straightforward for busy parents. Here are the everyday logistics for drop-offs, shoes, and gym doors across Regina.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1: What to Bring -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-900 flex items-center justify-center font-bold text-lg mb-4">
              👟
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">What Your Child Needs to Bring</h3>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold shrink-0">✓</span>
                <span><strong>Clean indoor court shoes:</strong> Required for hardwood floors. Outdoor runners worn outside are not permitted on the gym floor.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold shrink-0">✓</span>
                <span><strong>Refillable water bottle:</strong> Pre-filled and labelled with your athlete's name.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold shrink-0">✓</span>
                <span><strong>Gym clothes:</strong> T-shirt, athletic shorts or track pants. We provide all racquets, shuttles, balls, and pads.</span>
              </li>
            </ul>
          </div>
          <p class="text-[11px] text-slate-500 mt-4 pt-3 border-t border-slate-100">
            Bring your own racket. Yonex shuttles are provided on court.
          </p>
        </div>

        <!-- Card 2: Knox-Met Church Drop-off & Parking -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-900 flex items-center justify-center font-bold text-lg mb-4">
              📍
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Knox-Met Church (Fall Sessions)</h3>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-blue-600 font-bold shrink-0">🚪</span>
                <span><strong>Entrance door:</strong> Enter through the front doors of the church directly on Victoria Avenue (2340 Victoria Ave).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-blue-600 font-bold shrink-0">🚗</span>
                <span><strong>Parking tips:</strong> Free street parking on Victoria Ave, additional stalls in the back alley lot and on the right side of the building, plus Lorne Street.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-blue-600 font-bold shrink-0">⏱️</span>
                <span><strong>Arrival timing:</strong> Please arrive 5–10 minutes before session time to change into dry indoor court shoes in the hallway.</span>
              </li>
            </ul>
          </div>
          <p class="text-[11px] text-slate-500 mt-4 pt-3 border-t border-slate-100">
            Coaches and check-in greeters are stationed right inside the main lobby doors.
          </p>
        </div>

        <!-- Card 3: Check-in, Spectator Seating & Dismissal -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-900 flex items-center justify-center font-bold text-lg mb-4">
              👀
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Check-In &amp; Spectator Seating</h3>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold shrink-0">📋</span>
                <span><strong>Coach check-in:</strong> Greet coach table inside the fellowship hall lobby for attendance and court assignments.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold shrink-0">🪑</span>
                <span><strong>Parent seating:</strong> Chairs provided along the perimeter for parents who wish to stay and watch practices.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold shrink-0">📱</span>
                <span><strong>TeamLinkt live reminders:</strong> Weather updates, court announcements, and roster notes are sent directly via TeamLinkt.</span>
              </li>
            </ul>
          </div>
          <p class="text-[11px] text-slate-500 mt-4 pt-3 border-t border-slate-100">
            Have questions on the way? Call coach desk directly at <a href="tel:3063309559" class="font-bold text-slate-900 underline">(306) 330-9559</a>.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════
       7. LONG-TERM ATHLETE PATHWAY VISUAL PROGRESS RAIL
  ════════════════════════════════════════════════════════════ -->
  <AthletePathwayRail />

  <!-- ═══════════════════════════════════════════════════════
       8. CAMPS, CLINICS & TOURNAMENTS (STARTING SOON)
  ════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-[#0c1d36] text-white border-t border-slate-800" aria-labelledby="camps-home-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/20 text-amber-400 border border-amber-400/30 mb-3">
          Starting Soon — Full Program Details Published
        </span>
        <h2 id="camps-home-heading" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
          Camps, Clinics &amp; Tournaments
        </h2>
        <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
          Comprehensive athletic programming beyond regular weekday practices. Multi-sport summer day camps, school-break coverage, and organized weekend competitive invitationals.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {comingSoonPrograms.map((prog) => (
          <article class="flex flex-col bg-slate-900/80 rounded-2xl border border-slate-700/80 overflow-hidden hover:border-amber-400/50 transition-all shadow-lg">
            <div class="h-2 bg-amber-400"></div>
            <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wide bg-amber-400/15 text-amber-300 border border-amber-400/30">
                    {prog.badge}
                  </span>
                  <span class="text-xs font-semibold text-slate-400 font-mono">
                    {prog.ages.split('(')[0].trim()}
                  </span>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">
                  {prog.name}
                </h3>
                <p class="text-xs font-semibold text-amber-400 mb-3">
                  {prog.subtitle}
                </p>
                <p class="text-sm text-slate-300 leading-relaxed mb-6">
                  {prog.description}
                </p>
                <ul class="space-y-2 mb-6">
                  {prog.highlights.slice(0, 3).map((h) => (
                    <li class="flex items-start gap-2 text-xs text-slate-300">
                      <span class="text-amber-400 font-bold shrink-0">✓</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="pt-4 border-t border-slate-800 flex flex-wrap gap-3">
                <a
                  href={`/programs/${prog.slug}/`}
                  class="flex-1 min-w-[140px] text-center px-4 py-2.5 rounded-xl font-bold text-xs bg-amber-400 text-slate-950 hover:bg-amber-300 transition-colors"
                >
                  View Full Details &rarr;
                </a>
                <a
                  href="/programs/enquiry/"
                  class="flex-1 min-w-[140px] text-center px-4 py-2.5 rounded-xl font-semibold text-xs bg-slate-800 text-white hover:bg-slate-700 transition-colors border border-slate-700"
                >
                  Submit Inquiry
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       9. UPCOMING SPORTS & DEVELOPMENT PIPELINE
  ════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-[#021F47] text-white border-t border-slate-800" aria-labelledby="upcoming-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-800 text-slate-300 border border-slate-700 mb-3">
          Expanding Across Regina
        </span>
        <h2 id="upcoming-heading" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
          Upcoming Academy Sports
        </h2>
        <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
          We are actively onboarding facilities and qualified coaches for additional sport cohorts. Early interest registration is open now.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {upcomingSports.filter((s) => !s.detailPageUrl).map((sport) => (
          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-all">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-400">
                  {sport.status}
                </span>
                <span class="text-xs font-mono text-slate-400">
                  {sport.targetAges}
                </span>
              </div>
              <h3 class="text-lg font-bold text-white mb-1.5">
                {sport.name}
              </h3>
              <p class="text-xs text-amber-300/90 font-medium mb-3">
                {sport.tag}
              </p>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                {sport.description}
              </p>
            </div>
            <a
              href="/notify/"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-colors border border-slate-700"
            >
              <span>Get Notified at Launch</span>
              <span>&rarr;</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       10. REGINA COACHING SPOTLIGHT & LEADERSHIP NOTE
  ════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-slate-900 text-white border-t border-slate-800" aria-labelledby="coaches-home-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Welcome Note from Leadership -->
      <div class="bg-gradient-to-br from-slate-800/90 to-slate-900/90 rounded-3xl p-8 sm:p-10 border border-slate-700/80 mb-14 shadow-xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/15 text-amber-300 border border-amber-400/30">
              Message from the Board of Directors
            </span>
            <h2 id="coaches-home-heading" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
              A Personal Welcome to Regina Families
            </h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              "We founded National Athletics Academy because we wanted something genuinely supportive for kids in Regina — certified coaches who take time with every player, transparent gym schedules, and affordable fees without high-pressure tryouts. Whether your child is picking up a racket for the first time or getting ready for high school sports, you have a home here."
            </p>
            <div class="pt-2 flex items-center gap-3.5">
              <img
                src="/images/naa-logo-md.webp"
                alt="National Athletics Academy Emblem"
                width="48"
                height="48"
                class="w-12 h-12 rounded-full object-contain p-0.5 bg-white/10 border border-amber-400/40 shadow-sm shrink-0"
                loading="lazy"
              />
              <div>
                <div class="text-sm font-bold text-white">Board of Directors</div>
                <div class="text-xs text-amber-300/80">National Athletics Academy Inc. &bull; Regina, SK</div>
              </div>
            </div>
          </div>
          
          <div class="lg:col-span-4 bg-slate-950/60 p-6 rounded-2xl border border-slate-800 space-y-3">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Direct Local Line:</div>
            <a href="tel:3063309559" class="text-xl font-bold text-amber-400 hover:text-white transition-colors block">
              (306) 330-9559
            </a>
            <p class="text-xs text-slate-400 leading-relaxed">
              Have questions about which program fits your child, or need assistance registering on TeamLinkt? Call or text our Regina team directly.
            </p>
            <a href="/team/" class="inline-block text-xs font-bold text-amber-300 hover:underline pt-1">
              Meet our entire board &amp; coaching roster &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Coach Bios -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-800 text-slate-300 border border-slate-700 mb-3">
          Our Regina Instructors
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
          Meet Our Regina Coaching Leadership
