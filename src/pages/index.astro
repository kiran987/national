---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  activePrograms,
  comingSoonPrograms,
  upcomingSports,
  pathwayStages,
} from '../data/programs';

const stats = [
  { number: '3', label: 'Active Programs' },
  { number: '1:10', label: 'Avg Coach Ratio' },
  { number: '100%', label: 'Certified Staff' },
  { number: 'U2–16', label: 'Ages Served' },
];

const whyChooseNAA = [
  { icon: '🎯', title: 'One Organization, Many Sports', text: 'Register your entire family for multiple sports through a single account. No more juggling three portals and three fee schedules.' },
  { icon: '📋', title: 'Structured Curricula & Separate Pages', text: 'Every sport has dedicated curriculum outcomes, certified coaches, fixed block lengths, and an end-of-block progress report.' },
  { icon: '📈', title: 'Long-Term Athlete Pathway', text: 'From toddler Active Start (U2–U5 with Wascana FC) to teen tournament competition, NAA maps a clear development journey.' },
  { icon: '🌐', title: 'Certified Quality Coaching', text: 'Basketball Canada, Volleyball Canada, Badminton Canada, Canada Soccer, and Athletics Canada qualified instructors.' },
];

const faqs = [
  {
    q: 'What sports does NAA currently offer?',
    a: 'NAA currently offers 6 core programs in Regina: Basketball, Volleyball, Badminton, Soccer for Little Kids (U2–U5 in association with Wascana FC), Athletics (Track & Field), and Tournaments — along with seasonal Camps & Clinics, with more sports starting soon!',
  },
  {
    q: 'What ages does NAA serve?',
    a: 'We serve athletes from age 2 (U2 toddler soccer with Wascana FC) up to age 16 for youth academies and all ages for our tournament series.',
  },
  {
    q: 'Can my child register for multiple sports?',
    a: 'Yes! Multi-sport participation is central to our philosophy. We offer a 10% multi-sport discount on secondary sport registrations within the same family account.',
  },
  {
    q: 'Where do training sessions and tournaments take place?',
    a: 'Sessions take place across Regina at hardwood gymnasiums in Regina Public and Catholic school divisions, community fieldhouses, and indoor turf facilities. Specific facility details are given upon enrollment.',
  },
  {
    q: 'Are financial assistance and flexible payment plans available?',
    a: 'Yes. NAA offers 2-to-3 installment payment plans, multi-child discounts, and subsidized community spaces. No child is turned away for cost alone.',
  },
  {
    q: 'Are coaches certified and background-checked?',
    a: 'Yes. 100% of NAA coaches hold sport-specific certifications, valid First Aid/CPR, Criminal Record Checks with Vulnerable Sector Screening (CRC-VSS), and mandatory Respect in Sport certification.',
  },
];
---

<Layout
  title="National Athletics Academy Inc. | Multi-Sport Training in Regina"
  description="Regina's premier multi-sport training organization. Basketball, Volleyball, Badminton, Soccer for Little Kids (U2–U5 with Wascana FC), Athletics (Track & Field), Tournaments, and Camps & Clinics."
>
  <Header />

  <!-- ═══════════════════════════════════════════════════════
       HERO SECTION
  ════════════════════════════════════════════════════════════ -->
  <section class="hero-section" aria-labelledby="hero-heading">
    <div class="hero-bg-pattern" aria-hidden="true"></div>

    <div aria-hidden="true" style="position:absolute;right:-120px;top:50%;transform:translateY(-50%);width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(131,22,27,0.14) 0%,transparent 70%);pointer-events:none;"></div>
    <div aria-hidden="true" style="position:absolute;left:-80px;bottom:-80px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(221,170,64,0.08) 0%,transparent 70%);pointer-events:none;"></div>

    <div class="container-naa" style="position:relative;z-index:2;display:grid;grid-template-columns:1.2fr 0.8fr;gap:3.5rem;align-items:center;padding-top:4.5rem;padding-bottom:4.5rem;">
      <!-- Left: Text Content -->
      <div>
        <div class="animate-fade-up" style="margin-bottom:1.5rem;">
          <span class="badge" style="background:rgba(221,170,64,0.15);color:var(--color-naa-gold);border:1px solid rgba(221,170,64,0.35);padding:0.35rem 1rem;font-size:0.8rem;">
            ⭐ Regina, Saskatchewan · Non-Profit Youth Athletics
          </span>
        </div>

        <h1 id="hero-heading" class="animate-fade-up delay-100" style="font-family:var(--font-outfit);font-size:clamp(2.6rem,5.5vw,4rem);font-weight:900;color:white;line-height:1.06;margin-bottom:1.5rem;letter-spacing:-0.01em;">
          One Academy.<br/>
          <span style="color:var(--color-naa-gold);">Every Sport.</span>
        </h1>

        <p class="animate-fade-up delay-200" style="font-size:1.15rem;color:rgba(255,255,255,0.85);line-height:1.75;max-width:560px;margin-bottom:2rem;">
          National Athletics Academy delivers structured developmental training in <strong>Basketball</strong>, <strong>Volleyball</strong>, <strong>Badminton</strong>, <strong>Soccer for Little Kids (U2–U5 in association with Wascana FC)</strong>, <strong>Athletics (Track &amp; Field)</strong>, and <strong>Tournaments</strong> — with camps, clinics, and more sports starting soon!
        </p>

        <div class="animate-fade-up delay-300" style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-bottom:2.25rem;">
          <a href="/programs/" class="btn btn-primary btn-lg" id="explore-programs-btn">
            Explore All Programs
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="/registration/" class="btn btn-outline btn-lg" id="register-hero-btn">Register Now</a>
        </div>

        <div class="animate-fade-up delay-400" style="display:flex;gap:1.75rem;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,0.1);padding-top:1.5rem;">
          <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.75);font-size:0.85rem;">
            <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> Respect in Sport Certified Coaches
          </div>
          <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.75);font-size:0.85rem;">
            <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> In Association with Wascana FC
          </div>
          <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.75);font-size:0.85rem;">
            <span style="color:var(--color-naa-gold);font-weight:700;">✓</span> CRC-VSS Police Screened Staff
          </div>
        </div>
      </div>

      <!-- Right: Crest + Interactive Sport Filter Pills in EXACT Order -->
      <div class="animate-fade-in delay-200" style="display:flex;flex-direction:column;align-items:center;gap:1.75rem;justify-self:center;">
        <div style="position:relative;display:inline-block;">
          <div style="position:absolute;inset:-10px;border-radius:50%;background:conic-gradient(from 0deg,var(--color-naa-gold),transparent,var(--color-naa-maroon),transparent,var(--color-naa-gold));opacity:0.45;animation:spin 8s linear infinite;"></div>
          <img
            src="/images/naa-logo-md.webp"
            alt="National Athletics Academy Crest"
            width="220"
            height="220"
            style="border-radius:50%;position:relative;z-index:1;box-shadow:0 16px 45px rgba(0,0,0,0.45);display:block;"
          />
        </div>

        <div style="text-align:center;width:100%;">
          <p style="font-size:0.75rem;font-family:var(--font-outfit);font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.6);margin-bottom:0.75rem;">
            Select a Sport to Explore (Exact Order)
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:center;max-width:440px;margin:0 auto;" id="hero-filter-pills">
            {activePrograms.map((sport) => (
              <a
                href={`/programs/${sport.slug}/`}
                class="sport-filter-pill"
                title={`Explore ${sport.name}`}
              >
                {sport.emoji} {sport.shortName}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       STATS BAR
  ════════════════════════════════════════════════════════════ -->
  <section aria-label="Key statistics" style="background:var(--color-naa-grey);padding-bottom:4rem;">
    <div class="container-naa">
      <div class="stats-bar reveal">
        {stats.map((stat) => (
          <div class="stat-item">
            <div class="stat-number">{stat.number}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       6 ACTIVE PROGRAMS (IN EXACT ORDER)
  ════════════════════════════════════════════════════════════ -->
  <section id="programs-overview" class="section-padding" aria-labelledby="programs-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:4rem;">
        <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">Running Now</span>
        <h2 id="programs-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.75rem);margin-bottom:1rem;">
          3 Active Programs
        </h2>
        <p style="color:#4b5563;font-size:1.05rem;max-width:620px;margin:0 auto;line-height:1.7;">
          Each program has a dedicated curriculum, certified coaches, low athlete-to-coach ratios, and an official NAA Progress Report. Camps, Tournaments &amp; more sports launching soon.
        </p>
      </div>

      <div class="program-grid">
        {activePrograms.map((prog, i) => (
          <article class="program-card reveal" style={`animation-delay:${i * 80}ms`}>
            <div class="program-card-header">
              <div class="program-icon" style={`background:${prog.bgColor};`}>
                {prog.emoji}
              </div>
              <span class="badge" style={`background:${prog.bgColor};color:${prog.color};margin-bottom:0.75rem;`}>
                Program 0{prog.order} &bull; {prog.badge}
              </span>
              <h3 style={`font-size:1.2rem;color:${prog.color};margin-bottom:0.25rem;`}>{prog.name}</h3>
              <p style="font-size:0.85rem;color:#6b7280;font-style:italic;">{prog.subtitle}</p>
            </div>
            <div class="program-card-body">
              <p style="color:#374151;font-size:0.9rem;line-height:1.65;margin-bottom:1rem;">
                {prog.description.slice(0, 150)}…
              </p>
              
              <div style="background:#f8fafc;border-radius:10px;padding:0.75rem 1rem;font-size:0.82rem;color:#475569;margin-bottom:1rem;">
                <div style="font-weight:700;color:var(--color-naa-navy);">{prog.ages}</div>
                <div>{prog.ratio} &bull; {prog.blockPrice > 0 ? `$${prog.blockPrice} / block` : 'Contact Us for Pricing'}</div>
              </div>

              <div style="margin-top:auto;padding-top:0.5rem;display:flex;flex-direction:column;gap:0.5rem;">
                <a href={`/programs/${prog.slug}/`} class="btn btn-navy btn-sm" style="width:100%;justify-content:center;">
                  View Detailed Page
                  <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="reveal" style="text-align:center;margin-top:3rem;">
        <a href="/programs/" class="btn btn-primary btn-lg" id="all-programs-btn">View All Programs &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Coming Soon Preview: Camps & Tournaments (with detail pages) -->
  <section class="section-padding" style="background:#0c1d36;color:white;" aria-labelledby="camps-home-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="badge" style="background:rgba(221,170,64,0.18);color:var(--color-naa-gold);border:1px solid rgba(221,170,64,0.35);font-size:0.75rem;font-weight:800;letter-spacing:0.08em;margin-bottom:1.25rem;">Coming Soon — Full Details Available</span>
        <h2 id="camps-home-heading" style="font-size:clamp(1.8rem,4vw,2.75rem);color:white;margin-bottom:0.75rem;font-weight:900;">
          Camps, Clinics &amp; Tournaments
        </h2>
        <p style="color:rgba(255,255,255,0.8);font-size:1.05rem;max-width:640px;margin:0 auto;line-height:1.75;">
          Full program details are already published. Browse the curriculum, age tiers, and formats &mdash; then register your early interest.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:1.5rem;">
        {comingSoonPrograms.map((prog, i) => (
          <div
            class="reveal"
            style={`animation-delay:${i * 120}ms;background:rgba(255,255,255,0.06);border:1px solid rgba(221,170,64,0.28);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;`}
          >
            <div style="height:4px;background:var(--color-naa-gold);"></div>
            <div style="padding:1.75rem 1.75rem 1.25rem;flex:1;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
                <span style="background:rgba(221,170,64,0.18);border:1px solid rgba(221,170,64,0.35);border-radius:9999px;padding:0.2rem 0.75rem;font-size:0.7rem;font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-gold);letter-spacing:0.04em;text-transform:uppercase;">Coming Soon</span>
                <span style="font-size:0.8rem;color:rgba(255,255,255,0.5);font-family:var(--font-outfit);">{prog.ages.split('(')[0].trim()}</span>
              </div>
              <div style="display:flex;align-items:center;gap:0.65rem;margin-bottom:0.4rem;">
                <span style="font-size:1.75rem;">{prog.emoji}</span>
                <h3 style="font-size:1.2rem;color:white;font-family:var(--font-outfit);font-weight:700;line-height:1.2;">{prog.name}</h3>
              </div>
              <p style="font-size:0.78rem;color:var(--color-naa-gold);font-weight:600;font-family:var(--font-outfit);margin-bottom:0.75rem;">{prog.subtitle}</p>
              <p style="font-size:0.85rem;color:rgba(255,255,255,0.75);line-height:1.6;margin-bottom:1.25rem;">
                {prog.description.slice(0, 140)}{prog.description.length > 140 ? '...' : ''}
              </p>
              <ul style="list-style:none;display:flex;flex-direction:column;gap:0.4rem;">
                {prog.highlights.slice(0, 3).map((h) => (
                  <li style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.78rem;color:rgba(255,255,255,0.7);line-height:1.45;">
                    <span style="color:var(--color-naa-gold);font-weight:900;flex-shrink:0;">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div style="padding:1.25rem 1.75rem;border-top:1px solid rgba(255,255,255,0.1);display:flex;gap:0.75rem;">
              <a href={`/programs/${prog.slug}/`} class="btn btn-gold btn-sm" style="flex:1;justify-content:center;">View Full Details &rarr;</a>
              <a href="/registration/" class="btn btn-outline btn-sm" style="flex:1;justify-content:center;font-size:0.8rem;border-color:rgba(255,255,255,0.25);">Notify Me</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       MORE SPORTS & ACTIVITIES STARTING SOON
  ════════════════════════════════════════════════════════════ -->
  <section class="section-padding" style="background:#021F47;color:white;" aria-labelledby="upcoming-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3.5rem;">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1rem;">Expansion Pipeline</span>
        <h2 id="upcoming-heading" style="font-size:clamp(1.8rem,3.5vw,2.75rem);color:white;margin-bottom:1rem;font-weight:900;">
          More Sports &amp; Activities Starting Soon
        </h2>
        <p style="color:rgba(255,255,255,0.85);font-size:1.05rem;max-width:660px;margin:0 auto;line-height:1.75;">
          NAA is continually preparing new programs for upcoming seasonal blocks. Preview our roadmap below and register early interest!
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;margin-bottom:3rem;">
        {upcomingSports.filter(s => !s.detailPageUrl).slice(0, 6).map((item, i) => (
          <div
            class="reveal"
            style={`animation-delay:${i*80}ms;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:18px;padding:1.75rem;display:flex;flex-direction:column;`}
          >
            <div style="font-size:2rem;margin-bottom:0.75rem;">{item.emoji}</div>
            <span class="badge" style="background:rgba(221,170,64,0.18);color:var(--color-naa-gold);align-self:flex-start;font-size:0.72rem;margin-bottom:0.5rem;">
              {item.status}
            </span>
            <h3 style="font-size:1.1rem;color:white;margin-bottom:0.35rem;font-family:var(--font-outfit);font-weight:700;">
              {item.name}
            </h3>
            <p style="font-size:0.85rem;color:rgba(255,255,255,0.75);line-height:1.6;margin-bottom:1.25rem;flex:1;">
              {item.description}
            </p>
            <a href="/registration/" class="btn btn-outline btn-sm" style="font-size:0.8rem;text-align:center;justify-content:center;">
              Notify Me &rarr;
            </a>
          </div>
        ))}
      </div>

      <div class="reveal" style="text-align:center;">
        <a href="/programs/#starting-soon" class="btn btn-gold btn-md">
          View Complete Expansion List &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ATHLETE PATHWAY
  ════════════════════════════════════════════════════════════ -->
  <section class="section-padding" style="background:var(--color-naa-grey);" aria-labelledby="pathway-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;margin-bottom:3.5rem;">
        <span class="badge" style="background:rgba(2,31,71,0.1);color:var(--color-naa-navy);margin-bottom:1rem;">Long-Term Athlete Development</span>
        <h2 id="pathway-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.75rem);margin-bottom:1rem;">The NAA Athlete Pathway</h2>
        <p style="color:#4b5563;font-size:1.05rem;max-width:600px;margin:0 auto;line-height:1.7;">
          A clear answer to "what comes next?" — keeping athletes engaged, active, and improving at every stage.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem;" class="reveal">
        {pathwayStages.map((stage, i) => (
          <div style={`background:white;border-radius:16px;padding:1.75rem;border-top:4px solid ${i < 2 ? 'var(--color-naa-navy)' : i < 4 ? 'var(--color-naa-maroon)' : 'var(--color-naa-gold)'};box-shadow:0 4px 20px rgba(2,31,71,0.07);`}>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.875rem;">
              <div style={`width:36px;height:36px;border-radius:8px;background:${i < 2 ? 'rgba(2,31,71,0.1)' : i < 4 ? 'rgba(131,22,27,0.1)' : 'rgba(221,170,64,0.2)'};display:flex;align-items:center;justify-content:center;font-weight:800;font-family:var(--font-outfit);font-size:0.85rem;color:${i < 2 ? 'var(--color-naa-navy)' : i < 4 ? 'var(--color-naa-maroon)' : '#a07820'};`}>{i + 1}</div>
              <h3 style="font-size:1rem;color:var(--color-naa-navy);">{stage.stage}</h3>
            </div>
            <div class="badge" style="background:rgba(2,31,71,0.07);color:var(--color-naa-navy);margin-bottom:0.75rem;">Ages {stage.ages}</div>
            <p style="font-size:0.85rem;color:#4b5563;line-height:1.6;">{stage.objective}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════
       WHY NAA?
  ════════════════════════════════════════════════════════════ -->
  <section class="section-padding" aria-labelledby="why-heading">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;">
        <!-- Left: Content -->
        <div class="reveal">
          <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">Why Choose NAA</span>
          <h2 id="why-heading" class="gold-accent" style="font-size:clamp(1.8rem,3.5vw,2.6rem);margin-bottom:1.5rem;">Built Different. Built Better.</h2>
          <p style="color:#374151;font-size:1rem;line-height:1.75;margin-bottom:2rem;">
            Most youth sport in Saskatchewan is delivered by single-sport clubs in isolation. National Athletics Academy consolidates the entire experience — multiple sports, one family account, one coaching philosophy, one place for everyone.
          </p>

          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            {whyChooseNAA.map((item) => (
              <div style="display:flex;gap:1rem;align-items:flex-start;">
                <div style="width:46px;height:46px;border-radius:12px;background:var(--color-naa-grey);display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0;">{item.icon}</div>
                <div>
                  <h3 style="font-size:1rem;color:var(--color-naa-navy);margin-bottom:0.35rem;">{item.title}</h3>
                  <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;">{item.text}</p>
                </div>
              </div>
            ))}
          </div>

          <div style="margin-top:2.5rem;">
            <a href="/about/" class="btn btn-primary" id="learn-more-btn">Learn About NAA</a>
          </div>
        </div>

        <!-- Right: Mission card -->
        <div class="reveal" style="position:relative;">
          <div style="background:linear-gradient(160deg,var(--color-naa-navy) 0%,#0a3a7a 100%);border-radius:24px;padding:3rem;color:white;position:relative;overflow:hidden;">
            <div style="position:absolute;top:-30px;right:-30px;width:200px;height:200px;border-radius:50%;background:rgba(221,170,64,0.08);pointer-events:none;"></div>
            <div style="position:absolute;bottom:-40px;left:-20px;width:160px;height:160px;border-radius:50%;background:rgba(131,22,27,0.15);pointer-events:none;"></div>
            <div style="position:relative;z-index:1;">
              <div style="font-size:2rem;margin-bottom:1.5rem;">🎯</div>
