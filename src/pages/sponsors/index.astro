---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RecaptchaNotice from '../../components/RecaptchaNotice.astro';

const sponsorTiers = [
  {
    name: 'Community Champion',
    price: '$500',
    cadence: '/ seasonal block',
    tagline: 'Directly subsidize youth participation and break down financial barriers.',
    highlight: false,
    badge: 'Grassroots Impact',
    features: [
      'Subsidizes registration fees and athletic equipment for 2 youth athletes in need',
      'Logo & link on the NAA Community Partner wall and website sponsors section',
      'Social media partner welcome spotlight reaching hundreds of Regina sports families',
      'Certificate of Appreciation & official NAA Community Supporter digital badge',
    ],
    cta: 'Select Champion Tier',
  },
  {
    name: 'Team & Program Sponsor',
    price: '$1,500',
    cadence: '/ season',
    tagline: 'Prominent branding on athlete practice gear and sport academy clinics.',
    highlight: true,
    badge: 'Most Popular',
    features: [
      'Official named sponsor of an entire age cohort (Basketball, Volleyball, or Martial Arts)',
      'Your business logo featured on athlete training jerseys or warm-up pinnies',
      'Dedicated sponsor showcase card on the respective sport program page with backlink',
      'Physical banner or pop-up display permitted at all seasonal training clinics',
      'Direct email feature in our monthly family newsletter (1x per season)',
      'Subsidizes team facility permits and certified referee/coaching honorariums',
    ],
    cta: 'Select Program Sponsor',
  },
  {
    name: 'Tournament & Showcase Title',
    price: '$5,000',
    cadence: '/ tournament event',
    tagline: 'Exclusive naming rights and premier visibility at our competitive tournaments.',
    highlight: false,
    badge: 'Maximum Event Reach',
    features: [
      'Exclusive title naming rights (e.g. "The [Your Business] NAA Spring Invitational")',
      'Prominent logo on digital brackets, official schedules, and TeamLinkt match summaries',
      'Sponsor representative invited to present championship trophies & MVP awards at courtside',
      'Dedicated promotional booth / product display table in prime facility entrance area',
      'Public address announcements thanking your company throughout competition days',
      'Logo on all event tournament t-shirts, medals, and promotional posters across Regina',
    ],
    cta: 'Select Tournament Title',
  },
];

const impactStats = [
  { value: '100%', label: 'Non-Profit Cost Recovery', sub: 'Every dollar goes to kids, permits & gear' },
  { value: 'U2–16', label: 'Youth Demographics', sub: 'Active engagement across Regina families' },
  { value: '10:1', label: 'Safe Coach Ratio', sub: 'Respect in Sport & CRC-VSS certified' },
  { value: 'Zero', label: 'Child Turned Away', sub: 'Your sponsorship funds bursaries & subsidized fees' },
];
---

<Layout
  title="Sponsorship Opportunities | National Athletics Academy Regina"
  description="Partner with National Athletics Academy Inc. in Regina. Explore corporate sponsorship packages, team jersey branding, tournament title naming, and community impact bursaries."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero" aria-labelledby="sponsors-hero-heading" style="background:linear-gradient(160deg,#021F47 0%,#010f24 55%,#83161b 100%);">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);border:1px solid rgba(221,170,64,0.35);margin-bottom:1.25rem;">
          Community &amp; Corporate Partnerships
        </span>
        <h1 id="sponsors-hero-heading" style="font-size:clamp(2.2rem,5vw,3.75rem);color:white;margin-bottom:1.25rem;font-weight:900;letter-spacing:-0.01em;">
          Partner with Regina's<br/>
          <span style="color:var(--color-naa-gold);">Multi-Sport Academy</span>
        </h1>
        <p style="color:rgba(255,255,255,0.88);font-size:1.15rem;max-width:700px;margin:0 auto 2.25rem;line-height:1.75;">
          Empower young athletes, break financial barriers for local families, and gain meaningful community visibility across school gymnasiums, competitive tournaments, and digital broadcasts.
        </p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="#packages" class="btn btn-gold btn-lg">View Sponsorship Packages ↓</a>
          <a href="#sponsor-form" class="btn btn-outline btn-lg" style="border-color:rgba(255,255,255,0.4);color:white;">Submit Partnership Inquiry</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact Stats Banner -->
  <section style="background:var(--color-naa-navy);border-bottom:1px solid rgba(221,170,64,0.25);padding:2.5rem 0;">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2rem;text-align:center;">
        {impactStats.map((st) => (
          <div class="reveal">
            <div style="font-family:var(--font-outfit);font-size:2.4rem;font-weight:900;color:var(--color-naa-gold);line-height:1;margin-bottom:0.35rem;">
              {st.value}
            </div>
            <div style="font-family:var(--font-outfit);font-weight:700;color:white;font-size:0.95rem;margin-bottom:0.25rem;">
              {st.label}
            </div>
            <div style="color:rgba(255,255,255,0.65);font-size:0.8rem;line-height:1.4;">
              {st.sub}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Sponsor NAA Section -->
  <section class="section-padding" style="background:white;" aria-labelledby="why-sponsor-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;max-width:720px;margin:0 auto 4rem;">
        <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">
          Purpose-Driven Impact
        </span>
        <h2 id="why-sponsor-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.75rem);margin-bottom:1rem;">
          Why Sponsor National Athletics Academy?
        </h2>
        <p style="color:#4b5563;font-size:1.05rem;line-height:1.75;">
          We are a Saskatchewan registered non-profit corporation (ISC Entity #: 102242108). Unlike for-profit enterprises, 100% of corporate sponsorship funds go directly toward reducing costs for families and elevating youth athletic development.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:2rem;">
        <div class="card reveal" style="padding:2.25rem;background:#f8fafc;border-radius:20px;border-top:4px solid var(--color-naa-navy);">
          <div style="width:44px;height:44px;border-radius:10px;background:rgba(11,25,44,0.08);display:flex;align-items:center;justify-content:center;color:var(--color-naa-navy);margin-bottom:1rem;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
          </div>
          <h3 style="font-family:var(--font-outfit);font-weight:800;color:var(--color-naa-navy);font-size:1.2rem;margin-bottom:0.75rem;">
            Direct Bursaries &amp; Equity
          </h3>
          <p style="color:#4b5563;font-size:0.92rem;line-height:1.65;">
            Inflation and facility rental costs shouldn't keep kids on the sidelines. Your sponsorship enables subsidized spots, payment installment relief, and multi-child sibling discounts for Regina households.
          </p>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:#f8fafc;border-radius:20px;border-top:4px solid var(--color-naa-maroon);">
          <div style="width:44px;height:44px;border-radius:10px;background:rgba(131,22,27,0.08);display:flex;align-items:center;justify-content:center;color:var(--color-naa-maroon);margin-bottom:1rem;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m4.93 4.93 4.24 4.24"></path><path d="m14.83 9.17 4.24-4.24"></path><path d="m14.83 14.83 4.24 4.24"></path><path d="m9.17 14.83-4.24 4.24"></path></svg>
          </div>
          <h3 style="font-family:var(--font-outfit);font-weight:800;color:var(--color-naa-maroon);font-size:1.2rem;margin-bottom:0.75rem;">
            Multi-Sport Community Footprint
          </h3>
          <p style="color:#4b5563;font-size:0.92rem;line-height:1.65;">
            We operate across school gyms, fieldhouses, and community facilities throughout Regina across Basketball, Volleyball, National Shield - Martial Arts, Athletics, and Tournaments — reaching active, engaged families.
          </p>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:#f8fafc;border-radius:20px;border-top:4px solid var(--color-naa-gold);">
          <div style="width:44px;height:44px;border-radius:10px;background:rgba(221,170,64,0.15);display:flex;align-items:center;justify-content:center;color:var(--color-naa-gold);margin-bottom:1rem;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h3 style="font-family:var(--font-outfit);font-weight:800;color:var(--color-naa-navy);font-size:1.2rem;margin-bottom:0.75rem;">
            Saskatchewan Safe Sport Leadership
          </h3>
          <p style="color:#4b5563;font-size:0.92rem;line-height:1.65;">
            Align your brand with integrity. All NAA coaching staff undergo police background screening (CRC-VSS), Respect in Sport, First Aid/CPR, and strict enforcement of the Coaching Association of Canada Rule of Two.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Packages Section -->
  <section id="packages" class="section-padding" style="background:var(--color-naa-grey);scroll-margin-top:70px;" aria-labelledby="packages-heading">
    <div class="container-naa">
      <div class="reveal" style="text-align:center;max-width:700px;margin:0 auto 4rem;">
        <span class="badge" style="background:rgba(2,31,71,0.08);color:var(--color-naa-navy);margin-bottom:1rem;">
          Partnership Levels
        </span>
        <h2 id="packages-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.75rem);margin-bottom:1rem;">
          Sponsorship Packages
        </h2>
        <p style="color:#4b5563;font-size:1.05rem;line-height:1.75;">
          Select a tier that aligns with your community goals, or speak with us to design a custom tailored partnership package.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:2rem;align-items:stretch;">
        {sponsorTiers.map((tier) => (
          <div
            class="card reveal"
            style={`padding:2.25rem 1.75rem;border-radius:22px;display:flex;flex-direction:column;position:relative;background:${tier.highlight ? '#021F47' : 'white'};color:${tier.highlight ? 'white' : '#1e293b'};border:${tier.highlight ? '2px solid var(--color-naa-gold)' : '1px solid rgba(0,0,0,0.08)'};box-shadow:${tier.highlight ? '0 12px 36px rgba(2,31,71,0.22)' : '0 4px 16px rgba(0,0,0,0.04)'};`}
          >
            {tier.badge && (
              <div style={`align-self:flex-start;background:${tier.highlight ? 'var(--color-naa-gold)' : 'rgba(131,22,27,0.1)'};color:${tier.highlight ? 'var(--color-naa-navy)' : 'var(--color-naa-maroon)'};font-size:0.72rem;font-weight:800;letter-spacing:0.06em;text-transform:uppercase;padding:0.25rem 0.75rem;border-radius:9999px;margin-bottom:1rem;font-family:var(--font-outfit);`}>
                {tier.badge}
              </div>
            )}

            <h3 style={`font-size:1.35rem;font-family:var(--font-outfit);font-weight:800;color:${tier.highlight ? 'white' : 'var(--color-naa-navy)'};margin-bottom:0.5rem;`}>
              {tier.name}
            </h3>
            
            <div style="display:flex;align-items:baseline;gap:0.35rem;margin-bottom:0.75rem;">
              <span style={`font-size:2.2rem;font-weight:900;font-family:var(--font-outfit);color:${tier.highlight ? 'var(--color-naa-gold)' : 'var(--color-naa-navy)'};`}>
                {tier.price}
              </span>
              <span style={`font-size:0.82rem;color:${tier.highlight ? 'rgba(255,255,255,0.7)' : '#6b7280'};`}>
                {tier.cadence}
              </span>
            </div>

            <p style={`font-size:0.88rem;line-height:1.6;margin-bottom:1.75rem;color:${tier.highlight ? 'rgba(255,255,255,0.85)' : '#4b5563'};`}>
              {tier.tagline}
            </p>

            <div style={`border-top:1px solid ${tier.highlight ? 'rgba(255,255,255,0.15)' : 'rgba(0,0,0,0.08)'};padding-top:1.25rem;margin-bottom:2rem;flex:1;`}>
              <ul style="list-style:none;display:flex;flex-direction:column;gap:0.75rem;">
                {tier.features.map((feat) => (
                  <li style="display:flex;align-items:flex-start;gap:0.6rem;font-size:0.85rem;line-height:1.5;">
                    <span style={`color:${tier.highlight ? 'var(--color-naa-gold)' : 'var(--color-naa-maroon)'};font-weight:900;flex-shrink:0;`}>
                      ✓
                    </span>
                    <span style={`color:${tier.highlight ? 'rgba(255,255,255,0.88)' : '#374151'};`}>
                      {feat}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href="#sponsor-form"
              class={`btn ${tier.highlight ? 'btn-gold' : 'btn-navy'} btn-sm`}
              style="width:100%;justify-content:center;text-align:center;"
              onclick={`document.getElementById('sponsor-tier').value = '${tier.name}';`}
            >
              {tier.cta} &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- In-Kind & Custom Partnerships -->
  <section style="background:white;padding:4rem 0;border-bottom:1px solid rgba(0,0,0,0.06);">
    <div class="container-naa">
      <div class="card reveal" style="padding:2.5rem;background:linear-gradient(135deg,rgba(221,170,64,0.1) 0%,rgba(131,22,27,0.06) 100%);border:2px solid rgba(221,170,64,0.3);border-radius:22px;">
        <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap;">
          <div style="width:64px;height:64px;border-radius:16px;background:rgba(221,170,64,0.2);display:flex;align-items:center;justify-content:center;color:var(--color-naa-gold);flex-shrink:0;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          </div>
          <div style="flex:1;">
            <h3 style="font-family:var(--font-outfit);font-weight:800;color:var(--color-naa-navy);font-size:1.35rem;margin-bottom:0.5rem;">
              In-Kind Donations &amp; Custom Partnerships
            </h3>
            <p style="color:#374151;font-size:0.95rem;line-height:1.65;margin-bottom:1rem;max-width:700px;">
              Not all support is financial! We warmly welcome in-kind partnerships including sports equipment (basketballs, volleyballs, cones, agility ladders), tournament hydration &amp; healthy athlete snacks, apparel printing, and gymnasium facility access.
            </p>
            <div style="display:flex;gap:1.5rem;flex-wrap:wrap;font-size:0.88rem;color:#1e293b;font-weight:600;">
              <div>Equipment &amp; Gear Grants</div>
              <div>Healthy Athlete Nutrition</div>
              <div>Printing &amp; Apparel Partners</div>
              <div>Venue &amp; Facility Access</div>
            </div>
          </div>
          <div>
            <a href="#sponsor-form" class="btn btn-navy">Propose an In-Kind Partnership &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsorship Inquiry Form -->
  <section id="sponsor-form" class="section-padding" style="background:#f8fafc;scroll-margin-top:70px;" aria-labelledby="form-heading">
    <div class="container-naa" style="max-width:860px;">
      <div class="reveal" style="text-align:center;margin-bottom:3rem;">
        <span class="badge" style="background:rgba(131,22,27,0.1);color:var(--color-naa-maroon);margin-bottom:1rem;">
          Get in Touch
        </span>
        <h2 id="form-heading" class="gold-accent-center" style="font-size:clamp(1.8rem,3.5vw,2.5rem);margin-bottom:0.75rem;">
          Sponsorship &amp; Partnership Inquiry
        </h2>
        <p style="color:#6b7280;font-size:0.98rem;max-width:620px;margin:0 auto;line-height:1.7;">
          Let us know how your organization would like to get involved. A member of the NAA executive team will connect with you within 1 business day.
        </p>
      </div>

      <div class="card reveal" style="padding:2.75rem;background:white;border-radius:24px;box-shadow:0 8px 30px rgba(2,31,71,0.06);">
        
        <div id="sponsor-success" class="form-success" role="alert" style="display:none;padding:1.5rem;background:#f0fdf4;border:1px solid #86efac;border-radius:14px;color:#166534;margin-bottom:2rem;line-height:1.6;">
          <h3 style="font-family:var(--font-outfit);font-weight:800;margin-bottom:0.25rem;">Thank you for your support!</h3>
          Your sponsorship inquiry has been received. Our executive team will review your details and reach out within 1 business day to discuss next steps.
        </div>

        <form id="sponsor-enquiry-form" method="POST" action="/sponsor-enquiry.php" novalidate style="display:flex;flex-direction:column;gap:1.5rem;">
          <input type="hidden" name="g-recaptcha-response" class="g-recaptcha-token" value="" />
          
          <div class="form-grid-2">
            <div class="form-group">
              <label for="sponsor-company" class="form-label">Company / Organization Name <span style="color:var(--color-naa-maroon);">*</span></label>
              <input type="text" id="sponsor-company" name="company_name" class="form-input" required placeholder="e.g. Prairie Ridge Dental" />
              <span class="form-error" id="err-company" aria-live="polite"></span>
            </div>
            <div class="form-group">
              <label for="sponsor-contact" class="form-label">Contact Person Name <span style="color:var(--color-naa-maroon);">*</span></label>
              <input type="text" id="sponsor-contact" name="contact_name" class="form-input" required placeholder="First and last name" />
              <span class="form-error" id="err-contact" aria-live="polite"></span>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="sponsor-email" class="form-label">Business Email Address <span style="color:var(--color-naa-maroon);">*</span></label>
              <input type="email" id="sponsor-email" name="email" class="form-input" required placeholder="name@company.com" />
              <span class="form-error" id="err-email" aria-live="polite"></span>
            </div>
            <div class="form-group">
              <label for="sponsor-phone" class="form-label">Phone Number</label>
              <input type="tel" id="sponsor-phone" name="phone" class="form-input" placeholder="(306) 555-0199" />
            </div>
          </div>

          <div class="form-group">
            <label for="sponsor-tier" class="form-label">Interested Sponsorship Tier</label>
            <select id="sponsor-tier" name="tier" class="form-input form-select">
              <option value="General Sponsorship Inquiry">Select an option or general inquiry…</option>
              <option value="Community Champion ($500)">Community Champion ($500 / seasonal block)</option>
              <option value="Team & Program Sponsor ($1,500)">Team &amp; Program Sponsor ($1,500 / season)</option>
              <option value="Tournament & Showcase Title ($5,000)">Tournament &amp; Showcase Title ($5,000 / event)</option>
              <option value="In-Kind Goods or Facility Services">In-Kind Goods or Facility Services</option>
              <option value="Custom Partnership Proposal">Custom Partnership Proposal</option>
            </select>
          </div>

          <div class="form-group">
            <label for="sponsor-message" class="form-label">Community Goals &amp; Comments</label>
            <textarea id="sponsor-message" name="message" class="form-input form-textarea" rows="4" placeholder="Tell us about your business, specific sports you'd love to support, or questions for our team…"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg" id="sponsor-submit-btn" style="width:100%;justify-content:center;">
            Submit Sponsorship Inquiry
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>

          <RecaptchaNotice action="sponsor_enquiry" />

          <p style="font-size:0.8rem;color:#9ca3af;text-align:center;margin-top:0.25rem;">
            National Athletics Academy Inc. is a registered non-profit corporation in Saskatchewan (ISC Entity #: 102242108).
          </p>
        </form>

      </div>

      <!-- Direct Contact info -->
      <div style="margin-top:3rem;text-align:center;color:#6b7280;font-size:0.9rem;">
        Prefer to speak directly with our team? Call <a href="tel:3063309559" style="color:var(--color-naa-navy);font-weight:700;">(306) 330-9559</a> or email <!--email_off--><a href="mailto:info@naacanada.org" style="color:var(--color-naa-navy);font-weight:700;">info@naacanada.org</a><!--/email_off-->.
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { executeRecaptcha } from '../../utils/recaptcha';

  const form = document.getElementById('sponsor-enquiry-form') as HTMLFormElement;
  const success = document.getElementById('sponsor-success') as HTMLElement;
  const btn = document.getElementById('sponsor-submit-btn') as HTMLButtonElement;

  function setErr(id: string, msg: string) {
    const el = document.getElementById(id) as HTMLElement;
    if (el) el.textContent = msg;
  }
  function clearErrs() {
    document.querySelectorAll('.form-error').forEach((el) => (el.textContent = ''));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrs();

    const company = (document.getElementById('sponsor-company') as HTMLInputElement).value.trim();
    const contact = (document.getElementById('sponsor-contact') as HTMLInputElement).value.trim();
    const email   = (document.getElementById('sponsor-email') as HTMLInputElement).value.trim();

    let valid = true;
    if (!company) { setErr('err-company', 'Company name is required.'); valid = false; }
    if (!contact) { setErr('err-contact', 'Contact person name is required.'); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setErr('err-email', 'A valid email is required.'); valid = false; }
    if (!valid) return;

    btn.textContent = 'Submitting inquiry…';
    btn.disabled = true;

    try {
      const recaptchaToken = await executeRecaptcha('sponsor_enquiry');
      const tokenInput = form.querySelector<HTMLInputElement>('.g-recaptcha-token, input[name="g-recaptcha-response"]');
      if (tokenInput && recaptchaToken) {
        tokenInput.value = recaptchaToken;
      }
      const data = new FormData(form);
      if (recaptchaToken) {
        data.set('g-recaptcha-response', recaptchaToken);
      }

      const resp = await fetch('/sponsor-enquiry.php', { method: 'POST', body: data });
      const result = await resp.json().catch(() => ({}));
      if (resp.ok && result.success !== false) {
        form.style.display = 'none';
        success.style.display = 'block';
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        btn.textContent = 'Submit Sponsorship Inquiry';
        btn.disabled = false;
        alert(result.error || result.message || 'Something went wrong. Please email info@naacanada.org directly.');
      }
    } catch {
      form.submit();
    }
  });
</script>

