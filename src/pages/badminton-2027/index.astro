---
import SeasonLandingPage from '../../components/SeasonLandingPage.astro';

const registerUrl = 'https://app.teamlinkt.com/register/find/nationalathleticsacademy?cid=81569';

const tiers = [
  {
    name: 'Smash Juniors',
    ages: 'Ages 6–10',
    price: 150,
    times: ['Batch 1 · 6:00–6:45 PM', 'Batch 2 · 6:45–7:30 PM'],
    blurb: 'Open, mixed-level class. Games-based skills: grip, serving, court movement and net play.',
  },
  {
    name: 'Smash Elite',
    ages: 'Ages 11–16',
    price: 175,
    times: ['Batch 1 · 6:00–6:45 PM', 'Batch 2 · 6:45–7:30 PM'],
    blurb: 'Open, mixed-level class. Footwork, clears, drops, smashes and doubles rotation.',
  },
  {
    name: 'Smash Pro',
    ages: 'Ages 10–16',
    price: 295,
    times: ['6:00–7:30 PM · 90-minute sessions'],
    blurb: 'Intensive tactical training and matchplay for players who want to compete.',
    featured: true,
  },
];

const faqs = [
  {
    q: 'Is my child ready if they have never played?',
    a: 'Yes. Smash Juniors and Smash Elite are open, mixed-level classes where beginners and more experienced players train together, and coaches adjust the drills for each athlete.',
  },
  {
    q: 'Do we need our own racket?',
    a: 'Yes, athletes bring their own racket. NAA does not provide rackets. Yonex practice shuttles are provided for all drills. Clean, non-marking indoor court shoes are required.',
  },
  {
    q: 'How much does it cost, and can I pay in installments?',
    a: 'Tuition is $150 (Juniors), $175 (Elite) or $295 (Pro). Every athlete also pays a mandatory $30 Training Kit fee, paid in full. Tuition can be split into three installments. Eligible sibling discounts are applied automatically through the TeamLinkt system at checkout.',
  },
  {
    q: 'Which batch will my child be in?',
    a: 'Choose Batch 1 (6:00–6:45 PM) or Batch 2 (6:45–7:30 PM) for Juniors and Elite. Final schedules and group assignments are confirmed in the TeamLinkt app.',
  },
];
---

<SeasonLandingPage
  seoTitle="Badminton 2027 in Regina | National Smash Winter Registration"
  seoDescription="National Smash Winter 2027 badminton for ages 6–16 at the University of Regina Green Gym. Tuesdays and Thursdays, Jan 26 – Mar 11. From $150. Registration is open."
  heroImage="/images/programs/badminton-action-1.webp"
  pill="Winter 2027 • Registration Open"
  titleTop="National Smash"
  titleAccent="Badminton 2027"
  lead="Coached badminton for ages 6–16, twice a week at the University of Regina Green Gym."
  facts={[
    { strong: 'Jan 26 – Mar 11', span: '10 sessions' },
    { strong: 'Tue & Thu', span: 'Evenings' },
    { strong: 'From $150', span: 'Split in 3 installments', highlight: true },
  ]}
  registerUrl={registerUrl}
  tiersSub="Three levels, all Tuesdays & Thursdays."
  tiers={tiers}
  steps={[
    { title: 'Choose a tier and batch', text: 'Juniors and Elite pick Batch 1 or Batch 2. Pro runs 6:00–7:30 PM.' },
    { title: 'Register on TeamLinkt', text: 'Tap the button, add your athlete, and pay in full or in three installments.' },
    { title: 'Get the TeamLinkt app', text: 'Final schedules, group assignments and any cancellations are posted there.' },
  ]}
  dates={[
    { month: 'January', days: '26, 28' },
    { month: 'February', days: '2, 4, 23, 25' },
    { month: 'March', days: '2, 4, 9, 11' },
  ]}
  datesSub="Ten sessions at the U of R Green Gym, 3737 Wascana Parkway."
  datesNote="No sessions February 9–18."
  photos={[
    { src: '/images/programs/badminton-coaching-1.webp', alt: 'NAA coach with young badminton players seated in a circle on the court' },
    { src: '/images/programs/badminton-warmup-1.webp', alt: 'Players and coaches raising rackets overhead during a badminton warm-up' },
  ]}
  bring={[
    { title: 'Your own racket', text: 'NAA does not provide rackets.' },
    { title: 'Court shoes', text: 'Clean, non-marking indoor shoes.' },
    { title: 'Water & athletic wear', text: 'Yonex shuttles are provided.' },
  ]}
  faqs={faqs}
  programUrl="/programs/badminton/"
  barTitle="Badminton 2027"
  barSub="From $150 · Tue & Thu"
  finalText="Winter 2027 registration is open on TeamLinkt."
/>
