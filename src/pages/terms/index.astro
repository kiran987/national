---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Terms of Use | National Athletics Academy Inc."
  description="Terms of Use for National Athletics Academy Inc., a registered non-profit sports organization in Saskatchewan (ISC Entity #: 102242108). Program registration, participation terms, and academy policies."
>
  <Header />

  <!-- Hero -->
  <section class="page-hero" aria-labelledby="terms-heading" style="background:linear-gradient(160deg,#021F47 0%,#010f24 55%,#1a1a2e 100%);">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(221,170,64,0.18);color:var(--color-naa-gold);border:1px solid rgba(221,170,64,0.35);margin-bottom:1.25rem;">
          Legal &amp; Academy Governance
        </span>
        <h1 id="terms-heading" style="font-size:clamp(2.2rem,5vw,3.5rem);color:white;margin-bottom:1rem;font-weight:900;">
          Terms of Use &amp; Participation
        </h1>
        <p style="color:rgba(255,255,255,0.85);font-size:1.05rem;max-width:680px;margin:0 auto;line-height:1.75;">
          Official terms governing website access, program registration, athlete participation, and community standards for National Athletics Academy Inc.
        </p>
        <p style="color:var(--color-naa-gold);font-size:0.85rem;margin-top:1rem;font-family:var(--font-outfit);font-weight:600;">
          Last Updated: September 2026 &nbsp;&bull;&nbsp; Saskatchewan ISC Entity #: 102242108
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section-padding" style="background:#f8fafc;">
    <div class="container-naa" style="max-width:920px;">
      
      <!-- Organization Banner -->
      <div class="card reveal" style="padding:1.75rem 2rem;background:var(--color-naa-navy);color:white;border-radius:18px;margin-bottom:3rem;border:1px solid rgba(221,170,64,0.3);">
        <div style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(221,170,64,0.15);display:flex;align-items:center;justify-content:center;color:var(--color-naa-gold);flex-shrink:0;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <div style="flex:1;">
            <div style="font-family:var(--font-outfit);font-weight:800;font-size:1.15rem;color:var(--color-naa-gold);margin-bottom:0.25rem;">
              National Athletics Academy Inc.
            </div>
            <p style="font-size:0.88rem;color:rgba(255,255,255,0.82);line-height:1.6;margin:0;">
              A Registered Non-Profit Corporation in Saskatchewan &nbsp;&bull;&nbsp; ISC Entity #: <strong>102242108</strong><br/>
              Registered Address: <strong>217 Broad St N, Regina, Saskatchewan, Canada, S4R 2X7</strong>
            </p>
          </div>
        </div>
      </div>

      <!-- Legal Body Articles -->
      <div style="display:flex;flex-direction:column;gap:2rem;">

        <div class="card reveal" style="padding:2.25rem;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(2,31,71,0.05);">
          <h2 style="font-size:1.35rem;color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;margin-bottom:1rem;">
            1. Acceptance of Terms
          </h2>
          <p style="color:#374151;font-size:0.95rem;line-height:1.75;margin-bottom:1rem;">
            By accessing or using the National Athletics Academy Inc. ("NAA", "we", "us", or "our") website located at <strong>naacanada.org</strong>, or by registering a participant in any NAA athletic program, camp, clinic, or tournament, you ("User", "Parent", "Guardian", or "Participant") agree to be bound by these Terms of Use and all associated policies incorporated by reference.
          </p>
          <p style="color:#374151;font-size:0.95rem;line-height:1.75;margin:0;">
            If you do not agree to these Terms, please do not use our website or register for our programs. For participants under 18 years of age, a parent or legal guardian must agree to these Terms on behalf of the minor athlete.
          </p>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(2,31,71,0.05);">
          <h2 style="font-size:1.35rem;color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;margin-bottom:1rem;">
            2. Program Registration &amp; Participant Eligibility
          </h2>
          <ul style="color:#374151;font-size:0.95rem;line-height:1.75;padding-left:1.5rem;display:flex;flex-direction:column;gap:0.75rem;">
            <li><strong>Accuracy of Information:</strong> Parents and guardians agree to provide complete, accurate, and up-to-date information during registration, including athlete birth date, emergency contact details, and any pertinent medical conditions or allergies.</li>
            <li><strong>Sports Management &amp; TeamLinkt:</strong> NAA utilizes the <strong>TeamLinkt</strong> platform (based in Saskatoon, SK) for digital team rosters, schedule broadcasting, game check-ins, and guardian communication. By enrolling, families agree to maintain active contact information via TeamLinkt for team updates and schedule notices.</li>
            <li><strong>Age Categories &amp; Placement:</strong> Athletes are placed in programs according to designated birth-year cohorts and skill tiers. NAA technical directors reserve the right to recommend tier adjustments in the best interest of athlete safety and development.</li>
            <li><strong>Capacity Limits:</strong> To maintain strict coach-to-athlete ratios (typically 1:8 to 1:12), registrations are accepted on a first-confirmed basis. Submission of an interest form does not guarantee placement until confirmation and fee arrangements are finalized.</li>
          </ul>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(2,31,71,0.05);">
          <h2 style="font-size:1.35rem;color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;margin-bottom:1rem;">
            3. Fees, Installment Plans &amp; Refund Policy
          </h2>
          <ul style="color:#374151;font-size:0.95rem;line-height:1.75;padding-left:1.5rem;display:flex;flex-direction:column;gap:0.75rem;">
            <li><strong>Non-Profit Community Commitment:</strong> As a Saskatchewan non-profit corporation, NAA operates on a cost-recovery basis to ensure youth sport remains affordable for Regina families.</li>
            <li><strong>Flexible Payment Installments:</strong> NAA offers 2 to 3 installment payment arrangements and a 10% multi-child sibling discount, applied through the TeamLinkt registration system at checkout. If cost presents a barrier, families may request financial accessibility support.</li>
            <li><strong>Withdrawals &amp; Refunds:</strong> Full refunds (less a $25 administrative fee) are granted for withdrawal requests submitted in writing at least 14 days prior to the first session of a program block. Withdrawals requested within 14 days of program start are eligible for credit toward future NAA programs. Once a program block has commenced, refunds are only considered for documented medical reasons with a physician note.</li>
            <li><strong>Facility Cancellations &amp; Inclement Weather:</strong> If school facilities or city gymnasiums close due to extreme weather or school district directives, NAA will make every reasonable effort to schedule make-up sessions or provide credit.</li>
          </ul>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(2,31,71,0.05);">
          <h2 style="font-size:1.35rem;color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;margin-bottom:1rem;">
            4. Athletic Risk Assumption &amp; Medical Clearance
          </h2>
          <p style="color:#374151;font-size:0.95rem;line-height:1.75;margin-bottom:1rem;">
            Athletic training, drills, scrimmages, and tournament competition involve inherent physical exertion and risk of accidental injury. By enrolling a participant, parents/guardians acknowledge:
          </p>
          <ul style="color:#374151;font-size:0.95rem;line-height:1.75;padding-left:1.5rem;display:flex;flex-direction:column;gap:0.75rem;">
            <li>The participant is physically fit to participate in athletic activities and has had any medical restrictions disclosed to NAA coaches in writing.</li>
            <li>In the event of an urgent medical situation when emergency contacts cannot be reached, NAA certified coaches and first-aid providers are authorized to secure emergency medical treatment from licensed healthcare professionals.</li>
            <li>NAA enforces strict concussion management protocols aligned with Parachute Canada. Any athlete showing signs of concussion will be removed from play immediately and will require medical clearance before returning.</li>
          </ul>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(2,31,71,0.05);">
          <h2 style="font-size:1.35rem;color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;margin-bottom:1rem;">
            5. Safe Sport, Code of Conduct &amp; Rule of Two
          </h2>
          <p style="color:#374151;font-size:0.95rem;line-height:1.75;margin-bottom:1rem;">
            NAA is firmly committed to fostering a safe, respectful, and inclusive environment. All coaches, staff, volunteers, parents, and athletes must adhere to our Code of Conduct:
          </p>
          <ul style="color:#374151;font-size:0.95rem;line-height:1.75;padding-left:1.5rem;display:flex;flex-direction:column;gap:0.75rem;">
            <li><strong>Coaching Safeguards:</strong> All NAA coaches undergo Criminal Record Checks with Vulnerable Sector Screening (CRC-VSS), Respect in Sport (Activity Leader) certification, and adhere strictly to the Coaching Association of Canada (CAC) <em>Rule of Two</em>.</li>
            <li><strong>Respectful Conduct:</strong> Verbal abuse, physical aggression, discrimination, bullying, or unsportsmanlike behavior toward athletes, coaches, referees, or facility staff will not be tolerated and may result in immediate dismissal without refund.</li>
            <li><strong>Spectator &amp; Parent Etiquette:</strong> Parents and spectators are expected to cheer constructively, respect match officials, and uphold positive community standards.</li>
          </ul>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(2,31,71,0.05);">
          <h2 style="font-size:1.35rem;color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;margin-bottom:1rem;">
            6. Media, Photography &amp; Promotional Notice
          </h2>
          <p style="color:#374151;font-size:0.95rem;line-height:1.75;margin:0;">
            NAA may capture photographs or short video clips during training sessions, camps, or tournaments for promotional, social media, and archival use. Parents and guardians may opt out of promotional photography at any time by notifying NAA administration in writing at <!--email_off--><a href="mailto:info@naacanada.org" style="color:var(--color-naa-maroon);font-weight:700;">info@naacanada.org</a><!--/email_off-->.
          </p>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(2,31,71,0.05);">
          <h2 style="font-size:1.35rem;color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;margin-bottom:1rem;">
            7. Intellectual Property &amp; Website Use
          </h2>
          <p style="color:#374151;font-size:0.95rem;line-height:1.75;margin:0;">
            All content, graphics, crest logos, curriculum outlines, and materials published on this website are the property of National Athletics Academy Inc. or used with permission. You may not reproduce, redistribute, or use our branding or curricula for commercial purposes without prior written authorization.
          </p>
        </div>

        <div class="card reveal" style="padding:2.25rem;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(2,31,71,0.05);">
          <h2 style="font-size:1.35rem;color:var(--color-naa-navy);font-family:var(--font-outfit);font-weight:800;margin-bottom:1rem;">
            8. Governing Law &amp; Jurisdiction
          </h2>
          <p style="color:#374151;font-size:0.95rem;line-height:1.75;margin:0;">
            These Terms of Use and any disputes arising from program participation or website use shall be governed by and construed in accordance with the laws of the <strong>Province of Saskatchewan</strong> and the federal laws of <strong>Canada</strong> applicable therein, without regard to conflicts of law principles.
          </p>
        </div>

        <!-- Contact Box -->
        <div class="card reveal" style="padding:2rem;background:rgba(221,170,64,0.08);border:2px solid rgba(221,170,64,0.3);border-radius:18px;">
          <h3 style="font-family:var(--font-outfit);font-weight:800;color:var(--color-naa-navy);font-size:1.1rem;margin-bottom:0.75rem;">
            Questions Regarding Our Terms?
          </h3>
          <p style="color:#374151;font-size:0.9rem;line-height:1.65;margin-bottom:1rem;">
            For legal inquiries, policy clarifications, or governance questions, please contact our administrative team:
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:1.5rem;font-size:0.88rem;color:#1e293b;">
            <div><strong>Email:</strong> <!--email_off--><a href="mailto:info@naacanada.org" style="color:var(--color-naa-navy);font-weight:600;">info@naacanada.org</a><!--/email_off--></div>
            <div><strong>Phone:</strong> <a href="tel:3063309559" style="color:var(--color-naa-navy);font-weight:600;">(306) 330-9559</a></div>
            <div><strong>Address:</strong> 217 Broad St N, Regina, SK, S4R 2X7</div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <Footer />
</Layout>
