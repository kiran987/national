---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RecaptchaNotice from '../../components/RecaptchaNotice.astro';
import { activePrograms } from '../../data/programs';

const programOptions = [
  { label: 'Badminton Academy', value: 'Badminton Academy', active: true },
  { label: 'Volleyball Academy', value: 'Volleyball Academy', active: true },
  { label: 'National Strike Chess (Coming Soon)', value: 'National Strike Chess', active: true },
  { label: 'National Spin Table Tennis (Coming Soon)', value: 'National Spin Table Tennis', active: true },
  { label: 'National Shred Snowboarding (Coming Soon)', value: 'National Shred Snowboarding', active: true },
  { label: 'National Shield - Martial Arts', value: 'National Shield - Martial Arts', active: true },
  { label: 'Basketball Academy', value: 'Basketball Academy', active: true },
];
---

<Layout
  title="Register for Youth Sports Programs in Regina, SK | NAA"
  description="Register your athlete for National Athletics Academy youth sports programs in Regina, SK: Basketball Academy, Volleyball Academy, Badminton Academy, and National Shield - Martial Arts."
>
  <Header />

  <!-- Page Hero -->
  <section class="page-hero" aria-labelledby="registration-heading" style="background:linear-gradient(160deg,var(--color-naa-navy) 0%,#010f24 50%,#83161B 100%);">
    <div class="container-naa" style="position:relative;z-index:1;text-align:center;">
      <div class="animate-fade-up">
        <span class="badge" style="background:rgba(221,170,64,0.2);color:var(--color-naa-gold);margin-bottom:1.25rem;">Get Started</span>
        <h1 id="registration-heading" style="font-size:clamp(2rem,5vw,3.5rem);color:white;margin-bottom:1rem;font-weight:900;">
          Program Registration
        </h1>
        <p style="color:rgba(255,255,255,0.85);font-size:1.1rem;max-width:620px;margin:0 auto;line-height:1.75;">
          Tell us about your athlete and select the sport(s) of interest. Our team will contact you with specific cohort times, gym assignments, and payment links.
        </p>
      </div>
    </div>
  </section>

  <!-- TeamLinkt Registration Banner -->
  <section style="background:#021F47;padding:2rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
    <div class="container-naa">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.25rem;">
        {[
          { id: 'badminton', name: 'Badminton Academy', shortName: 'Badminton', active: true, tag: 'Oct–Dec Block Open', url: '/programs/badminton/', label: 'View Program & Register →' },
          { id: 'volleyball', name: 'Volleyball Academy', shortName: 'Volleyball', active: true, tag: 'Oct–Dec Block Open', url: 'https://app.teamlinkt.com/register/find/nationalathleticsacademy?cid=79253', label: 'Register on TeamLinkt →' },
          { id: 'basketball', name: 'Basketball Academy', shortName: 'Basketball', active: true, tag: 'Registration Starts Soon', url: '/notify/', label: 'Notify Me →' },
          { id: 'shield', name: 'National Shield - Martial Arts', shortName: 'National Shield', active: true, tag: 'Registration Starts Soon', url: '/notify/', label: 'Notify Me →' },
        ].map(prog => (
          <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:1.35rem 1.25rem;display:flex;flex-direction:column;justify-content:space-between;gap:1.1rem;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:transform 0.2s ease, border-color 0.2s ease;">
            <div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.85rem;">
                <span style="font-family:var(--font-outfit);font-weight:700;font-size:0.85rem;color:var(--color-naa-gold);">{prog.shortName}</span>
                <span style={`font-size:0.7rem;font-family:var(--font-outfit);font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:0.25rem 0.65rem;border-radius:20px;${prog.active ? 'background:rgba(221,170,64,0.18);color:var(--color-naa-gold);border:1px solid rgba(221,170,64,0.4);' : 'background:rgba(74,222,128,0.15);color:#4ade80;border:1px solid rgba(74,222,128,0.3);'}`}>
                  {prog.tag}
                </span>
              </div>
              <div style="font-family:var(--font-outfit);font-weight:800;color:white;font-size:1.05rem;line-height:1.35;margin-bottom:0.3rem;">
                {prog.name}
              </div>
            </div>
            <div>
              <a
                href={prog.url}
                target={prog.url.startsWith('http') ? '_blank' : '_self'}
                rel="noopener noreferrer"
                style={`display:flex;align-items:center;justify-content:center;width:100%;text-align:center;border-radius:10px;padding:0.6rem 0.85rem;font-size:0.82rem;font-family:var(--font-outfit);font-weight:800;text-decoration:none;transition:all 0.2s ease;${
                  prog.active
                    ? 'background:var(--color-naa-gold);color:var(--color-naa-navy);box-shadow:0 2px 10px rgba(221,170,64,0.3);'
                    : 'background:rgba(255,255,255,0.08);color:var(--color-naa-gold);border:1px solid rgba(221,170,64,0.5);'
                }`}
              >
                {prog.label}
              </a>
            </div>
          </div>
        ))}
      </div>
      <p style="text-align:center;color:rgba(255,255,255,0.75);font-size:0.85rem;margin-top:1.25rem;line-height:1.6;">
        Direct online registration on TeamLinkt is now open for Volleyball and Badminton. Basketball and National Shield - Martial Arts registrations start soon.
      </p>
    </div>
  </section>

  <!-- Registration section -->
  <section class="section-padding" aria-labelledby="reg-form-heading" style="background:#ffffff;">
    <div class="container-naa">
      <div class="reg-layout-grid" style="display:grid;grid-template-columns:5fr 4fr;gap:5rem;align-items:start;">

        <!-- Form -->
        <div class="reveal">
          <h2 id="reg-form-heading" class="gold-accent" style="font-size:1.75rem;margin-bottom:2rem;">
            Registration Interest Form
          </h2>

          <div id="registration-success" class="form-success" role="alert">
            Thank you! We've received your registration interest and will be in touch within 2 business days.
          </div>

          <form id="registration-form" method="POST" action="/registration.php" novalidate>
            <input type="hidden" name="g-recaptcha-response" class="g-recaptcha-token" value="" />
            <div class="form-grid-2">
              <div class="form-group">
                <label for="reg-parent-first" class="form-label">Parent / Guardian First Name <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="text" id="reg-parent-first" name="parent_first" class="form-input" required autocomplete="given-name" placeholder="First name" />
                <span class="form-error" id="err-parent-first" aria-live="polite"></span>
              </div>
              <div class="form-group">
                <label for="reg-parent-last" class="form-label">Last Name <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="text" id="reg-parent-last" name="parent_last" class="form-input" required autocomplete="family-name" placeholder="Last name" />
                <span class="form-error" id="err-parent-last" aria-live="polite"></span>
              </div>
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label for="reg-email" class="form-label">Email Address <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="email" id="reg-email" name="email" class="form-input" required autocomplete="email" placeholder="you@example.com" />
                <span class="form-error" id="err-email" aria-live="polite"></span>
              </div>
              <div class="form-group">
                <label for="reg-phone" class="form-label">Phone Number</label>
                <input type="tel" id="reg-phone" name="phone" class="form-input" autocomplete="tel" placeholder="(306) 555-0100" />
              </div>
            </div>

            <!-- Athlete info -->
            <hr style="border:none;border-top:2px solid var(--color-naa-grey);margin:1.5rem 0 2rem;" />
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);margin-bottom:1.5rem;font-size:1.1rem;">
              Athlete Information
            </h3>

            <div class="form-grid-2">
              <div class="form-group">
                <label for="reg-athlete-name" class="form-label">Athlete's Name <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="text" id="reg-athlete-name" name="athlete_name" class="form-input" required placeholder="Athlete's full name" />
                <span class="form-error" id="err-athlete-name" aria-live="polite"></span>
              </div>
              <div class="form-group">
                <label for="reg-athlete-age" class="form-label">Athlete's Age <span style="color:var(--color-naa-maroon);">*</span></label>
                <input type="number" id="reg-athlete-age" name="athlete_age" class="form-input" required min="2" max="80" placeholder="Age (e.g. 3, 9, 14)" />
                <span class="form-error" id="err-athlete-age" aria-live="polite"></span>
              </div>
            </div>

            <!-- Programs of interest -->
            <div class="form-group">
              <label class="form-label">Programs of Interest <span style="color:var(--color-naa-maroon);">*</span></label>
              <div style="display:flex;flex-direction:column;gap:0.6rem;margin-top:0.75rem;" id="programs-checkboxes">
                {programOptions.map((prog, i) => (
                  <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;font-size:0.92rem;color:#1e293b;padding:0.75rem 1rem;background:#f8fafc;border:2px solid #e2e8f0;border-radius:12px;transition:all 0.2s;"
                    onmouseover="this.style.borderColor='var(--color-naa-navy)';this.style.background='rgba(2,31,71,0.03)';"
                    onmouseout="this.style.borderColor='#e2e8f0';this.style.background='#f8fafc';">
                    <input
                      type="checkbox"
                      name="programs[]"
                      value={prog.value}
                      id={`prog-${i}`}
                      style="width:18px;height:18px;accent-color:var(--color-naa-maroon);cursor:pointer;flex-shrink:0;"
                    />
                    <span style="font-weight:600;">{prog.label}</span>
                  </label>
                ))}
              </div>
              <p style="font-size:0.78rem;color:#6b7280;margin-top:0.5rem;">Want to be notified about upcoming programs (First Kicks Soccer, Athletics)? <a href="/notify/" style="color:var(--color-naa-navy);font-weight:600;">Use the Notify Me form →</a></p>
              <span class="form-error" id="err-programs" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="reg-season" class="form-label">Preferred Seasonal Block</label>
              <select id="reg-season" name="season" class="form-input form-select">
                <option value="">Select a season...</option>
                <option>Fall 2026 (September – December)</option>
                <option>Winter 2027 (January – March)</option>
                <option>Spring 2027 (April – June)</option>
                <option>Summer 2027 (July – August)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="reg-notes" class="form-label">Additional Notes or Inquiries</label>
              <textarea id="reg-notes" name="notes" class="form-input form-textarea" placeholder="Any friend requests, medical considerations, schedule preferences, or questions..."></textarea>
            </div>

            <!-- Financial assistance -->
            <div class="form-group">
              <label style="display:flex;align-items:flex-start;gap:0.625rem;cursor:pointer;font-size:0.9rem;color:#374151;">
                <input type="checkbox" name="financial_assist" id="financial-assist" value="yes" style="width:18px;height:18px;accent-color:var(--color-naa-maroon);cursor:pointer;flex-shrink:0;margin-top:2px;" />
                <span>I am interested in learning about 2–3 payment installment options and multi-child sibling discounts</span>
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg" id="reg-submit-btn" style="width:100%;justify-content:center;" aria-describedby="submit-note">
              Submit Registration Interest
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            </button>
            <RecaptchaNotice action="registration" />
            <p id="submit-note" style="font-size:0.8rem;color:#9ca3af;text-align:center;margin-top:0.75rem;">We will reply to confirm placement within 2 business days.</p>
          </form>
        </div>

        <!-- Sidebar info -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <!-- What happens next -->
          <div class="reveal" style="background:var(--color-naa-navy);border-radius:20px;padding:2rem;color:white;">
            <h3 style="font-family:var(--font-outfit);font-size:1.1rem;font-weight:700;color:var(--color-naa-gold);margin-bottom:1.25rem;">
              What Happens Next
            </h3>
            {[
              { step: '1', text: 'We receive your registration form and review athlete age & sport choice' },
              { step: '2', text: 'Our team confirms gym facility permit, coach assignment, and time slot' },
              { step: '3', text: 'You receive email confirmation with schedule, waiver, and payment invoice' },
              { step: '4', text: 'Athlete receives welcome kit and team communication details' },
              { step: '5', text: 'Ready for season kickoff!' },
            ].map((s) => (
              <div style="display:flex;gap:1rem;align-items:flex-start;margin-bottom:1rem;">
                <div style="width:30px;height:30px;border-radius:50%;background:rgba(221,170,64,0.2);border:1px solid rgba(221,170,64,0.4);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem;color:var(--color-naa-gold);flex-shrink:0;">{s.step}</div>
                <p style="color:rgba(255,255,255,0.85);font-size:0.88rem;line-height:1.6;padding-top:4px;">{s.text}</p>
              </div>
            ))}
          </div>

          <!-- Multi-Child Family Discount & Accessibility -->
          <div class="reveal" style="background:rgba(221,170,64,0.08);border:2px solid rgba(221,170,64,0.3);border-radius:20px;padding:2rem;">
            <div style="width:40px;height:40px;border-radius:10px;background:rgba(221,170,64,0.2);display:flex;align-items:center;justify-content:center;color:var(--color-naa-navy);margin-bottom:0.875rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
            </div>
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);margin-bottom:0.5rem;font-size:1.15rem;">
              Family &amp; Multi-Child Discounts
            </h3>
            <p style="color:#374151;font-size:0.88rem;line-height:1.6;margin-bottom:1.25rem;">
              We are pleased to offer a <strong>10% discount</strong> starting on your second registered participant (and each additional child).
            </p>

            <!-- Case 1: Same Sport -->
            <div style="background:#ffffff;border:1px solid rgba(221,170,64,0.35);border-radius:12px;padding:1.1rem 1.25rem;margin-bottom:1rem;font-size:0.84rem;color:#1e293b;line-height:1.6;">
              <div style="font-family:var(--font-outfit);font-weight:800;color:var(--color-naa-navy);font-size:0.9rem;margin-bottom:0.4rem;">
                Registering Multiple Children (Automatic Discount)
              </div>
              <p style="margin:0 0 0.5rem;color:#4b5563;font-size:0.82rem;">
                If you are registering multiple children for the same sport (e.g., two children in Badminton):
              </p>
              <ul style="padding-left:1.2rem;margin:0;display:flex;flex-direction:column;gap:0.35rem;">
                <li>Complete the details for your first child, then click <strong>"+ Register Another Participant"</strong> before paying.</li>
                <li>Your 10% multi-child discount is applied <strong>automatically by the TeamLinkt registration system at checkout</strong> when eligible.</li>
              </ul>
            </div>

            <p style="color:#64748b;font-size:0.78rem;line-height:1.55;margin:0;">
              <em>Rule details:</em> Child 1 pays standard full tuition; Child 2 and each subsequent child receive the 10% discount, applied through the TeamLinkt system. Flexible 2–3 payment installment options are also available.
            </p>
          </div>

          <!-- Contact card -->
          <div class="reveal" style="background:var(--color-naa-grey);border-radius:20px;padding:2rem;">
            <h3 style="font-family:var(--font-outfit);font-weight:700;color:var(--color-naa-navy);margin-bottom:0.75rem;font-size:1.05rem;">
              Program Questions?
            </h3>
            <p style="color:#374151;font-size:0.88rem;line-height:1.65;margin-bottom:1.25rem;">
              Need advice on the right age tier, sport fit, or scheduling? Use our dedicated Program Enquiry form.
            </p>
            <a href="/programs/enquiry/" class="btn btn-navy btn-sm" id="reg-enquiry-btn">Program Enquiry &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { executeRecaptcha } from '../../utils/recaptcha';

  const form = document.getElementById('registration-form') as HTMLFormElement;
  const successMsg = document.getElementById('registration-success') as HTMLElement;

  function setError(id: string, msg: string) {
    const el = document.getElementById(id) as HTMLElement;
    if (el) el.textContent = msg;
  }
  function clearErrors() {
    document.querySelectorAll('.form-error').forEach((el) => (el.textContent = ''));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const parentFirst = (document.getElementById('reg-parent-first') as HTMLInputElement).value.trim();
    const parentLast = (document.getElementById('reg-parent-last') as HTMLInputElement).value.trim();
    const email = (document.getElementById('reg-email') as HTMLInputElement).value.trim();
    const athleteName = (document.getElementById('reg-athlete-name') as HTMLInputElement).value.trim();
    const athleteAge = (document.getElementById('reg-athlete-age') as HTMLInputElement).value.trim();
    const programs = Array.from(document.querySelectorAll('input[name="programs[]"]:checked')).map((el) => (el as HTMLInputElement).value);

    let valid = true;
    if (!parentFirst) { setError('err-parent-first', 'Please enter your first name.'); valid = false; }
    if (!parentLast) { setError('err-parent-last', 'Please enter your last name.'); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('err-email', 'Please enter a valid email address.'); valid = false; }
    if (!athleteName) { setError('err-athlete-name', 'Please enter the athlete\'s name.'); valid = false; }
    if (!athleteAge) { setError('err-athlete-age', 'Please enter the athlete\'s age.'); valid = false; }
    if (programs.length === 0) { setError('err-programs', 'Please select at least one program.'); valid = false; }

    if (!valid) return;

    const btn = document.getElementById('reg-submit-btn') as HTMLButtonElement;
    const btnOriginalHtml = btn.innerHTML;
    btn.textContent = 'Sending…';
    btn.disabled = true;

    try {
      const recaptchaToken = await executeRecaptcha('registration');
      const tokenInput = form.querySelector<HTMLInputElement>('.g-recaptcha-token, input[name="g-recaptcha-response"]');
      if (tokenInput && recaptchaToken) {
        tokenInput.value = recaptchaToken;
      }
      const data = new FormData(form);
      if (recaptchaToken) {
        data.set('g-recaptcha-response', recaptchaToken);
      }
      const resp = await fetch('/registration.php', { method: 'POST', body: data });
      const result = await resp.json().catch(() => ({}));
      if (resp.ok && result.success !== false) {
        form.style.display = 'none';
        successMsg.classList.add('show');
        window.scrollTo({ top: successMsg.offsetTop - 120, behavior: 'smooth' });
      } else {
        btn.innerHTML = btnOriginalHtml;
        btn.disabled = false;
        alert(result.error || result.message || 'Something went wrong. Please email info@naacanada.org directly.');
      }
    } catch {
      form.submit();
    }
  });
</script>

<style>
  @media (max-width: 860px) {
    .reg-layout-grid {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }
  }
</style>
